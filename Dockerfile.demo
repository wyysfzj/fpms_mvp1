# syntax=docker/dockerfile:1

FROM node:20-alpine AS frontend-build

WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build


FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FPMS_ENV=demo \
    DATABASE_URL=sqlite:////data/fpms_demo.db \
    STORAGE_DIR=/data/storage \
    CORS_ORIGINS='["http://localhost:8080","http://127.0.0.1:8080"]' \
    JWT_SECRET=demo-change-me \
    JWT_EXPIRE_MINUTES=480 \
    FPMS_RUN_SEED=1 \
    FPMS_API_PORT=8000

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash curl nginx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/app ./app
RUN pip install --no-cache-dir -U pip \
    && pip install --no-cache-dir -e .

COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY backend/scripts ./scripts

COPY --from=frontend-build /build/frontend/dist /usr/share/nginx/html
COPY deploy/docker/demo/nginx.conf /etc/nginx/nginx.conf
COPY deploy/docker/demo/entrypoint.sh /usr/local/bin/fpms-demo-entrypoint

RUN chmod +x /usr/local/bin/fpms-demo-entrypoint \
    && mkdir -p /data/storage /run/nginx /var/log/nginx \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://127.0.0.1/healthz >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/fpms-demo-entrypoint"]
