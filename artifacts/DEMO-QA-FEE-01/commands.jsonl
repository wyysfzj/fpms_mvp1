p.text\nitems = list_resp.json().get("items", [])\nassert items, list_resp.text\nlisted = items[0]\nassert listed["id"] == draft_id, listed\nassert listed.get("case_no") == case_no, listed\nassert listed.get("client_name") == "ä¸\212æµ·å\220¯è¡¡ç\237¥è¯\206äº§æ\235\203æ\234\215å\212¡æ\234\211é\231\220å\205¬å\217¸", listed\n\ndetail_resp = client.get(f"/api/v1/fees/drafts/{draft_id}", headers=headers)\nassert detail_resp.status_code == 200, detail_resp.text\ndetail = detail_resp.json()\nassert detail.get("case_no") == case_no, detail\nassert detail.get("client_name") == "ä¸\212æµ·å\220¯è¡¡ç\237¥è¯\206äº§æ\235\203æ\234\215å\212¡æ\234\211é\231\220å\205¬å\217¸", detail\n\nitems_resp = client.get(f"/api/v1/fees/drafts/{draft_id}/items", headers=headers)\nassert items_resp.status_code == 200, items_resp.text\nassert isinstance(items_resp.json(), list), items_resp.text\n\nmissing_resp = client.get(f"/api/v1/fees/drafts/{uuid4()}/items", headers=headers)\nassert missing_resp.status_code == 404, missing_resp.text\n\nwith open("../frontend/src/modules/fees/pages/FeeDraftDetail.vue", "r", encoding="utf-8") as fh:\n    source = fh.read()\nwith open("../frontend/src/api/fees.types.ts", "r", encoding="utf-8") as fh:\n    fee_types = fh.read()\nassert "clientDisplayName" in source\nassert "caseDisplayNo" in source\nassert "displayDraftId" in source\nassert "client_name" in fee_types\nassert "case_no" in fee_types\n\nprint({\n    "login": login.status_code,\n    "create_client": client_resp.status_code,\n    "create_case": case_resp.status_code,\n    "create_draft": draft_resp.status_code,\n    "list": list_resp.status_code,\n    "detail": detail_resp.status_code,\n    "items": items_resp.status_code,\n    "missing_items": missing_resp.status_code,\n    "draft_id": draft_id,\n    "case_no": detail.get("case_no"),\n    "client_name": detail.get("client_name"),\n})\nPY'"}
