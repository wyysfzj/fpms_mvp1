{"ts":"20260308T150454","step":"test","cmd":"/bin/zsh -lc $'cd /Users/cfcc/Workshop/myprojects/fpms_mvp1_blueprint_atomic && PYTHONPATH=backend python3 - <<\'PY\'\nfrom uuid import uuid4\nfrom fastapi.testclient import TestClient\nfrom backend.app.main import app\n\nclient = TestClient(app)\nlogin = client.post("/api/v1/auth/login", json={"username": "admin", "password": "admin123"})\nassert login.status_code == 200, login.text\ntoken = login.json()["access_token"]\nheaders = {"Authorization": f"Bearer {token}"}\n\nlst = client.get("/api/v1/fees/drafts?page=1&page_size=20", headers=headers)\nassert lst.status_code == 200, lst.text\nitems = lst.json().get("items", [])\nassert items, "no fee drafts available for smoke"\ndraft = items[0]\ndraft_id = draft["id"]\nassert "case_no" in draft, draft\nassert "client_name" in draft, draft\n\nget_detail = client.get(f"/api/v1/fees/drafts/{draft_id}", headers=headers)\nassert get_detail.status_code == 200, get_detail.text\ndetail = get_detail.json()\nassert detail["id"] == draft_id, detail\nassert "case_no" in detail, detail\nassert "client_name" in detail, detail\n\nget_items = client.get(f"/api/v1/fees/drafts/{draft_id}/items", headers=headers)\nassert get_items.status_code == 200, get_items.text\nassert isinstance(get_items.json(), list), get_items.text\n\nmissing = client.get(f"/api/v1/fees/drafts/{uuid4()}/items", headers=headers)\nassert missing.status_code == 404, missing.text\n\nwith open("frontend/src/modules/fees/pages/FeeDraftDetail.vue", "r", encoding="utf-8") as fh:\n    source = fh.read()\nassert "case_no" in source, "FeeDraftDetail.vue should prefer case_no"\nassert "client_name" in source or "clientDisplayName" in source, "FeeDraftDetail.vue should prefer client readable label"\nassert "displayDraftId" in source, "FeeDraftDetail.vue should use demo-friendly draft label"\n\nprint({\n    "login": login.status_code,\n    "list": lst.status_code,\n    "detail": get_detail.status_code,\n    "items": get_items.status_code,\n    "missing_items": missing.status_code,\n    "draft_id": draft_id,\n    "case_no": detail.get("case_no"),\n    "client_name": detail.get("client_name"),\n})\nPY'"}
{"ts":"20260308T150625","step":"test","cmd":"/bin/zsh -lc $'TOKEN=$(curl -sS -X POST http://127.0.0.1:8000/api/v1/auth/login -H \'Content-Type: application/json\' -d \'{"username":"admin","password":"admin123"}\' | sed -E \'s/.*"access_token":"([^"]+)".*/\\1/\'); test -n "$TOKEN"; DRAFT_JSON=$(curl -sS "http://127.0.0.1:8000/api/v1/fees/drafts?page=1&page_size=20" -H "Authorization: Bearer $TOKEN"); echo "$DRAFT_JSON" > /tmp/demo_fee_drafts.json; python3 - <<\'PY\'\nimport json, pathlib\npayload = json.loads(pathlib.Path("/tmp/demo_fee_drafts.json").read_text())\nitems = payload.get("items") or []\nassert items, "no fee drafts available"\nfirst = items[0]\nassert "case_no" in first, first\nassert "client_name" in first, first\nprint(first["id"])\nPY\nDRAFT_ID=$(python3 - <<\'PY\'\nimport json, pathlib\npayload = json.loads(pathlib.Path("/tmp/demo_fee_drafts.json").read_text())\nprint((payload.get("items") or [])[0]["id"])\nPY\n); CODE_ITEMS=$(curl -sS -o /tmp/demo_fee_items.json -w "%{http_code}" "http://127.0.0.1:8000/api/v1/fees/drafts/$DRAFT_ID/items" -H "Authorization: Bearer $TOKEN"); test "$CODE_ITEMS" = "200"; CODE_DETAIL=$(curl -sS -o /tmp/demo_fee_detail.json -w "%{http_code}" "http://127.0.0.1:8000/api/v1/fees/drafts/$DRAFT_ID" -H "Authorization: Bearer $TOKEN"); test "$CODE_DETAIL" = "200"; CODE_MISSING=$(curl -sS -o /tmp/demo_fee_missing.json -w "%{http_code}" "http://127.0.0.1:8000/api/v1/fees/drafts/00000000-0000-0000-0000-000000000000/items" -H "Authorization: Bearer $TOKEN"); test "$CODE_MISSING" = "404"; python3 - <<\'PY\'\nimport json, pathlib\nfrom pathlib import Path\n\ndetail = json.loads(Path(/tmp/demo_fee_detail.json).read_text())\nassert case_no in detail, detail\nassert client_name in detail, detail\nsource = Path(frontend/src/modules/fees/pages/FeeDraftDetail.vue).read_text(encoding=utf-8)\nassert client_name in Path(frontend/src/api/fees.types.ts).read_text(encoding=utf-8)\nassert case_no in Path(frontend/src/api/fees.types.ts).read_text(encoding=utf-8)\nassert clientDisplayName in source\nassert caseDisplayNo in source\nassert displayDraftId in source\nprint(json.dumps({\n  detail_id: detail[id],\n  case_no: detail.get(case_no),\n  client_name: detail.get(client_name)\n}, ensure_ascii=False))\nPY'"}
