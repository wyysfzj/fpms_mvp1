+  if (!apiError || apiError.status === 0) return '网络异常或服务不可用，收入数据加载失败。'
+
+  if (apiError.status === 404 && apiError.code === 'CASE_RECEIPT_NOT_FOUND') {
+    return '该项目暂无收入汇总记录。'
+  }
+  if (apiError.status === 400) return '项目参数不合法，请检查后重试。'
