+      validator: (_rule, value: unknown, callback) => {
+        if (value === null || value === undefined || value === '') {
+          callback()
+          return
+        }
+        const numeric = Number(value)
+        if (!Number.isFinite(numeric) || numeric <= 0) {
+          callback(new Error('缴费金额必须大于 0'))
+          return
+        }
+        callback()
+      },
+      trigger: 'blur',
+    },
+  ],
+}
+
