+
+        user = T_User(
+            id=str(uuid4()),
+            username=f"{username_prefix}-{uuid4().hex[:8]}",
+            display_name="Agent User",
+            password_hash=get_password_hash("password123"),
+            is_active=True,
+        )
+        db.add(user)
+        db.flush()
+        db.add(T_UserRole(user_id=user.id, role_id=role.id))
+        db.commit()
+        return user.id
