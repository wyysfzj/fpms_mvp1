+from __future__ import annotations
+
+from datetime import date
+from typing import Any
+
+from fastapi import APIRouter, Depends, Query
+from pydantic import BaseModel
+from sqlalchemy import func, select
+from sqlalchemy.orm import Session
+
+from app.api.deps import require_perm
+from app.db.session import get_db
+from app.modules.collections.models import Dunning
+from app.modules.collections.service import (
+    generate_dunning_batches,
+    mark_bill_bad_debt,
+    restore_bill_from_bad_debt,
+)
+
+router = APIRouter()
+
+
+class DunningGenerateIn(BaseModel):
+    to_date: date
+    client_id: str | None = None
+    client_ids: list[str] | None = None
+    include_statuses: list[str] | None = None
+    exclude_statuses: list[str] | None = None
+    strict_conflict: bool = False
+
+
+@router.get("/dunning", summary="List dunning batches")
+def get_dunning(
+    round_no: int | None = Query(default=None),
+    status: str | None = Query(default=None),
+    client_id: str | None = Query(default=None),
+    page: int = Query(default=1, ge=1),
+    page_size: int = Query(default=20, ge=1),
+    _perm: None = Depends(require_perm("Dunning.Read")),
+    db: Session = Depends(get_db),
+) -> dict[str, Any]:
+    stmt = select(Dunning)
+
+    if round_no is not None:
+        stmt = stmt.where(Dunning.round_no == round_no)
+    if status:
+        stmt = stmt.where(Dunning.status == status)
+    if client_id:
+        stmt = stmt.where(Dunning.client_id == client_id)
+
+    total = db.execute(select(func.count()).select_from(stmt.subquery())).scalar_one()
+
+    offset = (page - 1) * page_size
+    items = (
+        db.execute(
+            stmt.order_by(Dunning.created_at.desc(), Dunning.id.desc())
+            .offset(offset)
+            .limit(page_size)
+        )
+        .scalars()
+        .all()
+    )
+
+    return {
+        "items": [
+            {
+                "id": item.id,
+                "dunning_no": item.dunning_no,
+                "client_id": item.client_id,
+                "round_no": item.round_no,
+                "to_date": item.to_date,
+                "currency": item.currency,
+                "total_amount": item.total_amount,
+                "status": item.status,
+                "sent_date": item.sent_date,
+                "remark": item.remark,
+                "created_at": item.created_at,
+                "updated_at": item.updated_at,
+            }
+            for item in items
+        ],
+        "page": page,
+        "page_size": page_size,
+        "total": total,
+    }
+
+
+@router.post("/dunning", summary="Generate dunning batches")
+def post_dunning(
+    payload: DunningGenerateIn,
+    _perm: None = Depends(require_perm("Dunning.Create")),
+    db: Session = Depends(get_db),
+) -> dict[str, Any]:
+    return generate_dunning_batches(
+        db,
+        to_date=payload.to_date,
+        client_id=payload.client_id,
+        client_ids=payload.client_ids,
+        include_statuses=payload.include_statuses,
+        exclude_statuses=payload.exclude_statuses,
+        strict_conflict=payload.strict_conflict,
+    )
+
+
+@router.post("/bills/{bill_id}/bad-debt", summary="Mark bill as bad debt")
+def post_bill_bad_debt(
+    bill_id: str,
+    _perm: None = Depends(require_perm("BadDebt.Action")),
+    db: Session = Depends(get_db),
+) -> dict[str, Any]:
+    bill = mark_bill_bad_debt(db, bill_id=bill_id)
+    return {
+        "id": bill.id,
+        "bill_no": bill.bill_no,
+        "client_id": bill.client_id,
+        "currency": bill.currency,
+        "status": bill.status,
+        "bill_date": bill.bill_date,
+        "due_date": bill.due_date,
+        "amount": bill.amount,
+        "balance": bill.balance,
+        "updated_at": bill.updated_at,
+    }
+
+
+@router.post("/bills/{bill_id}/bad-debt/restore", summary="Restore bill from bad debt")
+def post_bill_bad_debt_restore(
+    bill_id: str,
+    _perm: None = Depends(require_perm("BadDebt.Action")),
+    db: Session = Depends(get_db),
+) -> dict[str, Any]:
+    bill = restore_bill_from_bad_debt(db, bill_id=bill_id)
+    return {
+        "id": bill.id,
+        "bill_no": bill.bill_no,
+        "client_id": bill.client_id,
+        "currency": bill.currency,
+        "status": bill.status,
+        "bill_date": bill.bill_date,
+        "due_date": bill.due_date,
+        "amount": bill.amount,
+        "balance": bill.balance,
+        "updated_at": bill.updated_at,
+    }
diff --git a/backend/app/modules/collections/service.py b/backend/app/modules/collections/service.py
new file mode 100644
index 0000000..5db9cfe
--- /dev/null
+++ b/backend/app/modules/collections/service.py
@@ -0,0 +1,393 @@
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+from hashlib import sha256
+from typing import Any
+
+from sqlalchemy import func, select
+from sqlalchemy.orm import Session
+
+from app.core.errors import raise_business_error
+from app.modules.billing.models import Bill
+from app.modules.collections.models import Dunning, DunningLine
+
+_DEFAULT_EXCLUDED_BILL_STATUSES = {
+    "SETTLED",
+    "CANCELLED",
+    "VOID",
+    "WRITEOFF",
+    "BAD_DEBT",
+}
+
+
+def _normalize_statuses(values: list[str] | None) -> set[str]:
+    if values is None:
+        return set()
+    normalized: set[str] = set()
+    for value in values:
+        text = str(value).strip().upper()
+        if text:
+            normalized.add(text)
+    return normalized
+
+
+def _normalize_client_ids(client_ids: list[str] | None) -> list[str]:
+    if client_ids is None:
+        return []
+    normalized: list[str] = []
+    seen: set[str] = set()
+    for client_id in client_ids:
+        value = str(client_id).strip()
+        if not value or value in seen:
+            continue
+        seen.add(value)
+        normalized.append(value)
+    return normalized
+
+
+def _build_snapshot_signature(*, to_date: date, bills: list[Bill]) -> str:
+    payload_parts: list[str] = [to_date.isoformat()]
+    for bill in sorted(bills, key=lambda b: (b.id, b.due_date or date.max)):
+        payload_parts.append(
+            "|".join(
+                [
+                    bill.id or "",
+                    bill.bill_no or "",
+                    (bill.due_date.isoformat() if bill.due_date else ""),
+                    (bill.status or ""),
+                    str(Decimal(bill.balance or 0)),
+                    (bill.currency or ""),
+                ]
+            )
+        )
+    payload = "\n".join(payload_parts)
+    return sha256(payload.encode("utf-8")).hexdigest()
+
+
+def _marker(*, to_date: date, signature: str) -> str:
+    return f"AUTO_DUNNING|to_date={to_date.isoformat()}|sig={signature}"
+
+
+def filter_overdue_bills(
+    db: Session,
+    *,
+    to_date: date,
+    client_ids: list[str] | None = None,
+    include_statuses: list[str] | None = None,
+    exclude_statuses: list[str] | None = None,
+) -> list[Bill]:
+    """Filter overdue bills as of cutoff with optional client/status scope."""
+    if not isinstance(to_date, date):
+        raise_business_error(
+            "DUNNING_BATCH_STATE_INVALID",
+            "to_date is required and must be a valid date",
+            status_code=400,
+        )
+
+    normalized_client_ids = _normalize_client_ids(client_ids)
+    if client_ids is not None and not normalized_client_ids:
+        raise_business_error(
+            "DUNNING_BATCH_STATE_INVALID",
+            "client scope is invalid",
+            status_code=400,
+        )
+
+    include_set = _normalize_statuses(include_statuses)
+    exclude_set = (
+        _normalize_statuses(exclude_statuses)
+        if exclude_statuses is not None
+        else set(_DEFAULT_EXCLUDED_BILL_STATUSES)
+    )
+
+    if include_set and include_set & exclude_set:
+        raise_business_error(
+            "DUNNING_BATCH_STATE_INVALID",
+            "include_statuses and exclude_statuses conflict",
+            status_code=400,
+        )
+
+    stmt = select(Bill).where(
+        Bill.due_date.is_not(None),
+        Bill.due_date <= to_date,
+        Bill.balance > Decimal("0"),
+    )
+
+    if normalized_client_ids:
+        stmt = stmt.where(Bill.client_id.in_(normalized_client_ids))
+
+    if include_set:
+        stmt = stmt.where(func.upper(Bill.status).in_(sorted(include_set)))
+    elif exclude_set:
+        stmt = stmt.where(~func.upper(Bill.status).in_(sorted(exclude_set)))
+
+    stmt = stmt.order_by(
+        Bill.client_id.asc(), Bill.currency.asc(), Bill.due_date.asc(), Bill.id.asc()
+    )
+    return db.execute(stmt).scalars().all()
+
+
+def _serialize_batch(db: Session, batch: Dunning, *, reused: bool) -> dict[str, Any]:
+    lines = (
+        db.execute(
+            select(DunningLine)
+            .where(DunningLine.dunning_id == batch.id)
+            .order_by(DunningLine.line_no.asc(), DunningLine.id.asc())
+        )
+        .scalars()
+        .all()
+    )
+    return {
+        "id": batch.id,
+        "dunning_no": batch.dunning_no,
+        "client_id": batch.client_id,
+        "round_no": batch.round_no,
+        "to_date": batch.to_date,
+        "currency": batch.currency,
+        "total_amount": str(batch.total_amount),
+        "status": batch.status,
+        "reused": reused,
+        "line_count": len(lines),
+        "lines": [
+            {
+                "id": line.id,
+                "line_no": line.line_no,
+                "bill_id": line.bill_id,
+                "bill_no_snapshot": line.bill_no_snapshot,
+                "due_date_snapshot": line.due_date_snapshot,
+                "bill_status_snapshot": line.bill_status_snapshot,
+                "outstanding_amount": str(line.outstanding_amount),
+                "currency_snapshot": line.currency_snapshot,
+            }
+            for line in lines
+        ],
+    }
+
+
+def generate_dunning_batches(
+    db: Session,
+    *,
+    to_date: date,
+    client_id: str | None = None,
+    client_ids: list[str] | None = None,
+    include_statuses: list[str] | None = None,
+    exclude_statuses: list[str] | None = None,
+    strict_conflict: bool = False,
+    actor_id: str | None = None,
+) -> dict[str, Any]:
+    """Generate dunning head/line snapshots grouped by client and cutoff context."""
+    scoped_clients = _normalize_client_ids(client_ids)
+    if client_id:
+        scoped_clients = _normalize_client_ids([*scoped_clients, client_id])
+
+    overdue_bills = filter_overdue_bills(
+        db,
+        to_date=to_date,
+        client_ids=scoped_clients if scoped_clients else None,
+        include_statuses=include_statuses,
+        exclude_statuses=exclude_statuses,
+    )
+
+    if (client_id or scoped_clients) and not overdue_bills:
+        raise_business_error(
+            "DUNNING_BATCH_NOT_FOUND",
+            "No overdue bills found for requested scope",
+            status_code=404,
+        )
+
+    grouped: dict[tuple[str, str], list[Bill]] = {}
+    for bill in overdue_bills:
+        key = (bill.client_id, bill.currency)
+        grouped.setdefault(key, []).append(bill)
+
+    created_count = 0
+    reused_count = 0
+    batches: list[dict[str, Any]] = []
+
+    for (group_client_id, group_currency), bills in sorted(grouped.items(), key=lambda i: i[0]):
+        signature = _build_snapshot_signature(to_date=to_date, bills=bills)
+        marker = _marker(to_date=to_date, signature=signature)
+
+        existing = (
+            db.execute(
+                select(Dunning)
+                .where(
+                    Dunning.client_id == group_client_id,
+                    Dunning.to_date == to_date,
+                    Dunning.currency == group_currency,
+                    Dunning.remark == marker,
+                )
+                .order_by(Dunning.id.asc())
+            )
+            .scalars()
+            .first()
+        )
+        if existing:
+            if strict_conflict:
+                raise_business_error(
+                    "DUNNING_BATCH_STATE_INVALID",
+                    "Duplicate dunning generation request",
+                    details={"dunning_id": existing.id},
+                    status_code=409,
+                )
+            reused_count += 1
+            batches.append(_serialize_batch(db, existing, reused=True))
+            continue
+
+        next_round_no = (
+            db.execute(
+                select(func.coalesce(func.max(Dunning.round_no), 0)).where(
+                    Dunning.client_id == group_client_id,
+                    Dunning.currency == group_currency,
+                )
+            ).scalar_one()
+            + 1
+        )
+        total_amount = sum((Decimal(bill.balance or 0) for bill in bills), Decimal("0"))
+
+        batch = Dunning(
+            client_id=group_client_id,
+            dunning_no=None,
+            round_no=next_round_no,
+            to_date=to_date,
+            currency=group_currency,
+            total_amount=total_amount,
+            status="DRAFT",
+            remark=marker,
+            created_by=actor_id,
+            updated_by=actor_id,
+        )
+        db.add(batch)
+        db.flush()
+        batch.dunning_no = f"DN-{to_date.strftime('%Y%m%d')}-{batch.id:06d}"
+
+        for idx, bill in enumerate(
+            sorted(bills, key=lambda b: (b.due_date or date.max, b.id)), start=1
+        ):
+            db.add(
+                DunningLine(
+                    dunning_id=batch.id,
+                    bill_id=bill.id,
+                    line_no=idx,
+                    bill_no_snapshot=bill.bill_no,
+                    due_date_snapshot=bill.due_date,
+                    bill_status_snapshot=bill.status,
+                    outstanding_amount=Decimal(bill.balance or 0),
+                    currency_snapshot=bill.currency,
+                    remark=f"snapshot:{to_date.isoformat()}",
+                    created_by=actor_id,
+                    updated_by=actor_id,
+                )
+            )
+
+        db.flush()
+        created_count += 1
+        batches.append(_serialize_batch(db, batch, reused=False))
+
+    db.commit()
+
+    return {
+        "summary": {
+            "to_date": to_date,
+            "eligible_bills": len(overdue_bills),
+            "groups": len(grouped),
+            "created": created_count,
+            "reused": reused_count,
+            "batches": len(batches),
+        },
+        "batches": batches,
+    }
+
+
+def mark_bill_bad_debt(
+    db: Session,
+    *,
+    bill_id: str,
+    actor_id: str | None = None,
+) -> Bill:
+    """Mark a bill as BAD_DEBT when eligible."""
+    bill = db.execute(select(Bill).where(Bill.id == bill_id)).scalar_one_or_none()
+    if not bill:
+        raise_business_error("BILL_NOT_FOUND", "Bill not found", status_code=404)
+
+    current_status = (bill.status or "").strip().upper()
+    if current_status == "BAD_DEBT":
+        raise_business_error(
+            "BAD_DEBT_ALREADY_MARKED",
+            "Bill already marked as bad debt",
+            status_code=409,
+        )
+
+    if Decimal(bill.balance or 0) <= Decimal("0"):
+        raise_business_error(
+            "BAD_DEBT_NOT_ALLOWED",
+            "Only bills with outstanding balance can be marked bad debt",
+            status_code=400,
+        )
+
+    invalid_statuses = {"SETTLED", "CANCELLED", "VOID", "WRITEOFF"}
+    if current_status in invalid_statuses:
+        raise_business_error(
+            "BAD_DEBT_NOT_ALLOWED",
+            "Bill is not eligible for bad debt action",
+            details={"status": bill.status},
+            status_code=400,
+        )
+
+    bill.status = "BAD_DEBT"
+    bill.updated_by = actor_id
+    db.commit()
+    db.refresh(bill)
+    return bill
+
+
+def restore_bill_from_bad_debt(
+    db: Session,
+    *,
+    bill_id: str,
+    actor_id: str | None = None,
+) -> Bill:
+    """Restore BAD_DEBT bill status from current balance/amount snapshot."""
+    bill = db.execute(select(Bill).where(Bill.id == bill_id)).scalar_one_or_none()
+    if not bill:
+        raise_business_error("BILL_NOT_FOUND", "Bill not found", status_code=404)
+
+    current_status = (bill.status or "").strip().upper()
+    if current_status != "BAD_DEBT":
+        raise_business_error(
+            "BAD_DEBT_RESTORE_INVALID",
+            "Bill is not currently in BAD_DEBT status",
+            status_code=409,
+        )
+
+    amount = Decimal(bill.amount or 0)
+    balance = Decimal(bill.balance or 0)
+
+    # Guard for inconsistent financial states that cannot be restored deterministically.
+    if amount < Decimal("0") or balance > amount:
+        raise_business_error(
+            "BAD_DEBT_NOT_ALLOWED",
+            "Invalid restore preconditions for bill financial state",
+            details={"amount": str(amount), "balance": str(balance)},
+            status_code=400,
+        )
+
+    if balance == amount:
+        restored_status = "UNSETTLED"
+    elif Decimal("0") < balance < amount:
+        restored_status = "PARTIALLY_SETTLED"
+    elif balance <= Decimal("0"):
+        restored_status = "SETTLED"
+    else:
+        raise_business_error(
+            "BAD_DEBT_NOT_ALLOWED",
+            "Invalid restore preconditions for bill financial state",
+            details={"amount": str(amount), "balance": str(balance)},
+            status_code=400,
+        )
+
+    bill.status = restored_status
+    bill.updated_by = actor_id
+    db.commit()
+    db.refresh(bill)
+    return bill
