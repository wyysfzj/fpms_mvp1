+    assert payload["bad_debt_voucher"] is None
+    assert payload["bad_debt_recoveries"] == []
+    assert Decimal(str(payload["bad_debt_total_recovered"])) == Decimal("0")
+    assert Decimal(str(payload["bad_debt_remaining_amount"])) == Decimal("0")
