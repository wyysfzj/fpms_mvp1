Fault = Callable[[str], None]


class TaskctlError(RuntimeError):
    """Fail-closed task controller error."""


class LeaseCleanupError(TaskctlError):
    """The kernel lease was released, but diagnostic cleanup failed."""


class PostEffectCrash(BaseException):
    """Test/recovery sentinel for an effect whose result was not installed."""


def _fault(fault: Fault | None, point: str) -> None:
    if fault is not None:
        fault(point)


def canonical_json(value: object) -> bytes:
    return (
        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
        + "\n"
    ).encode("utf-8")


def _canonical_digest(value: object) -> str:
    payload = json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def sha256_bytes(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def sha256_file(path: Path) -> str:
    try:
        return sha256_bytes(path.read_bytes())
    except OSError as exc:
        raise TaskctlError(f"cannot hash {path}: {exc}") from exc


def _is_atomic_temporary(path: Path) -> bool:
    return ATOMIC_TEMP_PATTERN.fullmatch(path.name) is not None


def _atomic_temporary_target(path: Path) -> Path | None:
    match = re.fullmatch(
        r"\.(?P<target>.+)\.taskctl-[1-9][0-9]*-[0-9a-f]{32}", path.name
    ) or re.fullmatch(r"\.(?P<target>.+)\.create-[1-9][0-9]*-[0-9a-f]{32}", path.name)
    return path.with_name(match.group("target")) if match is not None else None


def _reconcilable_atomic_temporary(
    path: Path, info: os.stat_result, recovery_started_ns: int | None
) -> bool:
    if (
        recovery_started_ns is None
        or info.st_mtime_ns < recovery_started_ns
        or info.st_uid != os.getuid()
    ):
        return False
    if info.st_nlink == 1:
        return True
    target = _atomic_temporary_target(path)
    if target is None or info.st_nlink != 2:
        return False
    try:
        target_info = target.lstat()
    except FileNotFoundError:
        return False
    return (
        stat.S_ISREG(target_info.st_mode)
        and target_info.st_dev == info.st_dev
        and target_info.st_ino == info.st_ino
    )


def load_json(path: Path, label: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise TaskctlError(f"invalid {label}: {exc}") from exc
    if not isinstance(value, dict):
        raise TaskctlError(f"invalid {label}: top level must be an object")
    return value


def _process_is_alive(pid: int) -> bool:
    if pid == os.getpid():
        return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _cleanup_stale_atomic_candidates(
    path: Path, patterns: Sequence[re.Pattern]
) -> None:
    removed = False
    for candidate in path.parent.iterdir():
        match = next(
            (
                pattern.fullmatch(candidate.name)
                for pattern in patterns
                if pattern.fullmatch(candidate.name)
            ),
            None,
        )
        if match is None:
            continue
        pid = int(match.group("pid"))
        info = candidate.lstat()
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.getuid()
            or info.st_nlink != 1
            or _process_is_alive(pid)
        ):
            raise TaskctlError(f"unsafe or active atomic temporary: {candidate}")
        candidate.unlink()
        removed = True
    if removed:
        flags = os.O_RDONLY
        if hasattr(os, "O_DIRECTORY"):
            flags |= os.O_DIRECTORY
        descriptor = os.open(path.parent, flags)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


def atomic_write(
    path: Path,
    content: bytes,
    *,
    fault: Fault | None = None,
    mode: int = 0o600,
) -> None:
    """Install complete bytes with file and directory durability."""
    path.parent.mkdir(parents=True, exist_ok=True)
    name = re.escape(path.name)
    _cleanup_stale_atomic_candidates(
        path,
        (re.compile(rf"\.{name}\.taskctl-(?P<pid>[1-9][0-9]*)-[0-9a-f]{{32}}\Z"),),
    )
    temporary = path.with_name(f".{path.name}.taskctl-{os.getpid()}-{uuid.uuid4().hex}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = -1
    directory_descriptor = -1
    try:
        descriptor = os.open(temporary, flags, mode)
        _fault(fault, "before_write")
        view = memoryview(content)
        offset = 0
        while offset < len(view):
            try:
                written = os.write(descriptor, view[offset:])
            except InterruptedError:
                continue
            if written <= 0:
                raise OSError(errno.EIO, "short write made no progress")
            offset += written
        _fault(fault, "after_write")
        _fault(fault, "before_file_fsync")
        os.fsync(descriptor)
        _fault(fault, "after_file_fsync")
        os.close(descriptor)
        descriptor = -1
        _fault(fault, "before_replace")
        os.replace(temporary, path)
        _fault(fault, "after_replace")
        directory_flags = os.O_RDONLY
        if hasattr(os, "O_DIRECTORY"):
            directory_flags |= os.O_DIRECTORY
        directory_descriptor = os.open(path.parent, directory_flags)
        _fault(fault, "before_dir_fsync")
        os.fsync(directory_descriptor)
        _fault(fault, "after_dir_fsync")
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if directory_descriptor >= 0:
            os.close(directory_descriptor)
        try:
            current = temporary.lstat()
        except FileNotFoundError:
            current = None
        if current is not None:
            if not stat.S_ISREG(current.st_mode):
                raise TaskctlError(f"refusing to remove non-regular temp {temporary}")
            temporary.unlink()


def atomic_create(
    path: Path,
    content: bytes,
    *,
    mode: int = 0o600,
    fault: Fault | None = None,
) -> None:
    """Durably install a new authority file without replacing an existing one."""
    path.parent.mkdir(parents=True, exist_ok=True)
    name = re.escape(path.name)
    _cleanup_stale_atomic_candidates(
        path,
        (
            re.compile(rf"\.{name}\.create-(?P<pid>[1-9][0-9]*)-[0-9a-f]{{32}}\Z"),
            re.compile(
                rf"\.\.{name}\.create-[1-9][0-9]*-[0-9a-f]{{32}}"
                rf"\.taskctl-(?P<pid>[1-9][0-9]*)-[0-9a-f]{{32}}\Z"
            ),
        ),
    )
    staging = path.with_name(f".{path.name}.create-{os.getpid()}-{uuid.uuid4().hex}")
    atomic_write(staging, content, mode=mode, fault=fault)
    directory_descriptor = -1
    try:
        _fault(fault, "before_exclusive_link")
        os.link(staging, path, follow_symlinks=False)
        _fault(fault, "after_exclusive_link")
        directory_flags = os.O_RDONLY
        if hasattr(os, "O_DIRECTORY"):
            directory_flags |= os.O_DIRECTORY
        directory_descriptor = os.open(path.parent, directory_flags)
        _fault(fault, "before_create_dir_fsync")
        os.fsync(directory_descriptor)
        _fault(fault, "after_create_dir_fsync")
    except FileExistsError as exc:
        raise TaskctlError(f"authority file already exists: {path}") from exc
    finally:
        if directory_descriptor >= 0:
            os.close(directory_descriptor)
        try:
            info = staging.lstat()
        except FileNotFoundError:
            info = None
        if info is not None:
            if not stat.S_ISREG(info.st_mode):
                raise TaskctlError(
                    f"refusing to remove non-regular staging file {staging}"
                )
            staging.unlink()


class LockLease:
    """Nonblocking kernel-authoritative FD lease with diagnostic sidecar."""

    def __init__(
        self,
        path: Path,
        *,
        owner: str,
        sidecar_writer: Callable[[Path, bytes], None] | None = None,
        wait_timeout: float = 0.0,
    ) -> None:
        self.path = path
        self.owner = owner
        self.sidecar = path.with_suffix(".owner.json")
        self.sidecar_writer = sidecar_writer or atomic_write
        self.wait_timeout = wait_timeout
        self.descriptor: int | None = None

    def acquire(self) -> None:
        if self.descriptor is not None:
            raise TaskctlError("lease is already held")
        self.path.parent.mkdir(parents=True, exist_ok=True)
        flags = os.O_RDWR | os.O_CREAT
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        descriptor = os.open(self.path, flags, 0o600)
        try:
            info = os.fstat(descriptor)
            if not stat.S_ISREG(info.st_mode):
                raise TaskctlError("lease path must be a regular file")
            deadline = time.monotonic() + self.wait_timeout
            while True:
                try:
                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError as exc:
                    if time.monotonic() >= deadline:
                        raise TaskctlError(f"lease contention: {self.path}") from exc
                    time.sleep(0.005)
            sidecar = {
                "owner": self.owner,
                "pid": os.getpid(),
                "acquired_ns": time.time_ns(),
            }
            self.sidecar_writer(self.sidecar, canonical_json(sidecar))
        except BaseException:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_UN)
            finally:
                os.close(descriptor)
            raise
        self.descriptor = descriptor

    def release(self) -> None:
        descriptor = self.descriptor
        if descriptor is None:
            return
        self.descriptor = None
        cleanup_error: OSError | None = None
        try:
            self.sidecar.unlink(missing_ok=True)
        except OSError as exc:
            cleanup_error = exc
        try:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        finally:
            os.close(descriptor)
        if cleanup_error is not None:
            raise LeaseCleanupError(
                f"lease sidecar cleanup failed after FD release: {cleanup_error}"
            ) from cleanup_error

    def __enter__(self) -> LockLease:
        self.acquire()
        return self

    def __exit__(self, *_args: object) -> None:
        self.release()


def _event_name(ordinal: int, kind: str) -> str:
    return f"{ordinal:08d}.{kind}.json"


class EventStore:
    """Append-only command/result events with legacy JSONL projections."""

    def __init__(
        self,
        artifact: Path,
        task_id: str,
        *,
        fault: Fault | None = None,
    ) -> None:
        self.artifact = artifact
        self.task_id = task_id
        self.events = artifact / "events"
        self.lock_path = artifact / "locks/controller.lock"
        self.fault = fault

    def ensure_authority_chain(
        self, *, create: bool, include_lock_root: bool = True
    ) -> None:
        authorities = [
            (self.artifact.parent, "artifacts authority root"),
            (self.artifact, "task artifact authority root"),
        ]
        if include_lock_root:
            authorities.append((self.artifact / "locks", "task lock authority root"))
        for path, label in authorities:
            try:
                info = path.lstat()
            except FileNotFoundError:
                if not create:
                    raise TaskctlError(f"{label} is missing")
                try:
                    path.mkdir(mode=0o700)
                except FileExistsError:
                    pass
                info = path.lstat()
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                raise TaskctlError(f"{label} must be a real directory, not a symlink")

    def lease(self, *, owner: str, wait_timeout: float = 2.0) -> LockLease:
        self.ensure_authority_chain(create=True)
        return LockLease(
            self.lock_path,
            owner=owner,
            wait_timeout=wait_timeout,
        )

    def _path(self, ordinal: int, kind: str) -> Path:
        return self.events / _event_name(ordinal, kind)

    def _ensure_events_directory(self, *, create: bool) -> bool:
        self.ensure_authority_chain(create=create, include_lock_root=create)
        try:
            info = self.events.lstat()
        except FileNotFoundError:
            if not create:
                return False
            self.events.mkdir(parents=True)
            info = self.events.lstat()
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            raise TaskctlError(
                "events authority root must be a real directory, not a symlink"
            )
        return True

    def _reconcile_linked_event_staging_aliases(self) -> None:
        if not self._ensure_events_directory(create=False):
            return
        pattern = re.compile(
            r"\.(?P<target>[0-9]{8}\.(?:command|result)\.json)"
            r"\.create-[1-9][0-9]*-[0-9a-f]{32}\Z"
        )
        removed = False
        for candidate in self.events.iterdir():
            match = pattern.fullmatch(candidate.name)
            if match is None:
                continue
            candidate_info = candidate.lstat()
            target = self.events / match.group("target")
            try:
                target_info = target.lstat()
            except FileNotFoundError:
                continue
            if (
                not stat.S_ISREG(candidate_info.st_mode)
                or not stat.S_ISREG(target_info.st_mode)
                or candidate_info.st_uid != os.getuid()
                or candidate_info.st_nlink != 2
                or target_info.st_nlink != 2
                or candidate_info.st_dev != target_info.st_dev
                or candidate_info.st_ino != target_info.st_ino
            ):
                raise TaskctlError(
                    f"unsafe linked event staging alias: {candidate.name}"
                )
            candidate.unlink()
            removed = True
        if removed:
            flags = os.O_RDONLY
            if hasattr(os, "O_DIRECTORY"):
                flags |= os.O_DIRECTORY
            descriptor = os.open(self.events, flags)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)

    def _event_fault(self, kind: str) -> Fault:
        def callback(point: str) -> None:
            _fault(self.fault, point)
            _fault(self.fault, f"{point}_{kind}_event")

        return callback

    def _ordinals(self, kind: str) -> list[int]:
        if kind not in {"command", "result"}:
            raise TaskctlError("invalid event kind")
        if not self._ensure_events_directory(create=False):
            return []
        ordinals: list[int] = []
        seen: set[int] = set()
        for path in self.events.glob(f"*.{kind}.json"):
            info = path.lstat()
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
                raise TaskctlError(
                    f"event authority must be a regular file: {path.name}"
                )
            try:
                ordinal = int(path.name.split(".", 1)[0])
            except ValueError as exc:
                raise TaskctlError(f"invalid event filename: {path.name}") from exc
            if (
                ordinal <= 0
                or path.name != _event_name(ordinal, kind)
                or ordinal in seen
            ):
                raise TaskctlError(f"invalid or duplicate event filename: {path.name}")
            seen.add(ordinal)
            ordinals.append(ordinal)
        ordered = sorted(ordinals)
        if ordered and ordered != list(range(1, ordered[-1] + 1)):
            raise TaskctlError(f"append-only {kind} event sequence has an ordinal gap")
        return ordered

    def _load_event(self, ordinal: int, kind: str) -> dict[str, Any]:
        if kind not in {"command", "result"} or ordinal <= 0:
            raise TaskctlError("invalid event lookup")
        value = load_json(self._path(ordinal, kind), f"{kind} event {ordinal}")
        if (
            value.get("schema_version") != 2
            or value.get("task_id") != self.task_id
            or type(value.get("ordinal")) is not int
            or value["ordinal"] != ordinal
            or not isinstance(value.get("step"), str)
            or not value["step"]
        ):
            raise TaskctlError(f"invalid {kind} event identity at ordinal {ordinal}")
        if kind == "command":
            if (
                not isinstance(value.get("request_digest"), str)
                or not HEX_PATTERN.fullmatch(value["request_digest"])
                or not isinstance(value.get("argv"), list)
                or not all(isinstance(item, str) for item in value["argv"])
                or not isinstance(value.get("cwd"), str)
                or not isinstance(value.get("classification"), str)
                or not isinstance(value.get("replay_safe"), bool)
            ):
                raise TaskctlError(f"invalid command event schema at ordinal {ordinal}")
            request = {
                "task_id": value["task_id"],
                "step": value["step"],
                "argv": value["argv"],
                "cwd": value["cwd"],
                "classification": value["classification"],
                "replay_safe": value["replay_safe"],
            }
            if _canonical_digest(request) != value["request_digest"]:
                raise TaskctlError(
                    f"command request digest mismatch at ordinal {ordinal}"
                )
        else:
            if type(value.get("rc")) is not int:
                raise TaskctlError(f"invalid result event schema at ordinal {ordinal}")
            command_path = self._path(ordinal, "command")
            if not command_path.is_file():
                raise TaskctlError(f"orphan result event at ordinal {ordinal}")
            command = self._load_event(ordinal, "command")
            if command.get("step") != value.get("step"):
                raise TaskctlError(f"result/command mismatch at ordinal {ordinal}")
        return value

    @staticmethod
    def _legacy_prefix_metadata(prefixes: dict[str, bytes]) -> dict[str, Any]:
        if set(prefixes) != {"command", "result"} or not all(
            isinstance(value, bytes) for value in prefixes.values()
        ):
            raise TaskctlError("legacy prefix authority is invalid")
        return {
            "commands_length": len(prefixes["command"]),
            "commands_sha256": sha256_bytes(prefixes["command"]),
            "results_length": len(prefixes["result"]),
            "results_sha256": sha256_bytes(prefixes["result"]),
        }

    def validate_legacy_views(self, prefixes: dict[str, bytes]) -> dict[str, Any]:
        self.ensure_authority_chain(create=False)
        metadata_path = self.artifact / "legacy-prefix.json"
        expected = self._legacy_prefix_metadata(prefixes)
        try:
            metadata_info = metadata_path.lstat()
        except FileNotFoundError:
            metadata_info = None
        if (
            metadata_info is None
            or not stat.S_ISREG(metadata_info.st_mode)
            or metadata_path.read_bytes() != canonical_json(expected)
        ):
            raise TaskctlError("legacy prefix metadata changed or is missing")
        for kind, prefix in prefixes.items():
            view = self.artifact / f"{kind}s.jsonl"
            try:
                view_info = view.lstat()
            except FileNotFoundError:
                view_info = None
            if (
                view_info is None
                or not stat.S_ISREG(view_info.st_mode)
                or not view.read_bytes().startswith(prefix)
            ):
                raise TaskctlError(f"legacy {kind} prefix changed")
        return expected

    def adopt_legacy_views(
        self, expected_prefixes: dict[str, bytes] | None = None
    ) -> dict[str, Any]:
        self.ensure_authority_chain(create=True)
        metadata_path = self.artifact / "legacy-prefix.json"
        commands_path = self.artifact / "commands.jsonl"
        results_path = self.artifact / "results.jsonl"
        prefixes = (
            expected_prefixes
            if expected_prefixes is not None
            else {
                "command": (
                    commands_path.read_bytes() if commands_path.exists() else b""
                ),
                "result": results_path.read_bytes() if results_path.exists() else b"",
            }
        )
        metadata = self._legacy_prefix_metadata(prefixes)
        content = canonical_json(metadata)
        for kind, prefix in prefixes.items():
            view = self.artifact / f"{kind}s.jsonl"
            try:
                info = view.lstat()
            except FileNotFoundError as exc:
                raise TaskctlError(f"legacy {kind} view is missing") from exc
            if not stat.S_ISREG(info.st_mode) or not view.read_bytes().startswith(
                prefix
            ):
                raise TaskctlError(f"legacy {kind} prefix does not match the view")
        try:
            metadata_info = metadata_path.lstat()
        except FileNotFoundError:
            metadata_info = None
        if metadata_info is not None and (
            not stat.S_ISREG(metadata_info.st_mode)
            or metadata_path.read_bytes() != content
        ):
            raise TaskctlError("legacy prefix metadata changed after adoption")
        if metadata_info is None:
            atomic_write(metadata_path, content)
        self.validate_legacy_views(prefixes)
        return metadata

    def _prefix(self, kind: str) -> bytes:
        metadata_path = self.artifact / "legacy-prefix.json"
        try:
            metadata_info = metadata_path.lstat()
        except FileNotFoundError:
            return b""
        if not stat.S_ISREG(metadata_info.st_mode):
            raise TaskctlError("legacy prefix metadata is not regular")
        metadata = load_json(metadata_path, "legacy prefix")
        if set(metadata) != {
            "commands_length",
            "commands_sha256",
            "results_length",
            "results_sha256",
        }:
            raise TaskctlError("invalid legacy prefix metadata")
        view = self.artifact / f"{kind}s.jsonl"
        try:
            view_info = view.lstat()
        except FileNotFoundError:
            current = b""
        else:
            if not stat.S_ISREG(view_info.st_mode):
                raise TaskctlError(f"legacy {kind} view is not regular")
            current = view.read_bytes()
        length = metadata[f"{kind}s_length"]
        expected = metadata[f"{kind}s_sha256"]
        if not isinstance(length, int) or length < 0 or not isinstance(expected, str):
            raise TaskctlError("invalid legacy prefix metadata")
        prefix = current[:length]
        if len(prefix) != length or sha256_bytes(prefix) != expected:
            raise TaskctlError(f"legacy {kind} prefix changed")
        return prefix

    def rebuild_views(self) -> None:
        self._ensure_events_directory(create=True)
        for kind in ("command", "result"):
            prefix = self._prefix(kind)
            rows = bytearray(prefix)
            if rows and not rows.endswith(b"\n"):
                rows.extend(b"\n")
            for ordinal in self._ordinals(kind):
                rows.extend(canonical_json(self._load_event(ordinal, kind)))

            def view_fault(point: str, *, kind: str = kind) -> None:
                if point in {
                    "before_file_fsync",
                    "before_replace",
                    "before_dir_fsync",
                }:
                    _fault(self.fault, f"{point}_{kind}_view")

            view_path = self.artifact / f"{kind}s.jsonl"
            try:
                view_info = view_path.lstat()
            except FileNotFoundError:
                view_mode = 0o600
            else:
                if not stat.S_ISREG(view_info.st_mode):
                    raise TaskctlError(f"{kind} view is not a regular file")
                view_mode = stat.S_IMODE(view_info.st_mode)
            atomic_write(view_path, bytes(rows), fault=view_fault, mode=view_mode)

    def _matching_command(self, request_digest: str) -> int | None:
        for ordinal in reversed(self._ordinals("command")):
            command = self._load_event(ordinal, "command")
            if command.get("request_digest") == request_digest:
                return ordinal
        return None

    def run(
        self,
        *,
        step: str,
        argv: Sequence[str],
        cwd: Path,
        classification: str,
        runner: Callable[[], dict[str, object]],
        replay_safe: bool = False,
        effect_verifier: Callable[[], bool | None] | None = None,
        retry_failed: bool = False,
        lock_held: bool = False,
        reuse_completed: bool = False,
        verify_completed_effect: bool = False,
        legacy_prefixes: dict[str, bytes] | None = None,
    ) -> dict[str, Any]:
        request = {
            "task_id": self.task_id,
            "step": step,
            "argv": list(argv),
            "cwd": str(cwd.resolve()),
            "classification": classification,
            "replay_safe": replay_safe,
        }
        request_digest = _canonical_digest(request)
        lease = (
            nullcontext()
            if lock_held
            else self.lease(owner=f"event:{os.getpid()}", wait_timeout=2.0)
        )
        with lease:
            self._ensure_events_directory(create=True)
            self._reconcile_linked_event_staging_aliases()
            recover_completed_effect = False
            ordinal = self._matching_command(request_digest)
            if ordinal is not None:
                result_path = self._path(ordinal, "result")
                if result_path.exists():
                    result = self._load_event(ordinal, "result")
                    if reuse_completed and not (retry_failed and result.get("rc") != 0):
                        first_incomplete = self.first_incomplete()
                        if first_incomplete is not None:
                            raise TaskctlError(
                                "OUTCOME_UNKNOWN: command ordinal "
                                f"{first_incomplete} has no result"
                            )
                        if verify_completed_effect:
                            if effect_verifier is None:
                                raise TaskctlError(
                                    "completed effect verification is unavailable"
                                )
                            completed_effect = effect_verifier()
                            if completed_effect is None:
                                raise TaskctlError(
                                    "OUTCOME_UNKNOWN: completed effect cannot be verified"
                                )
                            if completed_effect:
                                self.rebuild_views()
                                return result
                            ordinal = None
                        else:
                            self.rebuild_views()
                            return result
                    else:
                        if (
                            retry_failed
                            and result.get("rc") != 0
                            and verify_completed_effect
                        ):
                            if effect_verifier is None:
                                raise TaskctlError(
                                    "failed effect verification is unavailable"
                                )
                            failed_effect = effect_verifier()
                            if failed_effect is None:
                                raise TaskctlError(
                                    "OUTCOME_UNKNOWN: failed effect cannot be verified"
                                )
                            recover_completed_effect = failed_effect
                        ordinal = None
                else:
                    first_incomplete = self.first_incomplete()
                    if first_incomplete != ordinal:
                        raise TaskctlError(
                            "OUTCOME_UNKNOWN: an earlier command has no result: "
                            f"{first_incomplete}"
                        )
                    if not replay_safe or effect_verifier is None:
                        raise TaskctlError(
                            f"OUTCOME_UNKNOWN: command ordinal {ordinal} has no result"
                        )
                    effect = effect_verifier()
                    if effect is None:
                        raise TaskctlError(
                            f"OUTCOME_UNKNOWN: effect for ordinal {ordinal} is unknown"
                        )
                    if effect:
                        recovered = {
                            "schema_version": 2,
                            "task_id": self.task_id,
                            "ordinal": ordinal,
                            "step": step,
                            "rc": 0,
                            "executed": True,
                            "recovered": "effect_present",
                            "completed_ns": time.time_ns(),
                        }
                        atomic_create(
                            result_path,
                            canonical_json(recovered),
                            fault=self._event_fault("result"),
                        )
                        self.rebuild_views()
                        return recovered

            if ordinal is None:
                first_incomplete = self.first_incomplete()
                if first_incomplete is not None:
                    raise TaskctlError(
                        "OUTCOME_UNKNOWN: command ordinal "
                        f"{first_incomplete} has no result"
                    )
                ordinal = max(self._ordinals("command") + [0]) + 1
                _fault(self.fault, "after_ordinal_reservation")
                command = {
                    "schema_version": 2,
                    "ordinal": ordinal,
                    "pid": os.getpid(),
                    "request_digest": request_digest,
                    "started_ns": time.time_ns(),
                    **request,
                }
                atomic_create(
                    self._path(ordinal, "command"),
                    canonical_json(command),
                    fault=self._event_fault("command"),
                )

            if legacy_prefixes is not None:
                self.adopt_legacy_views(legacy_prefixes)
            self.rebuild_views()

            if recover_completed_effect:
                recovered = {
                    "schema_version": 2,
                    "task_id": self.task_id,
                    "ordinal": ordinal,
                    "step": step,
                    "rc": 0,
                    "executed": False,
                    "recovered": "effect_present_after_failed_result",
                    "completed_ns": time.time_ns(),
                }
                atomic_create(
                    self._path(ordinal, "result"),
                    canonical_json(recovered),
                    fault=self._event_fault("result"),
                )
                self.rebuild_views()
                return recovered

            process_marker = self.artifact / "process" / f"{ordinal:08d}.json"
            atomic_write(
                process_marker,
                canonical_json(
                    {
                        "ordinal": ordinal,
                        "pid": os.getpid(),
                        "request_digest": request_digest,
                    }
                ),
            )
            try:
                try:
                    raw_result = runner()
                except PostEffectCrash:
                    raise
                except OSError as exc:
                    raw_result = {
                        "rc": 127 if exc.errno == errno.ENOENT else 1,
                        "executed": False,
                        "error": str(exc),
                    }
            finally:
                process_marker.unlink(missing_ok=True)
            if not isinstance(raw_result, dict):
                raise TaskctlError("runner result must be an object")
            reserved_result_fields = {
                "schema_version",
                "task_id",
                "ordinal",
                "step",
                "completed_ns",
            }
            if reserved_result_fields & set(raw_result):
                raise TaskctlError("runner result contains reserved authority fields")
            result = {
                "schema_version": 2,
                "task_id": self.task_id,
                "ordinal": ordinal,
                "step": step,
                "completed_ns": time.time_ns(),
                **raw_result,
            }
            rc = result.get("rc")
            if type(rc) is not int:
                raise TaskctlError("runner result rc must be an integer")
            atomic_create(
                self._path(ordinal, "result"),
                canonical_json(result),
                fault=self._event_fault("result"),
            )
            self.rebuild_views()
            return result

    def first_incomplete(self) -> int | None:
        commands = self._ordinals("command")
        results = self._ordinals("result")
        orphaned = sorted(set(results) - set(commands))
        if orphaned:
            raise TaskctlError(f"orphan result event at ordinal {orphaned[0]}")
        if results not in (commands, commands[:-1]):
            raise TaskctlError("append-only command/result sequence is inconsistent")
        for ordinal in commands:
            self._load_event(ordinal, "command")
            if not self._path(ordinal, "result").is_file():
                return ordinal
            self._load_event(ordinal, "result")
        return None

    def latest_result(self, step: str) -> tuple[dict[str, Any], Path]:
        matches: list[tuple[int, dict[str, Any], Path]] = []
        for ordinal in self._ordinals("result"):
            path = self._path(ordinal, "result")
            result = self._load_event(ordinal, "result")
            if result.get("step") == step:
                matches.append((ordinal, result, path))
        if not matches:
            raise TaskctlError(f"missing v2 result for required step {step}")
        _, result, path = matches[-1]
        return result, path

    def supersede_incomplete_internal(self, ordinal: int, *, reason: str) -> None:
        if self.first_incomplete() != ordinal:
            raise TaskctlError("internal supersede target is not first incomplete")
        command = self._load_event(ordinal, "command")
        if (
            command.get("classification") != "INTERNAL"
            or command.get("replay_safe") is not True
            or self._path(ordinal, "result").exists()
        ):
            raise TaskctlError(
                "only a replay-safe incomplete internal may be superseded"
            )
        result = {
            "schema_version": 2,
            "task_id": self.task_id,
            "ordinal": ordinal,
            "step": command["step"],
            "rc": 125,
            "executed": False,
            "reason": reason,
            "completed_ns": time.time_ns(),
        }
        atomic_create(
            self._path(ordinal, "result"),
            canonical_json(result),
            fault=self._event_fault("result"),
        )
        self.rebuild_views()


@dataclass(frozen=True)
class TaskContract:
    task_id: str
    status: str
    risk_tier: str
    closure_tags: tuple[str, ...]
    task_path: str
    allowlist: tuple[str, ...]


def _safe_relative(value: str, label: str) -> str:
    if not value or "\x00" in value or "\\" in value:
        raise TaskctlError(f"unsafe {label}: {value!r}")
    path = PurePosixPath(value)
    if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
        raise TaskctlError(f"unsafe {label}: {value!r}")
    normalized = path.as_posix()
    if normalized != value:
        raise TaskctlError(f"non-canonical {label}: {value!r}")
    return normalized


def _safe_glob(value: str, label: str) -> str:
    relative = _safe_relative(value, label)
    if any(character in relative for character in "?[]{}") or "***" in relative:
        raise TaskctlError(f"unsupported {label}: {value!r}")
    return relative


def _section(text: str, heading: str) -> str:
    marker = f"## {heading}"
    lines = text.splitlines()
    matches = [index for index, line in enumerate(lines) if line == marker]
    if len(matches) != 1:
        raise TaskctlError(f"task must contain exactly one {marker}")
    start = matches[0] + 1
    end = next(
        (
            index
            for index in range(start, len(lines))
            if re.match(r" {0,3}##(?:[ \t]+|$)", lines[index])
        ),
        len(lines),
    )
    return "\n".join(lines[start:end])


def _repo_file_path(path: Path, repo_root: Path, label: str) -> tuple[Path, str]:
    root = repo_root.resolve()
    candidate = path if path.is_absolute() else repo_root / path
    if ".." in candidate.parts:
        raise TaskctlError(f"unsafe {label}: parent traversal")
    try:
        relative_path = candidate.relative_to(repo_root)
    except ValueError as exc:
        raise TaskctlError(f"{label} is outside repository") from exc
    current = root
    for part in relative_path.parts:
        current = current / part
        if current.is_symlink():
            raise TaskctlError(f"{label} contains a symlink")
    if not current.is_file():
        raise TaskctlError(f"{label} is missing or not a regular file")
    return current, relative_path.as_posix()


def parse_task_contract(path: Path, task_id: str, repo_root: Path) -> TaskContract:
    if not TASK_ID_PATTERN.fullmatch(task_id):
        raise TaskctlError("invalid task id")
    canonical_path, relative = _repo_file_path(path, repo_root, "task file")
    try:
        text = canonical_path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        raise TaskctlError(f"cannot read task contract: {exc}") from exc
    if not text.startswith(f"# {task_id}\n"):
        raise TaskctlError("task heading does not match task id")
    lines = text.splitlines()
    metadata_end = next(
        (
            index
            for index, line in enumerate(lines)
            if re.match(r" {0,3}##(?:[ \t]+|$)", line)
        ),
        len(lines),
    )
    metadata = "\n".join(lines[:metadata_end])
    values: dict[str, list[str]] = {
        "Risk-Tier": [],
        "Closure-Tags": [],
        "Task-Path": [],
    }
    for line in metadata.splitlines():
        for name in values:
            if line.startswith(f"{name}:"):
                values[name].append(line.split(":", 1)[1].strip())
    for name, observed in values.items():
        if len(observed) != 1:
            raise TaskctlError(
                f"{name} must appear exactly once in the first metadata block"
            )
        if sum(line.startswith(f"{name}:") for line in text.splitlines()) != 1:
            raise TaskctlError(f"{name} must not be repeated outside metadata")

    statuses = [
        line.removeprefix("Status:").strip()
        for line in metadata.splitlines()
        if line.startswith("Status:")
    ]
    if len(statuses) != 1 or not statuses[0]:
        raise TaskctlError("first metadata block requires one Status")
    if sum(line.startswith("Status:") for line in text.splitlines()) != 1:
        raise TaskctlError("Status must not be repeated outside metadata")
    risk = values["Risk-Tier"][0]
    if risk not in {"LOW", "MEDIUM", "HIGH"}:
        raise TaskctlError("Risk-Tier must be LOW, MEDIUM, or HIGH")
    try:
        raw_tags = json.loads(values["Closure-Tags"][0])
    except json.JSONDecodeError as exc:
        raise TaskctlError("Closure-Tags must be RFC 8259 JSON") from exc
    if (
        not isinstance(raw_tags, list)
        or not raw_tags
        or not all(isinstance(tag, str) for tag in raw_tags)
        or raw_tags != sorted(set(raw_tags))
        or any(not TAG_PATTERN.fullmatch(tag) for tag in raw_tags)
    ):
        raise TaskctlError("Closure-Tags must be sorted unique lowercase tags")
    declared_path = _safe_relative(values["Task-Path"][0], "Task-Path")
    if declared_path != relative:
        raise TaskctlError("Task-Path does not match task file")

    allowed_section = _section(text, "Allowed Files")
    entries: list[str] = []
    for line in allowed_section.splitlines():
        match = re.fullmatch(r"- `([^`]+)`", line.strip())
        if not match:
            continue
        entry = _safe_glob(match.group(1), "allowlist path")
        own_artifact = f"artifacts/{task_id}"
        if entry == own_artifact or entry.startswith(own_artifact + "/"):
            continue
        entries.append(entry)
    if not entries or len(entries) != len(set(entries)):
        raise TaskctlError("Allowed Files must be non-empty and unique")
    if declared_path not in entries:
        raise TaskctlError("Allowed Files must include the task path")
    return TaskContract(
        task_id=task_id,
        status=statuses[0],
        risk_tier=risk,
        closure_tags=tuple(raw_tags),
        task_path=declared_path,
        allowlist=tuple(entries),
    )


def _unwrap_env(argv: Sequence[str]) -> list[str]:
    values = list(argv)
    if not values:
        raise TaskctlError("command argv must not be empty")
    if Path(values[0]).name != "env":
        return values
    index = 1
    while (
        index < len(values)
        and "=" in values[index]
        and not values[index].startswith("=")
    ):
        name = values[index].split("=", 1)[0]
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise TaskctlError("invalid env assignment")
        index += 1
    if index == len(values):
        raise TaskctlError("env wrapper has no command")
    return values[index:]


def classify_record(task_id: str, step: str, argv: Sequence[str]) -> str:
    raw_values = list(argv)
    if not raw_values:
        raise TaskctlError("command argv must not be empty")
    if task_id == GVR3_ID:
        reserved = GVR3_REQUIRED_COMMANDS.get(step)
        if reserved is not None:
            expected, classification = reserved
            if raw_values != list(expected):
                raise TaskctlError(
                    f"GVR-3 {step} evidence requires the exact frozen argv"
                )
            return classification
    if Path(raw_values[0]).name == "env":
        raise TaskctlError("env-wrapped generic command is UNKNOWN")
    values = raw_values if step in {"scope", "frozen_v1"} else _unwrap_env(raw_values)
    executable = Path(values[0]).name
    lowered = [value.lower() for value in values]
    if executable in {"sh", "bash", "zsh"} and any(
        value in {"-c", "-lc"} for value in values[1:]
    ):
        raise TaskctlError("shell-wrapped controlled command is UNKNOWN")
    if any("pytest" in value for value in lowered):
        raise TaskctlError("backend pytest requires backend-test and SQLite lease")
    if any(
        token in {"alembic", "migrate", "migration", "makemigrations"}
        for token in lowered
    ):
        raise TaskctlError("migration command requires its dedicated serialized gate")
    if any(Path(value).name == "taskctl" for value in values) and "close" in lowered:
        raise TaskctlError("taskctl close cannot run through generic record")
    canonical_scope = ["python3", "scripts/evidence_scope.py", "finalize", task_id]
    if step == "scope":
        if values != canonical_scope:
            raise TaskctlError("scope evidence requires the exact canonical argv")
        return "SCOPE"
    if values == canonical_scope:
        raise TaskctlError("canonical scope argv requires step scope")
    canonical_frozen_v1 = [
        "python3",
        "scripts/frozen_v1_acceptance.py",
        "--task-id",
        task_id,
        "--frozen-root",
        f"artifacts/{task_id}/bootstrap/frozen-v1",
        "--candidate-root",
        f"artifacts/{task_id}/candidate",
    ]
    if step == "frozen_v1":
        if values != canonical_frozen_v1:
            raise TaskctlError("frozen_v1 evidence requires the exact canonical argv")
        return "FROZEN_V1"
    if values[0] != executable:
        raise TaskctlError("path-qualified generic executable is UNKNOWN")
    if executable == "bash" and len(values) >= 3 and values[1] == "-n":
        return "NON_SQLITE"
    if executable == "git" and (
        len(values) >= 2
        and values[1] in {"diff", "ls-files", "rev-parse", "status"}
        and not any(
            value in {"-o", "--ext-diff", "--textconv"} or value.startswith("--output")
            for value in values[2:]
        )
    ):
        return "NON_SQLITE"
    if executable == "ruff":
        if (
            len(values) >= 2
            and values[1] == "check"
            and not any(
                value == "--fix"
                or value.startswith("--fix=")
                or value == "--unsafe-fixes"
                for value in values[2:]
            )
        ):
            return "NON_SQLITE"
        if len(values) >= 3 and values[1] == "format" and "--check" in values[2:]:
            return "NON_SQLITE"
    if executable == "shasum" and len(values) >= 4 and values[1:3] == ["-a", "256"]:
        return "NON_SQLITE"
    if executable in {"tsc", "vue-tsc"} and "--noEmit" in values[1:]:
        return "NON_SQLITE"
    raise TaskctlError(
        "UNKNOWN command classification; use an exact check-only record argv or "
        "the dedicated serialized runner"
    )


def _sorted_unique_strings(value: object, label: str) -> list[str]:
    if (
        not isinstance(value, list)
        or not value
        or not all(isinstance(item, str) for item in value)
        or value != sorted(set(value))
    ):
        raise TaskctlError(f"{label} must be a sorted unique non-empty string array")
    return value


def _safe_module_path(repo_root: Path, raw_path: object) -> str:
    if not isinstance(raw_path, str) or any(
        character in raw_path for character in "*?[]{}"
    ):
        raise TaskctlError("manifest module path must be a concrete string")
    relative = _safe_relative(raw_path, "module path")
    current = repo_root
    for part in PurePosixPath(relative).parts:
        current = current / part
        if current.is_symlink():
            raise TaskctlError(f"symlink governance module path: {relative}")
    if not current.is_file():
        raise TaskctlError(f"missing governance module: {relative}")
    return relative


def _validate_manifest(manifest: dict[str, Any], repo_root: Path) -> None:
    required = {
        "schema_version",
        "active_version",
        "adapter_version",
        "activation_task",
        "required_closure_tags",
        "rule_owners",
        "modules",
    }
    if set(manifest) != required or manifest.get("schema_version") != 2:
        raise TaskctlError("invalid governance manifest schema")
    active_version = manifest.get("active_version")
    if (
        not isinstance(active_version, str)
        or re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", active_version) is None
        or active_version != manifest.get("adapter_version")
    ):
        raise TaskctlError("governance/adapter version mismatch")
    activation_task = manifest.get("activation_task")
    if not isinstance(activation_task, str) or not TASK_ID_PATTERN.fullmatch(
        activation_task
    ):
        raise TaskctlError("manifest activation_task is required")
    required_tags = _sorted_unique_strings(
        manifest.get("required_closure_tags"), "required_closure_tags"
    )
    if any(not TAG_PATTERN.fullmatch(tag) for tag in required_tags):
        raise TaskctlError("required_closure_tags contains an invalid tag")
    owners = manifest.get("rule_owners")
    if not isinstance(owners, dict) or not owners:
        raise TaskctlError("manifest rule_owners must be a non-empty object")
    for rule_id, owner in owners.items():
        if not isinstance(rule_id, str) or not RULE_ID_PATTERN.fullmatch(rule_id):
            raise TaskctlError("manifest contains an invalid rule owner ID")
        if owner != "AGENTS.md":
            _safe_module_path(repo_root, owner)
    modules = manifest.get("modules")
    if not isinstance(modules, list) or not modules:
        raise TaskctlError("manifest modules must be a non-empty array")
    seen: set[str] = set()
    for module in modules:
        if not isinstance(module, dict) or set(module) != {
            "path",
            "always",
            "selectors",
        }:
            raise TaskctlError("invalid manifest module")
        relative = _safe_module_path(repo_root, module["path"])
        if relative in seen:
            raise TaskctlError("duplicate manifest module")
        seen.add(relative)
        always = module["always"]
        selectors = module["selectors"]
        if not isinstance(always, bool) or not isinstance(selectors, list):
            raise TaskctlError("invalid module selector configuration")
        if always and selectors:
            raise TaskctlError("always module cannot contain selectors")
        if not always and not selectors:
            raise TaskctlError("conditional module requires selectors")
        for selector in selectors:
            if not isinstance(selector, dict) or not selector:
                raise TaskctlError("selector must be a non-empty object")
            if not set(selector) <= {"risk_any", "closure_tag_any", "task_path_any"}:
                raise TaskctlError("unknown selector field")
            for field, raw_values in selector.items():
                values = _sorted_unique_strings(raw_values, field)
                if field == "risk_any" and any(
                    value not in {"LOW", "MEDIUM", "HIGH"} for value in values
                ):
                    raise TaskctlError("selector risk_any contains an invalid risk")
                if field == "closure_tag_any" and any(
                    not TAG_PATTERN.fullmatch(value) for value in values
                ):
                    raise TaskctlError("selector contains an invalid closure tag")
                if field == "task_path_any":
                    for value in values:
                        _safe_glob(value, "task path glob")
    routed_tags = {
        value
        for module in modules
        for selector in module["selectors"]
        for value in selector.get("closure_tag_any", [])
    }
    missing_tags = sorted(set(required_tags) - routed_tags)
    if missing_tags:
        raise TaskctlError(
            f"required closure tag has no module route: {missing_tags[0]}"
        )
    actual_modules = {
        path.relative_to(repo_root).as_posix()
        for path in (repo_root / "docs/agents").glob("*.md")
        if path.is_file() or path.is_symlink()
    }
    undeclared = sorted(actual_modules - seen)
    if undeclared:
        raise TaskctlError(f"undeclared governance module: {undeclared[0]}")


def _glob_matches(path: str, pattern: str) -> bool:
    sentinel = "\0DOUBLESTAR\0"
    expression = re.escape(pattern).replace(r"\*\*", sentinel).replace(r"\*", "[^/]*")
    expression = expression.replace(sentinel, ".*")
    return re.fullmatch(expression, path) is not None


def select_modules(manifest: dict[str, Any], contract: TaskContract) -> list[str]:
    selected: list[str] = []
    for module in manifest["modules"]:
        matched = module["always"]
        for selector in module["selectors"]:
            fields: list[bool] = []
            if "risk_any" in selector:
                fields.append(contract.risk_tier in selector["risk_any"])
            if "closure_tag_any" in selector:
                fields.append(
                    bool(set(contract.closure_tags) & set(selector["closure_tag_any"]))
                )
            if "task_path_any" in selector:
                fields.append(
                    any(
                        _glob_matches(contract.task_path, item)
                        for item in selector["task_path_any"]
                    )
                )
            matched = matched or (bool(fields) and all(fields))
        if matched:
            selected.append(module["path"])
    return sorted(set(selected))


def module_selection_record(
    manifest: dict[str, Any], contract: TaskContract, governance: str
) -> dict[str, Any]:
    modules: list[dict[str, Any]] = []
    selected: list[str] = []
    for module in manifest["modules"]:
        selector_rows: list[dict[str, Any]] = []
        module_matched = module["always"]
        for selector in module["selectors"]:
            fields: dict[str, bool] = {}
            if "risk_any" in selector:
                fields["risk_any"] = contract.risk_tier in selector["risk_any"]
            if "closure_tag_any" in selector:
                fields["closure_tag_any"] = bool(
                    set(contract.closure_tags) & set(selector["closure_tag_any"])
                )
            if "task_path_any" in selector:
                fields["task_path_any"] = any(
                    _glob_matches(contract.task_path, pattern)
                    for pattern in selector["task_path_any"]
                )
            matched = bool(fields) and all(fields.values())
            module_matched = module_matched or matched
            selector_rows.append(
                {"selector": selector, "field_matches": fields, "matched": matched}
            )
        if module_matched:
            selected.append(module["path"])
        modules.append(
            {
                "path": module["path"],
                "always": module["always"],
                "selectors": selector_rows,
                "matched": module_matched,
            }
        )
    return {
        "schema_version": 1,
        "task_id": contract.task_id,
        "task_path": contract.task_path,
        "risk_tier": contract.risk_tier,
        "closure_tags": list(contract.closure_tags),
        "governance_digest": governance,
        "modules": modules,
        "selected_modules": sorted(set(selected)),
    }


def _validate_rule_owners(
    repo_root: Path, root_candidate: Path, manifest: dict[str, Any]
) -> None:
    documents: dict[str, str] = {}
    for relative, path in {
        "AGENTS.md": root_candidate,
        **{
            module["path"]: repo_root / module["path"] for module in manifest["modules"]
        },
    }.items():
        try:
            documents[relative] = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            raise TaskctlError(
                f"cannot read governance document {relative}: {exc}"
            ) from exc
    declarations: dict[str, str] = {}
    references: list[tuple[str, str]] = []
    for relative, text in documents.items():
        fence: str | None = None
        for line in text.splitlines():
            stripped = line.lstrip()
            marker = (
                "```"
                if stripped.startswith("```")
                else ("~~~" if stripped.startswith("~~~") else None)
            )
            if marker is not None:
                fence = None if fence == marker else marker
                continue
            if fence is not None:
                continue
            if line.startswith("### Rule "):
                match = RULE_DECLARATION.fullmatch(line)
                if match is None:
                    raise TaskctlError(f"invalid rule declaration in {relative}")
                rule_id = match.group(1)
                if rule_id in declarations:
                    raise TaskctlError(f"duplicate rule declaration: {rule_id}")
                declarations[rule_id] = relative
            elif line.startswith("Rule-Ref:"):
                match = RULE_REFERENCE.fullmatch(line)
                if match is None:
                    raise TaskctlError(f"invalid Rule-Ref in {relative}")
                references.append((relative, match.group(1)))
        if fence is not None:
            raise TaskctlError(f"unclosed governance fence in {relative}")
    owners = manifest["rule_owners"]
    if owners != declarations:
        raise TaskctlError("manifest rule owner inventory does not match declarations")
    undefined = sorted(
        rule_id for _path, rule_id in references if rule_id not in declarations
    )
    if undefined:
        raise TaskctlError(f"undefined governance Rule-Ref: {undefined[0]}")
    self_references = sorted(
        rule_id for path, rule_id in references if declarations.get(rule_id) == path
    )
    if self_references:
        raise TaskctlError(
            f"governance owner self-references rule: {self_references[0]}"
        )


def governance_digest(
    repo_root: Path,
    root_candidate: Path,
    manifest: dict[str, Any],
) -> tuple[str, dict[str, str]]:
    _validate_manifest(manifest, repo_root)
    _validate_rule_owners(repo_root, root_candidate, manifest)
    inputs: dict[str, str] = {"AGENTS.md": sha256_file(root_candidate)}
    inputs["docs/agents/manifest.json"] = sha256_bytes(
        json.dumps(
            manifest, ensure_ascii=False, sort_keys=True, separators=(",", ":")
        ).encode("utf-8")
    )
    for module in sorted(manifest["modules"], key=lambda item: item["path"]):
        inputs[module["path"]] = sha256_file(repo_root / module["path"])
    return _canonical_digest(inputs), inputs


def _read_jsonl(path: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as exc:
        raise TaskctlError(f"cannot read {path}: {exc}") from exc
    for number, line in enumerate(lines, 1):
        if not line.strip():
            continue
        try:
            value = json.loads(line)
        except json.JSONDecodeError as exc:
            raise TaskctlError(f"malformed JSONL {path}:{number}") from exc
        if not isinstance(value, dict):
            raise TaskctlError(f"non-object JSONL {path}:{number}")
        rows.append(value)
    return rows


def _exact_pass_status(path: Path, *, metadata_only: bool) -> bool:
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return False
    scope = text.split("\n## ", 1)[0] if metadata_only else text
    values = [
        line.removeprefix("Status:").strip()
        for line in scope.splitlines()
        if line.startswith("Status:")
    ]
    if len(values) != 1:
        return False
    if (
        metadata_only
        and sum(line.startswith("Status:") for line in text.splitlines()) != 1
    ):
        return False
    return values[0] == "PASS" or values[0].startswith("PASS /")


def _valid_reviewer_identity(value: object) -> bool:
    return (
        isinstance(value, str)
        and bool(value)
        and value == value.strip()
        and value.casefold() != "none"
        and all(ord(character) >= 32 and ord(character) != 127 for character in value)
    )


def legacy_task_pass(repo_root: Path, task_id: str) -> bool:
    artifact = repo_root / "artifacts" / task_id
    metadata_path = artifact / "task.json"
    if not metadata_path.is_file():
        return False
    try:
        metadata = load_json(metadata_path, "legacy task metadata")
        if metadata.get("task_id") != task_id:
            return False
        task_value = metadata.get("task_file")
        declared_root = metadata.get("repo_root")
        if (
            not isinstance(task_value, str)
            or not task_value
            or not isinstance(declared_root, str)
            or not declared_root
            or not Path(declared_root).is_absolute()
        ):
            return False
        task_relative = _safe_relative(task_value, "legacy task path")
        task_file, canonical_task_relative = _repo_file_path(
            repo_root / task_relative, repo_root, "legacy task file"
        )
        if canonical_task_relative != task_relative:
            return False
        contract = parse_task_contract(task_file, task_id, repo_root)
        if (
            contract.task_path != task_relative
            or metadata.get("allowlist") != list(contract.allowlist)
            or Path(declared_root).resolve() != repo_root.resolve()
        ):
            return False
        if not _exact_pass_status(task_file, metadata_only=True):
            return False
        if not _exact_pass_status(artifact / "summary.md", metadata_only=False):
            return False
        checksum_file, _ = _repo_file_path(
            artifact / "review/candidate.sha256",
            repo_root,
            "legacy candidate checksum",
        )
        checksum_lines = checksum_file.read_text(encoding="utf-8").splitlines()
        if len(checksum_lines) != 3:
            return False
        expected_checksum_paths = [
            task_relative,
            f"artifacts/{task_id}/summary.md",
            f"artifacts/{task_id}/git/diff.patch",
        ]
        observed_checksum_paths: list[str] = []
        observed_checksum_hashes: list[str] = []
        for line, expected_path in zip(
            checksum_lines, expected_checksum_paths, strict=True
        ):
            match = re.fullmatch(r"([0-9a-f]{64})  (.+)", line)
            if match is None:
                return False
            relative = _safe_relative(match.group(2), "review checksum path")
            if relative != expected_path:
                return False
            reviewed_path, _ = _repo_file_path(
                repo_root / relative, repo_root, "review checksum file"
            )
            if sha256_file(reviewed_path) != match.group(1):
                return False
            observed_checksum_hashes.append(match.group(1))
            observed_checksum_paths.append(relative)
        if observed_checksum_paths != expected_checksum_paths:
            return False
        review, _ = _repo_file_path(
            artifact / "review/independent_review.md",
            repo_root,
            "legacy independent review",
        )
        review_fields = _parse_fields(
            review,
            (
                "Reviewed-Task-SHA256",
                "Reviewed-Summary-SHA256",
                "Reviewed-Patch-SHA256",
                "Reviewer-ID",
                "Verdict",
                "P0",
                "P1",
                "P2",
            ),
        )
        if (
            [
                review_fields["Reviewed-Task-SHA256"],
                review_fields["Reviewed-Summary-SHA256"],
                review_fields["Reviewed-Patch-SHA256"],
            ]
            != observed_checksum_hashes
            or not _valid_reviewer_identity(review_fields["Reviewer-ID"])
            or review_fields["Verdict"] != "APPROVED"
            or any(review_fields[level] != "0" for level in ("P0", "P1", "P2"))
        ):
            return False
        result_rows = _read_jsonl(artifact / "results.jsonl")
        latest: dict[str, tuple[int, dict[str, Any]]] = {}
        for index, row in enumerate(result_rows):
            if isinstance(row.get("step"), str):
                latest[row["step"]] = (index, row)

        def valid_result_log(row: dict[str, Any], step: str) -> bool:
            log = row.get("log")
            if (
                type(row.get("rc")) is not int
                or row["rc"] != 0
                or not isinstance(log, str)
            ):
                return False
            log_relative = _safe_relative(log, f"legacy {step} log")
            if not log_relative.startswith(f"artifacts/{task_id}/outputs/"):
                return False
            log_path, _ = _repo_file_path(
                repo_root / log_relative, repo_root, f"legacy {step} log"
            )
            return log_path.is_file()

        for step in (
            "lint",
            "test",
            "scope",
            "review_binding",
            "independent_review",
            "task_gate",
            "atomic_evidence",
        ):
            indexed = latest.get(step)
            if indexed is None or not valid_result_log(indexed[1], step):
                return False

        if task_id in {GVR1_ID, GVR2_ID}:
            lint_index = latest["lint"][0]
            test_index = latest["test"][0]
            scope_index = latest["scope"][0]
            independent_index = latest["independent_review"][0]
            task_gate_index = latest["task_gate"][0]
            atomic_index = latest["atomic_evidence"][0]
            final_binding_index = latest["review_binding"][0]
            if not (
                scope_index
                < independent_index
                < task_gate_index
                < atomic_index
                < final_binding_index
            ):
                return False
            preclose_bindings = [
                (index, row)
                for index, row in enumerate(result_rows)
                if row.get("step") == "review_binding"
                and max(lint_index, test_index) < index < scope_index
                and valid_result_log(row, "review_binding")
            ]
            if not preclose_bindings:
                return False
        import importlib.util

        scope_path = repo_root / "scripts/evidence_scope.py"
        spec = importlib.util.spec_from_file_location(
            f"fpms_scope_verify_{task_id}", scope_path
        )
        if spec is None or spec.loader is None:
            return False
        scope = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(scope)
        live_patch = scope.build_patch(task_id, root=repo_root, check_external=False)
        if live_patch != (artifact / "git/diff.patch").read_bytes():
            return False
    except (KeyError, OSError, UnicodeError, TaskctlError, RuntimeError):
        return False
    return True


REVIEW_FIELDS = (
    "Reviewed-Candidate-Fingerprint",
    "Reviewed-Patch-SHA256",
    "Reviewed-Governance-Digest",
    "Reviewer-ID",
    "Verdict",
    "P0",
    "P1",
    "P2",
)


def _parse_fields_text(text: str, fields: Iterable[str]) -> dict[str, str]:
    expected = tuple(fields)
    found: dict[str, list[str]] = {field: [] for field in expected}
    lines = text.splitlines()
    if any("CHANGES_REQUESTED" in raw_line for raw_line in lines):
        raise TaskctlError("approval/report contains CHANGES_REQUESTED")
    for raw_line in lines:
        line = raw_line.strip()
        for field in expected:
            prefix = f"{field}:"
            if line.startswith(prefix):
                found[field].append(line[len(prefix) :].strip())
    if any(len(values) != 1 for values in found.values()):
        raise TaskctlError("approval/report fields must each appear exactly once")
    return {field: values[0] for field, values in found.items()}


def _parse_fields(path: Path, fields: Iterable[str]) -> dict[str, str]:
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        raise TaskctlError(f"cannot read approval/report: {exc}") from exc
    return _parse_fields_text(text, fields)


def validate_review(
    path: Path,
    candidate: dict[str, Any],
    *,
    expected_reviewer: str,
    implementer: str,
    used_reviewers: set[str],
) -> dict[str, str]:
    fields = _parse_fields(path, REVIEW_FIELDS)
    triple = {
        "Reviewed-Candidate-Fingerprint": candidate.get("fingerprint"),
        "Reviewed-Patch-SHA256": candidate.get("patch_sha256"),
        "Reviewed-Governance-Digest": candidate.get("governance_digest"),
    }
    if any(
        not isinstance(value, str) or not HEX_PATTERN.fullmatch(value)
        for value in triple.values()
    ):
        raise TaskctlError("candidate triple is invalid")
    for field, expected in triple.items():
        if fields[field] != expected:
            raise TaskctlError(f"stale review {field}")
    reviewer = fields["Reviewer-ID"]
    if (
        not _valid_reviewer_identity(reviewer)
        or reviewer != expected_reviewer
        or reviewer == implementer
        or reviewer in used_reviewers
    ):
        raise TaskctlError("reviewer identity is not independent or lease-bound")
    if fields["Verdict"] != "APPROVED":
        raise TaskctlError("review verdict must be APPROVED")
    if any(fields[level] != "0" for level in ("P0", "P1", "P2")):
        raise TaskctlError("review findings must be numeric zero")
    return fields


class TaskController:
    """One task-local controller; all state transitions are fail closed."""

    def __init__(
        self,
        repo_root: Path,
        task_id: str,
        *,
        actor: str,
        implementer: str,
        fault: Fault | None = None,
    ) -> None:
        if not TASK_ID_PATTERN.fullmatch(task_id):
            raise TaskctlError("invalid task id")
        if not _valid_reviewer_identity(actor) or not _valid_reviewer_identity(
            implementer
        ):
            raise TaskctlError(
                "actor and implementer identities must be canonical durable identities"
            )
        self.repo_root = repo_root.resolve()
        self.task_id = task_id
        self.actor = actor
        self.implementer = implementer
        self.artifact = self.repo_root / "artifacts" / task_id
        self.state_path = self.artifact / "state.json"
        self.fault = fault
        self.events = EventStore(self.artifact, task_id)

    def _transition(
        self,
        action: str,
        argv: Sequence[str],
        effect: Callable[[], None],
        effect_verifier: Callable[[], bool | None],
        *,
        lock_held: bool = False,
        legacy_prefixes: dict[str, bytes] | None = None,
    ) -> dict[str, Any]:
        def runner() -> dict[str, object]:
            effect()
            return {"rc": 0, "executed": True}

        result = self.events.run(
            step=f"taskctl_{action}",
            argv=argv,
            cwd=self.repo_root,
            classification="INTERNAL",
            runner=runner,
            replay_safe=True,
            effect_verifier=effect_verifier,
            retry_failed=True,
            lock_held=lock_held,
            reuse_completed=True,
            verify_completed_effect=True,
            legacy_prefixes=legacy_prefixes,
        )
        if result.get("rc") != 0:
            raise TaskctlError(f"internal transition failed: {action}")
        return self._state()

    def _assert_start_request(self, parameters: Sequence[str]) -> None:
        for ordinal in self.events._ordinals("command"):
            command = self.events._load_event(ordinal, "command")
            if command.get("step") == "taskctl_start" and command.get("argv") != list(
                parameters
            ):
                raise TaskctlError("start ownership or immutable inputs changed")

    def _ordinary_start_parameters(
        self,
        contract: TaskContract,
        governance_digest_value: str,
        selection_sha256: str,
        baseline_allowlist_sha256: str,
        baseline_external_sha256: str,
        *,
        legacy_prefixes: dict[str, bytes] | None,
        legacy_bundle_sha256: str | None,
    ) -> list[str]:
        parameters = [
            "start",
            "--task-file",
            contract.task_path,
            "--controller",
            self.actor,
            "--implementer",
            self.implementer,
            "--mode",
            "legacy-adopt" if legacy_prefixes is not None else "v2-new",
            "--governance-digest",
            governance_digest_value,
            "--module-selection-sha256",
            selection_sha256,
            "--baseline-allowlist-sha256",
            baseline_allowlist_sha256,
            "--baseline-external-sha256",
            baseline_external_sha256,
        ]
        if legacy_prefixes is not None:
            if legacy_bundle_sha256 is None:
                raise TaskctlError("legacy start has no bundle hash")
            parameters.extend(
                [
                    "--legacy-commands-length",
                    str(len(legacy_prefixes["command"])),
                    "--legacy-commands-sha256",
                    sha256_bytes(legacy_prefixes["command"]),
                    "--legacy-results-length",
                    str(len(legacy_prefixes["result"])),
                    "--legacy-results-sha256",
                    sha256_bytes(legacy_prefixes["result"]),
                    "--legacy-bundle-sha256",
                    legacy_bundle_sha256,
                ]
            )
        return parameters

    def _state(self) -> dict[str, Any]:
        return load_json(self.state_path, "taskctl state")

    def _write_state(self, state: dict[str, Any]) -> None:
        self.events.ensure_authority_chain(create=False)
        state["updated_ns"] = time.time_ns()
        atomic_write(self.state_path, canonical_json(state))

    def _cas_write_state(
        self,
        state: dict[str, Any],
        expected_sha256: str | None,
        *,
        lock_held: bool = False,
    ) -> None:
        def compare_and_write() -> None:
            if expected_sha256 is None:
                if self.state_path.exists():
                    raise TaskctlError("state CAS failed: state appeared concurrently")
            elif (
                not self.state_path.is_file()
                or sha256_file(self.state_path) != expected_sha256
            ):
                raise TaskctlError("state CAS failed: state changed concurrently")
            self._write_state(state)

        if lock_held:
            compare_and_write()
            return
        with self.events.lease(
            owner=f"state-cas:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            compare_and_write()

    def _contract(self, task_file: Path | None = None) -> TaskContract:
        if task_file is None:
            metadata = load_json(self.artifact / "task.json", "task metadata")
            task_file = self.repo_root / str(metadata.get("task_file", ""))
        return parse_task_contract(task_file, self.task_id, self.repo_root)

    def _assert_metadata(self, contract: TaskContract) -> dict[str, Any]:
        metadata = load_json(self.artifact / "task.json", "task metadata")
        if metadata.get("task_id") != self.task_id:
            raise TaskctlError("task.json task_id mismatch")
        if metadata.get("task_file") != contract.task_path:
            raise TaskctlError("task.json task_file mismatch")
        if metadata.get("allowlist") != list(contract.allowlist):
            raise TaskctlError("task.json allowlist does not match task contract")
        declared_root = metadata.get("repo_root")
        if (
            not isinstance(declared_root, str)
            or not declared_root
            or not Path(declared_root).is_absolute()
            or Path(declared_root).resolve() != self.repo_root
        ):
            raise TaskctlError("task.json repo_root mismatch")
        return metadata

    def _governance_change_content(
        self, state: dict[str, Any]
    ) -> tuple[dict[str, Any], bytes]:
        change = state.get("governance_change")
        if not isinstance(change, dict):
            raise TaskctlError("governance change record is missing")
        material = dict(change)
        recorded_digest = material.pop("change_sha256", None)
        if (
            not isinstance(recorded_digest, str)
            or not HEX_PATTERN.fullmatch(recorded_digest)
            or _canonical_digest(material) != recorded_digest
        ):
            raise TaskctlError("governance change digest is invalid")
        return change, canonical_json(change)

    def _validated_governance_change(self, state: dict[str, Any]) -> dict[str, Any]:
        change, content = self._governance_change_content(state)
        change_path = self.artifact / "governance_change.json"
        try:
            change_info = change_path.lstat()
        except FileNotFoundError as exc:
            raise TaskctlError("governance change report is missing") from exc
        if not stat.S_ISREG(change_info.st_mode) or change_path.read_bytes() != content:
            raise TaskctlError("governance change report differs from state")
        return change

    def _complete_pending_governance_change_report(
        self, state: dict[str, Any], *, lock_held: bool
    ) -> bool:
        pending = state.get("governance_change_report_pending")
        if pending is None:
            return False
        if (
            not isinstance(pending, str)
            or not HEX_PATTERN.fullmatch(pending)
            or state.get("state") != "BLOCKED"
            or state.get("reason") != "GOVERNANCE_DIGEST_MISMATCH"
            or state.get("governance_adoption") is not None
        ):
            raise TaskctlError("pending governance change report binding is invalid")
        _change, content = self._governance_change_content(state)
        if sha256_bytes(content) != pending:
            raise TaskctlError("pending governance change report hash is invalid")
        predecessor = state.get("governance_change_predecessor_report_sha256")
        if predecessor is not None and (
            not isinstance(predecessor, str) or not HEX_PATTERN.fullmatch(predecessor)
        ):
            raise TaskctlError("pending governance predecessor report hash is invalid")
        change_path = self.artifact / "governance_change.json"
        try:
            report_info = change_path.lstat()
        except FileNotFoundError:
            if predecessor is not None:
                raise TaskctlError("pending governance predecessor report is missing")
        else:
            if not stat.S_ISREG(report_info.st_mode):
                raise TaskctlError("pending governance report is not regular")
            report_bytes = change_path.read_bytes()
            report_sha256 = sha256_bytes(report_bytes)
            if report_sha256 not in {pending, predecessor} or (
                report_sha256 == pending and report_bytes != content
            ):
                raise TaskctlError(
                    "pending governance report differs from recoverable authority"
                )
        expected_state_hash = sha256_file(self.state_path)
        atomic_write(change_path, content)
        state.pop("governance_change_report_pending", None)
        self._cas_write_state(state, expected_state_hash, lock_held=lock_held)
        return True

    @staticmethod
    def _governance_change_argv(
        change_sha256: str,
        change_file_sha256: str,
        predecessor_report_sha256: str | None,
    ) -> list[str]:
        return [
            "governance-change",
            "--change-sha256",
            change_sha256,
            "--change-file-sha256",
            change_file_sha256,
            "--predecessor-change-file-sha256",
            predecessor_report_sha256 or "NONE",
        ]

    def _reconcile_pending_governance_change(
        self, state: dict[str, Any], *, lock_held: bool
    ) -> bool:
        pending = state.get("governance_change_report_pending")
        incomplete = self.events.first_incomplete()
        if pending is None and incomplete is None:
            return False
        if incomplete is None:
            raise TaskctlError(
                "pending governance change has no incomplete command authority"
            )
        command = self.events._load_event(incomplete, "command")
        if command.get("step") != "taskctl_governance_change":
            if pending is not None:
                raise TaskctlError(
                    "pending governance change conflicts with another command"
                )
            return False
        command_argv = command.get("argv")
        if (
            not isinstance(command_argv, list)
            or command_argv.count("--change-sha256") != 1
        ):
            raise TaskctlError("pending governance command authority is invalid")
        change_index = command_argv.index("--change-sha256")
        if change_index + 1 >= len(command_argv):
            raise TaskctlError("pending governance command authority is invalid")
        state_change = state.get("governance_change")
        state_binds_command = (
            state.get("state") == "BLOCKED"
            and state.get("reason") == "GOVERNANCE_DIGEST_MISMATCH"
            and state.get("governance_adoption") is None
            and isinstance(state_change, dict)
            and state_change.get("change_sha256") == command_argv[change_index + 1]
        )
        if pending is None and not state_binds_command:
            return False
        change, content = self._governance_change_content(state)
        change_file_sha256 = sha256_bytes(content)
        predecessor = state.get("governance_change_predecessor_report_sha256")
        if predecessor is not None and (
            not isinstance(predecessor, str) or not HEX_PATTERN.fullmatch(predecessor)
        ):
            raise TaskctlError("governance predecessor report hash is invalid")
        parameters = self._governance_change_argv(
            str(change.get("change_sha256")), change_file_sha256, predecessor
        )
        if (
            command.get("argv") != parameters
            or command.get("cwd") != str(self.repo_root)
            or command.get("classification") != "INTERNAL"
            or command.get("replay_safe") is not True
            or state.get("state") != "BLOCKED"
            or state.get("reason") != "GOVERNANCE_DIGEST_MISMATCH"
            or state.get("governance_adoption") is not None
        ):
            raise TaskctlError("pending governance command authority is invalid")

        def is_target(current: dict[str, Any]) -> bool:
            return (
                current.get("state") == "BLOCKED"
                and current.get("reason") == "GOVERNANCE_DIGEST_MISMATCH"
                and current.get("governance_change") == change
                and current.get("governance_adoption") is None
            )

        def effect() -> None:
            current = self._state()
            if not is_target(current):
                raise TaskctlError(
                    "pending governance state differs from command authority"
                )
            current_pending = current.get("governance_change_report_pending")
            if current_pending is None:
                self._validated_governance_change(current)
                return
            if current_pending != change_file_sha256:
                raise TaskctlError(
                    "pending governance change differs from command authority"
                )
            self._complete_pending_governance_change_report(
                current, lock_held=lock_held
            )

        def verifier() -> bool | None:
            current = self._state()
            if not is_target(current):
                return None
            current_pending = current.get("governance_change_report_pending")
            if current_pending == change_file_sha256:
                return False
            if current_pending is not None:
                return None
            try:
                self._validated_governance_change(current)
            except TaskctlError:
                return None
            return True

        self._transition(
            "governance_change",
            parameters,
            effect,
            verifier,
            lock_held=lock_held,
        )
        return True

    def _assert_state_binding(
        self, state: dict[str, Any], *, allow_selection_mismatch: bool = False
    ) -> TaskContract:
        contract = self._contract()
        metadata = self._assert_metadata(contract)
        if (
            state.get("task_id") != self.task_id
            or state.get("task_file") != contract.task_path
            or state.get("allowlist") != list(contract.allowlist)
        ):
            raise TaskctlError("state task contract binding changed")
        if not _valid_reviewer_identity(
            state.get("controller")
        ) or not _valid_reviewer_identity(state.get("implementer")):
            raise TaskctlError("state durable identity binding is invalid")
        if (
            type(state.get("review_generation")) is not int
            or state["review_generation"] < 0
        ):
            raise TaskctlError("state review generation binding is invalid")
        baseline = state.get("baseline")
        if not isinstance(baseline, dict):
            raise TaskctlError("state baseline identity is missing")
        observed = {
            "task_json_sha256": sha256_file(self.artifact / "task.json"),
            "allowlist_sha256": sha256_file(self.artifact / "baseline_allowlist.diff"),
            "external_sha256": sha256_file(
                self.artifact / "baseline_external_files.txt"
            ),
            "init_ts": metadata.get("init_ts"),
        }
        if any(baseline.get(key) != value for key, value in observed.items()):
            raise TaskctlError("task metadata or captured baseline identity changed")
        provenance_sha = baseline.get("init_provenance_sha256")
        provenance_path = self.artifact / "init-provenance.json"
        if provenance_sha is not None and (
            not isinstance(provenance_sha, str)
            or not provenance_path.is_file()
            or sha256_file(provenance_path) != provenance_sha
        ):
            raise TaskctlError("v2 init provenance changed or is missing")
        legacy_sha = baseline.get("legacy_bundle_sha256")
        if legacy_sha is not None:
            if not isinstance(legacy_sha, str):
                raise TaskctlError("legacy bundle inventory hash is invalid")
            self._verify_snapshot_inventory(
                self.artifact / "legacy-bundle.json",
                self.artifact / "bootstrap/legacy-bundle",
                legacy_sha,
            )
            prefix_path = self.artifact / "legacy-prefix.json"
            prefix_sha = baseline.get("legacy_prefix_sha256")
            if (
                not isinstance(prefix_sha, str)
                or not prefix_path.is_file()
                or sha256_file(prefix_path) != prefix_sha
            ):
                raise TaskctlError("legacy prefix binding changed or is missing")
            self.events.validate_legacy_views(self._legacy_snapshot_prefixes())
        frozen_sha = baseline.get("frozen_v1_inventory_sha256")
        frozen_inventory = self.artifact / "bootstrap/frozen-v1/inventory.json"
        if frozen_sha is not None:
            if not isinstance(frozen_sha, str):
                raise TaskctlError("frozen-v1 inventory hash is invalid")
            self._verify_snapshot_inventory(
                frozen_inventory,
                self.artifact / "bootstrap/frozen-v1",
                frozen_sha,
            )
        frozen_plan_sha = baseline.get("frozen_v1_plan_sha256")
        frozen_plan = self.artifact / "bootstrap/frozen-v1-plan.json"
        if frozen_plan_sha is not None and (
            not isinstance(frozen_plan_sha, str)
            or not frozen_plan.is_file()
            or sha256_file(frozen_plan) != frozen_plan_sha
        ):
            raise TaskctlError("frozen-v1 source plan changed or is missing")
        selection_path = self.artifact / "module_selection.json"
        expected_selection = state.get("module_selection_sha256")
        if not allow_selection_mismatch and (
            not isinstance(expected_selection, str)
            or not selection_path.is_file()
            or sha256_file(selection_path) != expected_selection
        ):
            raise TaskctlError("module selection evidence changed or is missing")
        adoption = state.get("governance_adoption")
        pending_report = state.get("governance_change_report_pending")
        if pending_report is not None:
            if adoption is not None:
                raise TaskctlError(
                    "pending governance report cannot retain an adoption"
                )
            _change, content = self._governance_change_content(state)
            if (
                not isinstance(pending_report, str)
                or not HEX_PATTERN.fullmatch(pending_report)
                or sha256_bytes(content) != pending_report
                or state.get("state") != "BLOCKED"
                or state.get("reason") != "GOVERNANCE_DIGEST_MISMATCH"
            ):
                raise TaskctlError(
                    "pending governance change report binding is invalid"
                )
            predecessor = state.get("governance_change_predecessor_report_sha256")
            if predecessor is not None and (
                not isinstance(predecessor, str)
                or not HEX_PATTERN.fullmatch(predecessor)
            ):
                raise TaskctlError(
                    "pending governance predecessor report binding is invalid"
                )
        if adoption is not None:
            if not isinstance(adoption, dict):
                raise TaskctlError("governance adoption binding is invalid")
            approval = Path(str(adoption.get("approval_path", "")))
            if (
                approval.resolve()
                != (self.artifact / "governance_adoption.md").resolve()
                or not approval.is_file()
                or sha256_file(approval) != adoption.get("approval_sha256")
            ):
                raise TaskctlError("governance adoption approval changed or is missing")
            change = self._validated_governance_change(state)
            change_path = self.artifact / "governance_change.json"
            if (
                adoption.get("change_path") != str(change_path)
                or adoption.get("change_sha256") != change.get("change_sha256")
                or adoption.get("change_file_sha256") != sha256_file(change_path)
            ):
                raise TaskctlError("governance adoption change binding is invalid")
        return contract

    def _legacy_bundle_inventory(
        self,
        view_prefixes: dict[str, bytes] | None = None,
        *,
        recovery_started_ns: int | None = None,
    ) -> dict[str, Any]:
        excluded = {
            "init-provenance.json",
            "legacy-bundle.json",
            "legacy-prefix.json",
            "module_selection.json",
            "state.json",
            "bootstrap/frozen-v1-plan.json",
        }
        entries: list[dict[str, Any]] = []
        for path in sorted(self.artifact.rglob("*")):
            info = path.lstat()
            if stat.S_ISLNK(info.st_mode):
                raise TaskctlError(f"legacy bundle contains a symlink: {path}")
            if not stat.S_ISREG(info.st_mode):
                continue
            relative = path.relative_to(self.artifact).as_posix()
            if relative in excluded or relative.startswith(
                (
                    "events/",
                    "locks/",
                    "process/",
                    "bootstrap/frozen-v1/",
                    "bootstrap/legacy-bundle/",
                )
            ):
                continue
            if _is_atomic_temporary(path):
                if _reconcilable_atomic_temporary(path, info, recovery_started_ns):
                    continue
                raise TaskctlError(f"unattributed taskctl temporary file: {path}")
            if view_prefixes is not None and relative == "commands.jsonl":
                content = view_prefixes["command"]
            elif view_prefixes is not None and relative == "results.jsonl":
                content = view_prefixes["result"]
            else:
                content = path.read_bytes()
            entries.append(
                {
                    "path": relative,
                    "length": len(content),
                    "sha256": sha256_bytes(content),
                    "mode": stat.S_IMODE(info.st_mode),
                }
            )
        required = {
            "task.json",
            "baseline_allowlist.diff",
            "baseline_external_files.txt",
            "commands.jsonl",
            "results.jsonl",
        }
        observed = {entry["path"] for entry in entries}
        if not required <= observed:
            raise TaskctlError("legacy bundle inventory is incomplete")
        inventory = {
            "schema_version": 1,
            "task_id": self.task_id,
            "entries": entries,
        }
        inventory["tree_sha256"] = _canonical_digest(entries)
        return inventory

    def _load_legacy_bundle_inventory(self) -> dict[str, Any]:
        path = self.artifact / "legacy-bundle.json"
        inventory = load_json(path, "legacy bundle inventory")
        self._validate_legacy_bundle_inventory_record(inventory)
        has_events = any((self.artifact / "events").glob("*.command.json"))
        if not has_events and inventory != self._legacy_bundle_inventory():
            raise TaskctlError(
                "legacy bundle inventory differs from the captured legacy bundle"
            )
        expected = sha256_file(path)
        try:
            self._verify_snapshot_inventory(
                path, self.artifact / "bootstrap/legacy-bundle", expected
            )
        except TaskctlError:
            if has_events:
                raise
            self._install_legacy_bundle_inventory(inventory)
            self._verify_snapshot_inventory(
                path, self.artifact / "bootstrap/legacy-bundle", expected
            )
        return inventory

    def _validate_legacy_bundle_inventory_record(
        self, inventory: dict[str, Any]
    ) -> None:
        if (
            set(inventory)
            != {
                "schema_version",
                "task_id",
                "entries",
                "tree_sha256",
            }
            or inventory.get("schema_version") != 1
            or inventory.get("task_id") != self.task_id
        ):
            raise TaskctlError("legacy bundle inventory authority is invalid")
        entries = inventory.get("entries")
        if not isinstance(entries, list) or inventory.get(
            "tree_sha256"
        ) != _canonical_digest(entries):
            raise TaskctlError("legacy bundle inventory tree is invalid")
        paths: list[str] = []
        for entry in entries:
            if not isinstance(entry, dict) or set(entry) != {
                "path",
                "length",
                "sha256",
                "mode",
            }:
                raise TaskctlError("legacy bundle inventory entry is invalid")
            relative = _safe_relative(str(entry.get("path", "")), "legacy path")
            if (
                type(entry.get("length")) is not int
                or entry["length"] < 0
                or not isinstance(entry.get("sha256"), str)
                or not HEX_PATTERN.fullmatch(entry["sha256"])
                or type(entry.get("mode")) is not int
                or not 0 <= entry["mode"] <= 0o7777
            ):
                raise TaskctlError("legacy bundle inventory entry authority is invalid")
            paths.append(relative)
        required = {
            "task.json",
            "baseline_allowlist.diff",
            "baseline_external_files.txt",
            "commands.jsonl",
            "results.jsonl",
        }
        if len(paths) != len(set(paths)) or not required <= set(paths):
            raise TaskctlError("legacy bundle inventory path set is invalid")

    def _install_legacy_bundle_inventory(
        self,
        inventory: dict[str, Any],
        *,
        source_overrides: dict[str, bytes] | None = None,
    ) -> str:
        self._validate_legacy_bundle_inventory_record(inventory)
        path = self.artifact / "legacy-bundle.json"
        content = canonical_json(inventory)
        if path.exists() and path.read_bytes() != content:
            raise TaskctlError("legacy bundle inventory changed after adoption")
        if not path.exists():
            atomic_write(path, content)
        entries = inventory.get("entries")
        if not isinstance(entries, list):
            raise TaskctlError("legacy bundle inventory is invalid")
        snapshot_root = self.artifact / "bootstrap/legacy-bundle"
        for entry in entries:
            if not isinstance(entry, dict):
                raise TaskctlError("legacy bundle inventory entry is invalid")
            relative = _safe_relative(str(entry.get("path", "")), "legacy path")
            source = self.artifact / relative
            info = source.lstat()
            if not stat.S_ISREG(info.st_mode):
                raise TaskctlError(f"legacy source is not regular: {relative}")
            if source_overrides is not None and relative == "commands.jsonl":
                source_bytes = source_overrides["command"]
            elif source_overrides is not None and relative == "results.jsonl":
                source_bytes = source_overrides["result"]
            else:
                source_bytes = source.read_bytes()
            if (
                len(source_bytes) != entry.get("length")
                or sha256_bytes(source_bytes) != entry.get("sha256")
                or stat.S_IMODE(info.st_mode) != entry.get("mode")
            ):
                raise TaskctlError(f"legacy source changed before snapshot: {relative}")
            destination = snapshot_root / relative
            if destination.exists() and destination.read_bytes() != source_bytes:
                raise TaskctlError(f"legacy snapshot changed: {relative}")
            if not destination.exists():
                atomic_write(
                    destination, source_bytes, mode=int(entry.get("mode", 0o600))
                )
            _fault(self.fault, f"after_legacy_bundle_copy:{relative}")
        return sha256_bytes(content)

    def _verify_snapshot_inventory(
        self, inventory_path: Path, snapshot_root: Path, expected_sha256: str
    ) -> None:
        if (
            not inventory_path.is_file()
            or sha256_file(inventory_path) != expected_sha256
        ):
            raise TaskctlError("snapshot inventory changed or is missing")
        inventory = load_json(inventory_path, "snapshot inventory")
        entries = inventory.get("entries")
        if not isinstance(entries, list):
            raise TaskctlError("snapshot inventory entries are invalid")
        if inventory.get("tree_sha256") != _canonical_digest(entries):
            raise TaskctlError("snapshot inventory tree digest is invalid")
        expected_paths: set[str] = set()
        for entry in entries:
            if not isinstance(entry, dict):
                raise TaskctlError("snapshot inventory entry is invalid")
            relative = _safe_relative(str(entry.get("path", "")), "snapshot path")
            expected_paths.add(relative)
            path = snapshot_root / relative
            try:
                info = path.lstat()
            except FileNotFoundError as exc:
                raise TaskctlError(f"snapshot file is missing: {relative}") from exc
            if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(
                info.st_mode
            ) != entry.get("mode"):
                raise TaskctlError(f"snapshot file type or mode changed: {relative}")
            content = path.read_bytes()
            if len(content) != entry.get("length") or sha256_bytes(
                content
            ) != entry.get("sha256"):
                raise TaskctlError(f"snapshot file bytes changed: {relative}")
        actual_paths: set[str] = set()
        if snapshot_root.exists():
            for path in snapshot_root.rglob("*"):
                info = path.lstat()
                if stat.S_ISLNK(info.st_mode):
                    raise TaskctlError(f"snapshot contains a symlink: {path}")
                if stat.S_ISREG(info.st_mode):
                    actual_paths.add(path.relative_to(snapshot_root).as_posix())
        try:
            actual_paths.discard(inventory_path.relative_to(snapshot_root).as_posix())
        except ValueError:
            pass
        if actual_paths != expected_paths:
            raise TaskctlError("snapshot tree contains missing or extra files")

    def _legacy_snapshot_prefixes(self) -> dict[str, bytes]:
        root = self.artifact / "bootstrap/legacy-bundle"
        prefixes: dict[str, bytes] = {}
        for kind in ("command", "result"):
            path = root / f"{kind}s.jsonl"
            try:
                info = path.lstat()
            except FileNotFoundError as exc:
                raise TaskctlError(f"legacy {kind} snapshot is missing") from exc
            if not stat.S_ISREG(info.st_mode):
                raise TaskctlError(f"legacy {kind} snapshot is not regular")
            prefixes[kind] = path.read_bytes()
        return prefixes

    def _bootstrap_legacy_prefixes(self) -> dict[str, bytes]:
        """Return the immutable legacy JSONL bytes before any v2 projection rows."""
        metadata = self.artifact / "legacy-prefix.json"
        try:
            metadata_info = metadata.lstat()
        except FileNotFoundError:
            metadata_info = None
        if metadata_info is not None:
            if not stat.S_ISREG(metadata_info.st_mode):
                raise TaskctlError("legacy prefix metadata is not regular")
            prefixes = {
                kind: self.events._prefix(kind) for kind in ("command", "result")
            }
            self.events.validate_legacy_views(prefixes)
            has_v2_events = bool(
                self.events._ordinals("command") or self.events._ordinals("result")
            )
            if not has_v2_events:
                for kind, prefix in prefixes.items():
                    view = self.artifact / f"{kind}s.jsonl"
                    if view.read_bytes() != prefix:
                        raise TaskctlError(
                            f"legacy {kind} prefix must bind the entire pre-v2 view"
                        )
            return prefixes
        prefixes: dict[str, bytes] = {}
        for kind in ("command", "result"):
            view = self.artifact / f"{kind}s.jsonl"
            try:
                info = view.lstat()
            except FileNotFoundError as exc:
                raise TaskctlError(f"legacy {kind} view is missing") from exc
            if not stat.S_ISREG(info.st_mode):
                raise TaskctlError(f"legacy {kind} view is not regular")
            prefixes[kind] = view.read_bytes()
        return prefixes

    def _bootstrap_recovery_started_ns(self) -> int | None:
        candidates: list[int] = []
        for ordinal in self.events._ordinals("command"):
            if self.events._path(ordinal, "result").exists():
                continue
            command = self.events._load_event(ordinal, "command")
            argv = command.get("argv")
            if command.get("step") != "taskctl_start" or not isinstance(argv, list):
                continue

            def flag_value(flag: str) -> str | None:
                if argv.count(flag) != 1:
                    return None
                index = argv.index(flag)
                if index + 1 >= len(argv) or not isinstance(argv[index + 1], str):
                    return None
                return argv[index + 1]

            started_ns = command.get("started_ns")
            pid = command.get("pid")
            if (
                flag_value("--controller") == self.actor
                and flag_value("--implementer") == self.implementer
                and type(started_ns) is int
                and started_ns > 0
                and type(pid) is int
                and pid > 0
                and pid != os.getpid()
            ):
                candidates.append(started_ns)
        if len(candidates) > 1:
            raise TaskctlError("multiple recoverable bootstrap starts are incomplete")
        return candidates[0] if candidates else None

    def _prepare_legacy_bundle_inventory(
        self,
        prefixes: dict[str, bytes],
        *,
        recovery_started_ns: int | None,
    ) -> dict[str, Any]:
        expected = self._legacy_bundle_inventory(
            prefixes, recovery_started_ns=recovery_started_ns
        )
        inventory_path = self.artifact / "legacy-bundle.json"
        inventory = expected
        if inventory_path.exists():
            inventory = load_json(inventory_path, "legacy bundle inventory")
            self._validate_legacy_bundle_inventory_record(inventory)
            if inventory != expected:
                raise TaskctlError(
                    "legacy bundle inventory differs from the captured legacy bundle"
                )

        entries = inventory.get("entries")
        if not isinstance(entries, list):
            raise TaskctlError("legacy bundle inventory is invalid")
        expected_entries = {
            str(entry["path"]): entry for entry in entries if isinstance(entry, dict)
        }
        snapshot_root = self.artifact / "bootstrap/legacy-bundle"
        if snapshot_root.exists():
            for path in snapshot_root.rglob("*"):
                info = path.lstat()
                relative = path.relative_to(snapshot_root).as_posix()
                if stat.S_ISLNK(info.st_mode):
                    raise TaskctlError(
                        f"legacy snapshot contains a symlink: {relative}"
                    )
                if not stat.S_ISREG(info.st_mode):
                    continue
                if _is_atomic_temporary(path):
                    if _reconcilable_atomic_temporary(path, info, recovery_started_ns):
                        continue
                    raise TaskctlError(
                        f"unattributed taskctl temporary file: {relative}"
                    )
                entry = expected_entries.get(relative)
                content = path.read_bytes()
                if (
                    entry is None
                    or len(content) != entry.get("length")
                    or sha256_bytes(content) != entry.get("sha256")
                    or stat.S_IMODE(info.st_mode) != entry.get("mode")
                ):
                    raise TaskctlError(f"legacy snapshot changed: {relative}")
        return inventory

    def _reconcile_atomic_temporaries(self, recovery_started_ns: int | None) -> None:
        parents: set[Path] = set()
        for path in sorted(self.artifact.rglob("*")):
            if not _is_atomic_temporary(path):
                continue
            info = path.lstat()
            if not stat.S_ISREG(info.st_mode) or not _reconcilable_atomic_temporary(
                path, info, recovery_started_ns
            ):
                raise TaskctlError(f"unsafe taskctl temporary authority: {path}")
            path.unlink()
            parents.add(path.parent)
        directory_flags = os.O_RDONLY
        if hasattr(os, "O_DIRECTORY"):
            directory_flags |= os.O_DIRECTORY
        for parent in sorted(parents):
            descriptor = os.open(parent, directory_flags)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)

    def _prepare_frozen_v1_plan(self, contract: TaskContract) -> dict[str, Any]:
        missing_allowlist = sorted(set(FROZEN_V1_CONSUMERS) - set(contract.allowlist))
        if missing_allowlist:
            raise TaskctlError(
                f"GVR-3 allowlist omits legacy consumer: {missing_allowlist[0]}"
            )
        authority = self.artifact / "bootstrap/frozen-v1-plan.json"
        if authority.exists():
            plan = load_json(authority, "frozen-v1 source plan")
            self._validate_frozen_v1_plan(plan)
            return plan

        self._validate_frozen_v1_sources()
        entries: list[dict[str, Any]] = []
        for relative in FROZEN_V1_CONSUMERS:
            source, _ = _repo_file_path(
                self.repo_root / relative, self.repo_root, "legacy consumer"
            )
            content = source.read_bytes()
            entries.append(
                {
                    "path": relative,
                    "length": len(content),
                    "sha256": sha256_bytes(content),
                    "mode": stat.S_IMODE(source.stat().st_mode),
                    "content_b64": base64.b64encode(content).decode("ascii"),
                }
            )
        plan = {"schema_version": 1, "entries": entries}
        plan["tree_sha256"] = _canonical_digest(entries)
        return plan

    def _frozen_v1_plan(self, contract: TaskContract) -> dict[str, Any]:
        plan = self._prepare_frozen_v1_plan(contract)
        self._install_frozen_v1_plan(plan)
        return plan

    def _install_frozen_v1_plan(self, plan: dict[str, Any]) -> None:
        self._validate_frozen_v1_plan(plan)
        authority = self.artifact / "bootstrap/frozen-v1-plan.json"
        content = canonical_json(plan)
        if authority.exists() and authority.read_bytes() != content:
            raise TaskctlError("frozen-v1 source plan changed after preparation")
        if not authority.exists():
            atomic_create(authority, content)

    def _validate_frozen_v1_plan(self, plan: dict[str, Any]) -> None:
        if (
            set(plan) != {"schema_version", "entries", "tree_sha256"}
            or plan.get("schema_version") != 1
        ):
            raise TaskctlError("frozen-v1 source plan authority is invalid")
        entries = plan.get("entries")
        if not isinstance(entries, list) or plan.get(
            "tree_sha256"
        ) != _canonical_digest(entries):
            raise TaskctlError("frozen-v1 source plan tree is invalid")
        if len(entries) != len(FROZEN_V1_CONSUMERS):
            raise TaskctlError("frozen-v1 source plan path set is invalid")
        durable_start = any(
            self.events._load_event(ordinal, "command").get("step") == "taskctl_start"
            for ordinal in self.events._ordinals("command")
        )
        authority = self.artifact / "bootstrap/frozen-v1-plan.json"
        durable_source_plan = durable_start and authority.is_file()
        for expected_path, entry in zip(FROZEN_V1_CONSUMERS, entries, strict=True):
            if not isinstance(entry, dict) or set(entry) != {
                "path",
                "length",
                "sha256",
                "mode",
                "content_b64",
            }:
                raise TaskctlError("frozen-v1 source plan entry is invalid")
            if entry.get("path") != expected_path:
                raise TaskctlError("frozen-v1 source plan path set is invalid")
            try:
                content = base64.b64decode(entry.get("content_b64"), validate=True)
            except (TypeError, ValueError, base64.binascii.Error) as exc:
                raise TaskctlError("frozen-v1 source plan content is invalid") from exc
            if (
                type(entry.get("length")) is not int
                or entry["length"] != len(content)
                or entry.get("sha256") != FROZEN_V1_ACCEPTED_SHA256[expected_path]
                or sha256_bytes(content) != entry.get("sha256")
                or type(entry.get("mode")) is not int
                or not 0 <= entry["mode"] <= 0o7777
            ):
                raise TaskctlError("frozen-v1 source plan entry authority is invalid")
            if not durable_source_plan:
                source, canonical = _repo_file_path(
                    self.repo_root / expected_path,
                    self.repo_root,
                    "frozen-v1 consumer",
                )
                if (
                    canonical != expected_path
                    or source.read_bytes() != content
                    or stat.S_IMODE(source.stat().st_mode) != entry["mode"]
                ):
                    raise TaskctlError(
                        f"frozen-v1 source plan differs from live source: {expected_path}"
                    )

    def _validate_frozen_v1_sources(self) -> None:
        if set(FROZEN_V1_ACCEPTED_SHA256) != set(FROZEN_V1_CONSUMERS):
            raise TaskctlError("frozen-v1 consumer hash inventory is incomplete")
        for relative in FROZEN_V1_CONSUMERS:
            source, canonical = _repo_file_path(
                self.repo_root / relative,
                self.repo_root,
                "frozen-v1 consumer",
            )
            if (
                canonical != relative
                or sha256_file(source) != FROZEN_V1_ACCEPTED_SHA256[relative]
            ):
                raise TaskctlError(f"frozen-v1 consumer bytes changed: {relative}")

    def _install_frozen_v1(self, plan: dict[str, Any]) -> str:
        self._validate_frozen_v1_plan(plan)
        root = self.artifact / "bootstrap/frozen-v1"
        entries = plan.get("entries")
        authority = self.artifact / "bootstrap/frozen-v1-plan.json"
        if (
            not isinstance(entries, list)
            or not authority.is_file()
            or authority.read_bytes() != canonical_json(plan)
            or plan.get("tree_sha256") != _canonical_digest(entries)
        ):
            raise TaskctlError("frozen-v1 plan is invalid")
        inventory_entries: list[dict[str, Any]] = []
        for entry in entries:
            if not isinstance(entry, dict):
                raise TaskctlError("frozen-v1 entry is invalid")
            relative = str(entry.get("path", ""))
            _safe_relative(relative, "legacy consumer")
            destination = root / relative
            try:
                content = base64.b64decode(
                    str(entry.get("content_b64", "")), validate=True
                )
            except (ValueError, base64.binascii.Error) as exc:
                raise TaskctlError(
                    f"invalid frozen-v1 source bytes: {relative}"
                ) from exc
            if len(content) != entry.get("length") or sha256_bytes(
                content
            ) != entry.get("sha256"):
                raise TaskctlError(f"frozen-v1 source plan changed: {relative}")
            if destination.exists() and destination.read_bytes() != content:
                raise TaskctlError(f"frozen-v1 snapshot changed: {relative}")
            if not destination.exists():
                atomic_write(destination, content, mode=int(entry.get("mode", 0o600)))
            _fault(self.fault, f"after_frozen_v1_copy:{relative}")
            inventory_entries.append(
                {key: entry[key] for key in ("path", "length", "sha256", "mode")}
            )
        inventory_record = {
            "schema_version": 1,
            "entries": inventory_entries,
            "tree_sha256": _canonical_digest(inventory_entries),
        }
        inventory = canonical_json(inventory_record)
        inventory_path = root / "inventory.json"
        if inventory_path.exists() and inventory_path.read_bytes() != inventory:
            raise TaskctlError("frozen-v1 inventory changed")
        if not inventory_path.exists():
            atomic_write(inventory_path, inventory)
        return sha256_bytes(inventory)

    def _validate_bootstrap_bundle(self, contract: TaskContract) -> None:
        if contract.status.startswith("PASS"):
            raise TaskctlError("bootstrap may adopt only a non-PASS legacy bundle")
        for path in (
            self.artifact / "baseline_allowlist.diff",
            self.artifact / "baseline_external_files.txt",
            self.artifact / "commands.jsonl",
            self.artifact / "results.jsonl",
        ):
            if not path.is_file():
                raise TaskctlError(f"bootstrap bundle is incomplete: {path.name}")
        result_rows = _read_jsonl(self.artifact / "results.jsonl")
        red_rows = [row for row in result_rows if row.get("step") == "red"]
        if (
            not red_rows
            or type(red_rows[-1].get("rc")) is not int
            or red_rows[-1]["rc"] <= 0
        ):
            raise TaskctlError("bootstrap bundle requires a latest durable nonzero RED")
        red = red_rows[-1]
        red_ts = red.get("ts")
        if not isinstance(red_ts, str) or not re.fullmatch(r"\d{8}T\d{12}", red_ts):
            raise TaskctlError("bootstrap RED result timestamp is invalid")
        red_commands = [
            row
            for row in _read_jsonl(self.artifact / "commands.jsonl")
            if row.get("step") == "red"
        ]
        if not red_commands or red_commands[-1].get("ts") != red_ts:
            raise TaskctlError("bootstrap RED command/result pair is invalid")
        red_command = red_commands[-1]
        if red_command.get("argv") != list(GVR3_LEGACY_RED_ARGV) or red_command.get(
            "cwd"
        ) != str(self.repo_root):
            raise TaskctlError("bootstrap RED command differs from frozen contract")
        red_log = red.get("log")
        if not isinstance(red_log, str):
            raise TaskctlError("bootstrap RED log is missing")
        red_log_relative = _safe_relative(red_log, "bootstrap RED log")
        expected_red_log = f"artifacts/{self.task_id}/outputs/{red_ts}_red.log"
        if red_log_relative != expected_red_log:
            raise TaskctlError("bootstrap RED log is not the canonical task output")
        _repo_file_path(
            self.repo_root / red_log_relative,
            self.repo_root,
            "bootstrap RED log",
        )

    def _bootstrap_context(
        self,
        contract: TaskContract,
        kernel: Path,
        manifest_path: Path,
    ) -> tuple[dict[str, Any], str, list[str], dict[str, str]]:
        kernel_file, _ = _repo_file_path(kernel, self.repo_root, "bootstrap kernel")
        manifest_file, _ = _repo_file_path(
            manifest_path, self.repo_root, "bootstrap manifest"
        )
        expected_kernel = self.repo_root / GVR1_CANDIDATE / "AGENTS.md"
        expected_manifest = self.repo_root / GVR1_CANDIDATE / "manifest.json"
        if kernel_file != expected_kernel or manifest_file != expected_manifest:
            raise TaskctlError(
                "bootstrap candidates must be exact accepted GVR-1 paths"
            )
        for name, expected_sha256 in GVR1_ACCEPTED_CANDIDATE_SHA256.items():
            candidate_path = self.repo_root / GVR1_CANDIDATE / name
            if sha256_file(candidate_path) != expected_sha256:
                raise TaskctlError(f"accepted GVR-1 candidate bytes changed: {name}")
        manifest = load_json(manifest_file, "bootstrap manifest")
        _validate_manifest(manifest, self.repo_root)
        if manifest.get("activation_task") != self.task_id or self.task_id != GVR3_ID:
            raise TaskctlError(
                "bootstrap is restricted to the manifest activation task"
            )
        for dependency in (GVR1_ID, GVR2_ID):
            if not legacy_task_pass(self.repo_root, dependency):
                raise TaskctlError(
                    f"bootstrap dependency is not accepted PASS: {dependency}"
                )
        digest, inputs = governance_digest(self.repo_root, kernel_file, manifest)
        digest_record = load_json(
            self.repo_root / GVR1_CANDIDATE / "governance_digest.json",
            "accepted governance digest",
        )
        if (
            digest_record.get("digest") != digest
            or digest_record.get("inputs") != inputs
            or sha256_file(kernel_file) != inputs.get("AGENTS.md")
        ):
            raise TaskctlError("bootstrap governance bytes or digest mismatch")
        return manifest, digest, select_modules(manifest, contract), inputs

    def _active_context(
        self, contract: TaskContract
    ) -> tuple[dict[str, Any], str, list[str], dict[str, str]]:
        manifest_path = self.repo_root / "docs/agents/manifest.json"
        root_path = self.repo_root / "AGENTS.md"
        manifest = load_json(manifest_path, "active governance manifest")
        _validate_manifest(manifest, self.repo_root)
        activation_task = manifest.get("activation_task")
        if not isinstance(activation_task, str):
            raise TaskctlError("active manifest has no activation task")
        activation_state = self.repo_root / "artifacts" / activation_task / "state.json"
        accepted = load_json(activation_state, "activation state")
        if accepted.get("state") != "PASS":
            raise TaskctlError("governance is staged; activation state is not PASS")
        digest, inputs = governance_digest(self.repo_root, root_path, manifest)
        activation = accepted.get("activation")
        candidate = accepted.get("candidate")
        if not isinstance(activation, dict) or not isinstance(candidate, dict):
            raise TaskctlError(
                "activation PASS is missing its reviewed governance binding"
            )
        candidate_material = dict(candidate)
        candidate_fingerprint = candidate_material.pop("fingerprint", None)
        source_hashes = candidate.get("source_hashes")
        if (
            not isinstance(candidate_fingerprint, str)
            or _canonical_digest(candidate_material) != candidate_fingerprint
            or not isinstance(source_hashes, dict)
            or sha256_file(root_path) != activation.get("kernel_sha256")
            or sha256_file(manifest_path) != activation.get("manifest_sha256")
            or digest != activation.get("governance_digest")
            or candidate.get("governance_digest") != digest
            or source_hashes.get("kernel_sha256") != activation.get("kernel_sha256")
            or source_hashes.get("manifest_sha256") != activation.get("manifest_sha256")
        ):
            raise TaskctlError(
                "active governance differs from reviewed activation PASS"
            )
        activation_validator = TaskController(
            self.repo_root,
            activation_task,
            actor=str(accepted.get("controller", "")),
            implementer=str(accepted.get("implementer", "")),
        )
        activation_contract = activation_validator._assert_state_binding(accepted)
        activation_validator._validate_immutable_candidate(
            accepted, candidate, activation_contract
        )
        activation_validator._validate_submitted_reviews(accepted)
        activation_validator._validate_terminal_receipts(accepted, candidate)
        return manifest, digest, select_modules(manifest, contract), inputs

    def _ensure_governance_current(
        self,
        state: dict[str, Any],
        contract: TaskContract,
        *,
        lock_held: bool = False,
    ) -> None:
        if self._reconcile_pending_governance_change(state, lock_held=lock_held):
            raise TaskctlError(
                "governance digest changed; independent adoption is required"
            )
        predecessor_state = canonical_json(state)
        if self.task_id == GVR3_ID:
            bootstrap = state.get("bootstrap")
            if not isinstance(bootstrap, dict):
                raise TaskctlError("bootstrap governance binding is missing")
            kernel = Path(str(bootstrap.get("kernel_path", "")))
            manifest_path = Path(str(bootstrap.get("manifest_path", "")))
            manifest = load_json(manifest_path, "bootstrap manifest")
            observed, observed_inputs = governance_digest(
                self.repo_root, kernel, manifest
            )
            observed_selected = select_modules(manifest, contract)
        else:
            manifest, observed, observed_selected, observed_inputs = (
                self._active_context(contract)
            )
        expected = state.get("governance_digest")
        if observed == expected:
            incomplete = self.events.first_incomplete()
            if incomplete is not None:
                command = self.events._load_event(incomplete, "command")
                if command.get("step") == "taskctl_governance_change":
                    if (
                        command.get("classification") != "INTERNAL"
                        or command.get("replay_safe") is not True
                        or command.get("cwd") != str(self.repo_root)
                        or state.get("governance_change_report_pending") is not None
                    ):
                        raise TaskctlError(
                            "reverted governance command authority is invalid"
                        )
                    if isinstance(state.get("governance_change"), dict):
                        self._validated_governance_change(state)
                    elif (self.artifact / "governance_change.json").exists():
                        raise TaskctlError(
                            "governance change report has no predecessor state binding"
                        )
                    self.events.supersede_incomplete_internal(
                        incomplete, reason="governance_reverted_before_effect"
                    )
            return
        if not isinstance(expected, str) or not HEX_PATTERN.fullmatch(expected):
            raise TaskctlError("stored governance digest is invalid")
        expected_inputs = state.get("governance_inputs")
        if not isinstance(expected_inputs, dict) or not all(
            isinstance(path, str) and isinstance(digest, str)
            for path, digest in expected_inputs.items()
        ):
            raise TaskctlError("stored governance input inventory is invalid")
        changed_inputs = {
            path: {
                "old": expected_inputs.get(path),
                "new": observed_inputs.get(path),
            }
            for path in sorted(set(expected_inputs) | set(observed_inputs))
            if expected_inputs.get(path) != observed_inputs.get(path)
        }
        expected_owners = state.get("governance_rule_owners")
        observed_owners = manifest.get("rule_owners")
        if not isinstance(expected_owners, dict) or not isinstance(
            observed_owners, dict
        ):
            raise TaskctlError("governance rule owner inventory is invalid")
        changed_rules = sorted(
            rule_id
            for rule_id in set(expected_owners) | set(observed_owners)
            if expected_owners.get(rule_id) != observed_owners.get(rule_id)
            or expected_owners.get(rule_id) in changed_inputs
            or observed_owners.get(rule_id) in changed_inputs
        )
        selected_before = state.get("selected_modules")
        if not isinstance(selected_before, list):
            raise TaskctlError("stored module selection is invalid")
        changed_selected_inputs = sorted(
            path
            for path in changed_inputs
            if path in set(selected_before) | set(observed_selected)
            or path in {"AGENTS.md", "docs/agents/manifest.json"}
        )
        change = {
            "old": expected,
            "new": observed,
            "changed_inputs": changed_inputs,
            "changed_rules": changed_rules,
            "module_selection": {
                "old": selected_before,
                "new": observed_selected,
            },
            "closure_impact": {
                "task_path": contract.task_path,
                "risk_tier": contract.risk_tier,
                "closure_tags": list(contract.closure_tags),
                "changed_selected_inputs": changed_selected_inputs,
            },
            "baseline_identity": state.get("baseline", {}),
            "observed_inputs": observed_inputs,
            "observed_rule_owners": observed_owners,
        }
        change["change_sha256"] = _canonical_digest(change)
        change_content = canonical_json(change)
        change_file_sha256 = sha256_bytes(change_content)

        def is_target(current: dict[str, Any]) -> bool:
            return (
                current.get("state") == "BLOCKED"
                and current.get("reason") == "GOVERNANCE_DIGEST_MISMATCH"
                and current.get("governance_change") == change
                and current.get("governance_adoption") is None
            )

        if is_target(state) and (
            "governance_change_predecessor_report_sha256" in state
        ):
            predecessor_report_sha256 = state.get(
                "governance_change_predecessor_report_sha256"
            )
        elif isinstance(state.get("governance_change"), dict):
            self._validated_governance_change(state)
            predecessor_report_sha256 = sha256_file(
                self.artifact / "governance_change.json"
            )
        elif (self.artifact / "governance_change.json").exists():
            raise TaskctlError(
                "governance change report has no predecessor state binding"
            )
        else:
            predecessor_report_sha256 = None
        if predecessor_report_sha256 is not None and (
            not isinstance(predecessor_report_sha256, str)
            or not HEX_PATTERN.fullmatch(predecessor_report_sha256)
        ):
            raise TaskctlError("governance predecessor report hash is invalid")

        def effect() -> None:
            current = self._state()
            if is_target(current):
                pending = current.get("governance_change_report_pending")
                if pending is None:
                    self._validated_governance_change(current)
                    return
                if pending != change_file_sha256:
                    raise TaskctlError(
                        "pending governance change differs from command authority"
                    )
                self._complete_pending_governance_change_report(
                    current, lock_held=lock_held
                )
                return
            if canonical_json(current) != predecessor_state:
                raise TaskctlError(
                    "governance change predecessor state changed before effect"
                )
            if isinstance(current.get("governance_change"), dict):
                self._validated_governance_change(current)
            elif (self.artifact / "governance_change.json").exists():
                raise TaskctlError(
                    "governance change report has no predecessor state binding"
                )
            target = dict(current)
            target["state"] = "BLOCKED"
            target["reason"] = "GOVERNANCE_DIGEST_MISMATCH"
            target["governance_change"] = change
            target.pop("governance_adoption", None)
            target["governance_change_report_pending"] = change_file_sha256
            target["governance_change_predecessor_report_sha256"] = (
                predecessor_report_sha256
            )
            self._cas_write_state(
                target, sha256_file(self.state_path), lock_held=lock_held
            )
            _fault(self.fault, "after_governance_change_state")
            expected_pending_hash = sha256_file(self.state_path)
            atomic_write(self.artifact / "governance_change.json", change_content)
            _fault(self.fault, "after_governance_change_report")
            target.pop("governance_change_report_pending", None)
            self._cas_write_state(target, expected_pending_hash, lock_held=lock_held)

        def verifier() -> bool | None:
            current = self._state()
            if is_target(current):
                pending = current.get("governance_change_report_pending")
                if pending == change_file_sha256:
                    return False
                if pending is not None:
                    return None
                try:
                    self._validated_governance_change(current)
                except TaskctlError:
                    return None
                return True
            return False if canonical_json(current) == predecessor_state else None

        parameters = self._governance_change_argv(
            change["change_sha256"],
            change_file_sha256,
            predecessor_report_sha256,
        )
        incomplete = self.events.first_incomplete()
        if incomplete is not None:
            incomplete_command = self.events._load_event(incomplete, "command")
            if (
                incomplete_command.get("step") == "taskctl_governance_change"
                and incomplete_command.get("argv") != parameters
            ):
                if (
                    incomplete_command.get("classification") != "INTERNAL"
                    or incomplete_command.get("replay_safe") is not True
                    or incomplete_command.get("cwd") != str(self.repo_root)
                    or state.get("governance_change_report_pending") is not None
                    or is_target(state)
                ):
                    raise TaskctlError(
                        "incomplete governance change cannot be safely superseded"
                    )
                self.events.supersede_incomplete_internal(
                    incomplete, reason="governance_changed_before_effect"
                )

        self._transition(
            "governance_change",
            parameters,
            effect,
            verifier,
            lock_held=lock_held,
        )
        raise TaskctlError(
            "governance digest changed; independent adoption is required"
        )

    def _governance_matches_state(
        self, state: dict[str, Any], contract: TaskContract
    ) -> bool:
        if self.task_id == GVR3_ID:
            bootstrap = state.get("bootstrap")
            if not isinstance(bootstrap, dict):
                return False
            manifest = load_json(
                Path(str(bootstrap.get("manifest_path", ""))),
                "bootstrap manifest",
            )
            observed, observed_inputs = governance_digest(
                self.repo_root,
                Path(str(bootstrap.get("kernel_path", ""))),
                manifest,
            )
            observed_selected = select_modules(manifest, contract)
        else:
            manifest, observed, observed_selected, observed_inputs = (
                self._active_context(contract)
            )
        return (
            observed == state.get("governance_digest")
            and observed_inputs == state.get("governance_inputs")
            and observed_selected == state.get("selected_modules")
            and manifest.get("rule_owners") == state.get("governance_rule_owners")
        )

    def _initialize_new_bundle(
        self,
        contract: TaskContract,
        *,
        prepared_legacy_inventory: dict[str, Any] | None = None,
        legacy_prefixes: dict[str, bytes] | None = None,
        prepared_baseline: tuple[bytes, bytes] | None = None,
    ) -> tuple[dict[str, Any], dict[str, Any] | None]:
        legacy_inventory: dict[str, Any] | None = None
        provenance_path = self.artifact / "init-provenance.json"
        has_start_event = self.artifact.exists() and any(
            self.events._load_event(ordinal, "command").get("step") == "taskctl_start"
            for ordinal in self.events._ordinals("command")
        )
        bundle_files = [
            path
            for path in self.artifact.rglob("*")
            if path.is_file()
            and not path.relative_to(self.artifact).as_posix().startswith("locks/")
            and not (
                has_start_event
                and (
                    path.relative_to(self.artifact).as_posix()
                    in {"commands.jsonl", "results.jsonl", "legacy-prefix.json"}
                    or path.relative_to(self.artifact)
                    .as_posix()
                    .startswith(("events/", "process/"))
                )
            )
        ]
        if bundle_files and not provenance_path.exists():
            if contract.status.startswith("PASS") or legacy_task_pass(
                self.repo_root, self.task_id
            ):
                raise TaskctlError("historical PASS bundle cannot be adopted as active")
            self._assert_metadata(contract)
            required = (
                self.artifact / "task.json",
                self.artifact / "baseline_allowlist.diff",
                self.artifact / "baseline_external_files.txt",
                self.artifact / "commands.jsonl",
                self.artifact / "results.jsonl",
            )
            if not all(path.is_file() for path in required):
                raise TaskctlError(
                    "partial start has no complete captured baseline; fail closed"
                )
            if prepared_legacy_inventory is not None:
                if legacy_prefixes is None:
                    raise TaskctlError("prepared legacy bundle has no prefix authority")
                legacy_inventory = prepared_legacy_inventory
                legacy_sha = self._install_legacy_bundle_inventory(
                    legacy_inventory, source_overrides=legacy_prefixes
                )
                self._verify_snapshot_inventory(
                    self.artifact / "legacy-bundle.json",
                    self.artifact / "bootstrap/legacy-bundle",
                    legacy_sha,
                )
            elif (self.artifact / "legacy-bundle.json").exists():
                legacy_inventory = self._load_legacy_bundle_inventory()
            else:
                legacy_inventory = self._legacy_bundle_inventory()
                self._install_legacy_bundle_inventory(legacy_inventory)
        else:
            self.artifact.mkdir(parents=True, exist_ok=True)
            if provenance_path.exists():
                provenance = load_json(provenance_path, "v2 init provenance")
                if provenance != {
                    "schema_version": 1,
                    "mode": "v2-new",
                    "task_id": self.task_id,
                    "task_file": contract.task_path,
                    "allowlist": list(contract.allowlist),
                    "repo_root": str(self.repo_root),
                    "init_ts": provenance.get("init_ts"),
                } or not isinstance(provenance.get("init_ts"), str):
                    raise TaskctlError("v2 init provenance changed or is invalid")
            else:
                provenance = {
                    "schema_version": 1,
                    "mode": "v2-new",
                    "task_id": self.task_id,
                    "task_file": contract.task_path,
                    "allowlist": list(contract.allowlist),
                    "repo_root": str(self.repo_root),
                    "init_ts": time.strftime("%Y%m%dT%H%M%S", time.gmtime()),
                }
                atomic_write(provenance_path, canonical_json(provenance))
            for directory in ("events", "git", "outputs", "review"):
                (self.artifact / directory).mkdir(exist_ok=True)
            metadata = {
                "task_id": self.task_id,
                "task_file": contract.task_path,
                "allowlist": list(contract.allowlist),
                "init_ts": provenance["init_ts"],
                "baseline_dirty": True,
                "repo_root": str(self.repo_root),
            }
            metadata_path = self.artifact / "task.json"
            if (
                metadata_path.exists()
                and load_json(metadata_path, "task metadata") != metadata
            ):
                raise TaskctlError("partial v2 task metadata changed")
            if not metadata_path.exists():
                atomic_write(metadata_path, canonical_json(metadata))
            for view in ("commands.jsonl", "results.jsonl"):
                view_path = self.artifact / view
                if not view_path.exists():
                    atomic_write(view_path, b"")
            scope_path = self.repo_root / "scripts/evidence_scope.py"
            import importlib.util

            spec = importlib.util.spec_from_file_location(
                "fpms_evidence_scope", scope_path
            )
            if spec is None or spec.loader is None:
                raise TaskctlError("cannot load evidence scope producer")
            scope = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(scope)
            baseline_paths = (
                self.artifact / "baseline_allowlist.diff",
                self.artifact / "baseline_external_files.txt",
            )
            if prepared_baseline is not None:
                for path, content in zip(
                    baseline_paths, prepared_baseline, strict=True
                ):
                    if path.exists() and path.read_bytes() != content:
                        raise TaskctlError(
                            f"prepared baseline changed during start: {path.name}"
                        )
                    if not path.exists():
                        atomic_write(path, content)
            elif not all(path.is_file() for path in baseline_paths):
                try:
                    scope.capture(self.task_id)
                except Exception as exc:
                    raise TaskctlError(f"baseline capture failed: {exc}") from exc
        metadata = load_json(self.artifact / "task.json", "task metadata")
        baseline = {
            "task_json_sha256": sha256_file(self.artifact / "task.json"),
            "allowlist_sha256": sha256_file(self.artifact / "baseline_allowlist.diff"),
            "external_sha256": sha256_file(
                self.artifact / "baseline_external_files.txt"
            ),
            "init_ts": metadata.get("init_ts"),
        }
        if provenance_path.exists():
            baseline["init_provenance_sha256"] = sha256_file(provenance_path)
        if legacy_inventory is not None:
            baseline["legacy_bundle_sha256"] = sha256_bytes(
                canonical_json(legacy_inventory)
            )
        return baseline, legacy_inventory

    def start(
        self,
        task_file: Path,
        *,
        bootstrap_kernel: Path | None = None,
        bootstrap_manifest: Path | None = None,
    ) -> dict[str, Any]:
        with self.events.lease(
            owner=f"start:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            return self._start_locked(
                task_file,
                bootstrap_kernel=bootstrap_kernel,
                bootstrap_manifest=bootstrap_manifest,
            )

    def _start_locked(
        self,
        task_file: Path,
        *,
        bootstrap_kernel: Path | None = None,
        bootstrap_manifest: Path | None = None,
    ) -> dict[str, Any]:
        if (bootstrap_kernel is None) != (bootstrap_manifest is None):
            raise TaskctlError(
                "bootstrap kernel and manifest must be supplied together"
            )
        contract = parse_task_contract(task_file, self.task_id, self.repo_root)
        bootstrap = bootstrap_kernel is not None
        if bootstrap:
            assert bootstrap_kernel is not None and bootstrap_manifest is not None
            if not self.state_path.exists():
                pre_root, canonical_pre_root = _repo_file_path(
                    self.repo_root / "AGENTS.md",
                    self.repo_root,
                    "pre-v2 root governance",
                )
                if (
                    canonical_pre_root != "AGENTS.md"
                    or sha256_file(pre_root) != GVR3_ACCEPTED_PRE_ROOT_SHA256
                ):
                    raise TaskctlError(
                        "pre-v2 root governance differs from the accepted GVR-2 baseline"
                    )
            manifest, digest, selected, inputs = self._bootstrap_context(
                contract, bootstrap_kernel, bootstrap_manifest
            )
            metadata = self._assert_metadata(contract)
            self._validate_bootstrap_bundle(contract)
            expected = {
                "kernel_path": str(bootstrap_kernel.resolve()),
                "kernel_sha256": sha256_file(bootstrap_kernel),
                "manifest_path": str(bootstrap_manifest.resolve()),
                "manifest_sha256": sha256_file(bootstrap_manifest),
            }
            legacy_prefixes = self._bootstrap_legacy_prefixes()

            def start_parameters(
                legacy_bundle_sha256: str,
                frozen_plan_sha256: str,
                selection_sha256: str,
            ) -> list[str]:
                return [
                    "start",
                    "--task-file",
                    contract.task_path,
                    "--controller",
                    self.actor,
                    "--implementer",
                    self.implementer,
                    "--bootstrap-kernel",
                    expected["kernel_path"],
                    "--bootstrap-kernel-sha256",
                    expected["kernel_sha256"],
                    "--bootstrap-manifest",
                    expected["manifest_path"],
                    "--bootstrap-manifest-sha256",
                    expected["manifest_sha256"],
                    "--legacy-commands-length",
                    str(len(legacy_prefixes["command"])),
                    "--legacy-commands-sha256",
                    sha256_bytes(legacy_prefixes["command"]),
                    "--legacy-results-length",
                    str(len(legacy_prefixes["result"])),
                    "--legacy-results-sha256",
                    sha256_bytes(legacy_prefixes["result"]),
                    "--legacy-bundle-sha256",
                    legacy_bundle_sha256,
                    "--frozen-v1-plan-sha256",
                    frozen_plan_sha256,
                    "--module-selection-sha256",
                    selection_sha256,
                ]

            if self.state_path.exists():
                state = self._state()
                if state.get("bootstrap") != expected:
                    raise TaskctlError("repeated bootstrap parameters or bytes changed")
                if (
                    state.get("controller") != self.actor
                    or state.get("implementer") != self.implementer
                ):
                    raise TaskctlError("repeated start ownership changed")
                bound_contract = self._assert_state_binding(state)
                self._ensure_governance_current(state, bound_contract, lock_held=True)
                baseline = state.get("baseline")
                if not isinstance(baseline, dict):
                    raise TaskctlError("bootstrap baseline binding is missing")
                parameters = start_parameters(
                    str(baseline.get("legacy_bundle_sha256", "")),
                    str(baseline.get("frozen_v1_plan_sha256", "")),
                    str(state.get("module_selection_sha256", "")),
                )
                self._assert_start_request(parameters)
                return self._transition(
                    "start",
                    parameters,
                    lambda: None,
                    lambda: self.state_path.is_file()
                    and self._state().get("bootstrap") == expected
                    and self._state().get("controller") == self.actor
                    and self._state().get("implementer") == self.implementer,
                    lock_held=True,
                    legacy_prefixes=legacy_prefixes,
                )
            if (self.repo_root / "docs/agents/manifest.json").exists():
                raise TaskctlError(
                    "bootstrap is forbidden after active manifest installation"
                )
            recovery_started_ns = self._bootstrap_recovery_started_ns()
            legacy_inventory = self._prepare_legacy_bundle_inventory(
                legacy_prefixes, recovery_started_ns=recovery_started_ns
            )
            legacy_bundle_sha = sha256_bytes(canonical_json(legacy_inventory))
            frozen_plan = self._prepare_frozen_v1_plan(contract)
            frozen_plan_content = canonical_json(frozen_plan)
            frozen_plan_sha = sha256_bytes(frozen_plan_content)
            selection = module_selection_record(manifest, contract, digest)
            selection_content = canonical_json(selection)
            selection_sha = sha256_bytes(selection_content)
            parameters = start_parameters(
                legacy_bundle_sha, frozen_plan_sha, selection_sha
            )
            self._assert_start_request(parameters)

            def bootstrap_effect() -> None:
                self._reconcile_atomic_temporaries(recovery_started_ns)
                installed_legacy_sha = self._install_legacy_bundle_inventory(
                    legacy_inventory, source_overrides=legacy_prefixes
                )
                if installed_legacy_sha != legacy_bundle_sha:
                    raise TaskctlError("legacy bundle installation hash changed")
                self._verify_snapshot_inventory(
                    self.artifact / "legacy-bundle.json",
                    self.artifact / "bootstrap/legacy-bundle",
                    legacy_bundle_sha,
                )
                self._install_frozen_v1_plan(frozen_plan)
                frozen_inventory_sha = self._install_frozen_v1(frozen_plan)
                self._verify_snapshot_inventory(
                    self.artifact / "bootstrap/frozen-v1/inventory.json",
                    self.artifact / "bootstrap/frozen-v1",
                    frozen_inventory_sha,
                )
                self.events.adopt_legacy_views(legacy_prefixes)
                baseline = {
                    "task_json_sha256": sha256_file(self.artifact / "task.json"),
                    "allowlist_sha256": sha256_file(
                        self.artifact / "baseline_allowlist.diff"
                    ),
                    "external_sha256": sha256_file(
                        self.artifact / "baseline_external_files.txt"
                    ),
                    "init_ts": metadata.get("init_ts"),
                    "legacy_bundle_sha256": legacy_bundle_sha,
                    "legacy_prefix_sha256": sha256_file(
                        self.artifact / "legacy-prefix.json"
                    ),
                    "frozen_v1_inventory_sha256": frozen_inventory_sha,
                    "frozen_v1_plan_sha256": frozen_plan_sha,
                }
                state = {
                    "schema_version": 2,
                    "task_id": self.task_id,
                    "state": "IMPLEMENTING",
                    "controller": self.actor,
                    "implementer": self.implementer,
                    "task_file": contract.task_path,
                    "allowlist": list(contract.allowlist),
                    "governance_digest": digest,
                    "governance_inputs": inputs,
                    "governance_rule_owners": manifest["rule_owners"],
                    "selected_modules": selected,
                    "module_selection_sha256": selection_sha,
                    "manifest_activation_task": manifest["activation_task"],
                    "bootstrap": expected,
                    "baseline": baseline,
                    "review_generation": 0,
                    "review_leases": {},
                    "reviews": {},
                }
                selection_path = self.artifact / "module_selection.json"
                if (
                    selection_path.exists()
                    and selection_path.read_bytes() != selection_content
                ):
                    raise TaskctlError("module selection changed during bootstrap")
                if not selection_path.exists():
                    atomic_write(selection_path, selection_content)
                self._cas_write_state(state, None, lock_held=True)

            return self._transition(
                "start",
                parameters,
                bootstrap_effect,
                lambda: self.state_path.is_file()
                and self._state().get("bootstrap") == expected
                and self._state().get("controller") == self.actor
                and self._state().get("implementer") == self.implementer
                and self._state().get("module_selection_sha256") == selection_sha,
                lock_held=True,
                legacy_prefixes=legacy_prefixes,
            )

        if self.task_id == GVR3_ID:
            raise TaskctlError("GVR-3 must use its exact bootstrap candidates")
        if self.state_path.exists():
            state = self._state()
            if (
                state.get("controller") != self.actor
                or state.get("implementer") != self.implementer
            ):
                raise TaskctlError("repeated start ownership changed")
            bound_contract = self._assert_state_binding(state)
            self._ensure_governance_current(state, bound_contract, lock_held=True)
            baseline = state.get("baseline")
            if not isinstance(baseline, dict):
                raise TaskctlError("start baseline binding is missing")
            legacy_bundle_sha = baseline.get("legacy_bundle_sha256")
            legacy_prefixes = (
                self._legacy_snapshot_prefixes()
                if isinstance(legacy_bundle_sha, str)
                else None
            )
            parameters = self._ordinary_start_parameters(
                contract,
                str(state.get("governance_digest", "")),
                str(state.get("module_selection_sha256", "")),
                str(baseline.get("allowlist_sha256", "")),
                str(baseline.get("external_sha256", "")),
                legacy_prefixes=legacy_prefixes,
                legacy_bundle_sha256=(
                    legacy_bundle_sha if isinstance(legacy_bundle_sha, str) else None
                ),
            )
            self._assert_start_request(parameters)
            return self._transition(
                "start",
                parameters,
                lambda: None,
                lambda: self.state_path.is_file()
                and self._state().get("task_file") == contract.task_path
                and self._state().get("controller") == self.actor
                and self._state().get("implementer") == self.implementer,
                lock_held=True,
                legacy_prefixes=legacy_prefixes,
            )
        manifest, digest, selected, inputs = self._active_context(contract)
        selection = module_selection_record(manifest, contract, digest)
        selection_content = canonical_json(selection)
        selection_sha = sha256_bytes(selection_content)
        recovery_started_ns = self._bootstrap_recovery_started_ns()
        provenance_path = self.artifact / "init-provenance.json"
        meaningful_files: list[Path] = []
        if not provenance_path.exists():
            for path in self.artifact.rglob("*"):
                if not path.is_file():
                    continue
                relative = path.relative_to(self.artifact).as_posix()
                if relative in {
                    "commands.jsonl",
                    "results.jsonl",
                    "legacy-prefix.json",
                } or relative.startswith(("events/", "locks/", "process/")):
                    continue
                if _is_atomic_temporary(path):
                    info = path.lstat()
                    if _reconcilable_atomic_temporary(path, info, recovery_started_ns):
                        continue
                meaningful_files.append(path)
        legacy_prefixes: dict[str, bytes] | None = None
        legacy_inventory: dict[str, Any] | None = None
        legacy_bundle_sha: str | None = None
        prepared_baseline: tuple[bytes, bytes] | None = None
        if meaningful_files:
            if contract.status.startswith("PASS") or legacy_task_pass(
                self.repo_root, self.task_id
            ):
                raise TaskctlError("historical PASS bundle cannot be adopted as active")
            self._assert_metadata(contract)
            required = (
                self.artifact / "task.json",
                self.artifact / "baseline_allowlist.diff",
                self.artifact / "baseline_external_files.txt",
                self.artifact / "commands.jsonl",
                self.artifact / "results.jsonl",
            )
            if not all(path.is_file() for path in required):
                raise TaskctlError(
                    "partial start has no complete captured baseline; fail closed"
                )
            legacy_prefixes = self._bootstrap_legacy_prefixes()
            legacy_inventory = self._prepare_legacy_bundle_inventory(
                legacy_prefixes, recovery_started_ns=recovery_started_ns
            )
            legacy_bundle_sha = sha256_bytes(canonical_json(legacy_inventory))
        else:
            scope = self._load_scope_producer()
            try:
                prepared_baseline = scope.capture_material(
                    self.repo_root,
                    tuple(contract.allowlist),
                    self.task_id,
                )
            except Exception as exc:
                raise TaskctlError(f"baseline preparation failed: {exc}") from exc
        parameters = self._ordinary_start_parameters(
            contract,
            digest,
            selection_sha,
            (
                sha256_bytes(prepared_baseline[0])
                if prepared_baseline is not None
                else sha256_file(self.artifact / "baseline_allowlist.diff")
            ),
            (
                sha256_bytes(prepared_baseline[1])
                if prepared_baseline is not None
                else sha256_file(self.artifact / "baseline_external_files.txt")
            ),
            legacy_prefixes=legacy_prefixes,
            legacy_bundle_sha256=legacy_bundle_sha,
        )
        self._assert_start_request(parameters)

        def start_effect() -> None:
            self._reconcile_atomic_temporaries(recovery_started_ns)
            baseline, installed_legacy = self._initialize_new_bundle(
                contract,
                prepared_legacy_inventory=legacy_inventory,
                legacy_prefixes=legacy_prefixes,
                prepared_baseline=prepared_baseline,
            )
            if installed_legacy is not None:
                self.events.adopt_legacy_views(legacy_prefixes)
                baseline["legacy_prefix_sha256"] = sha256_file(
                    self.artifact / "legacy-prefix.json"
                )
            state = {
                "schema_version": 2,
                "task_id": self.task_id,
                "state": "IMPLEMENTING",
                "controller": self.actor,
                "implementer": self.implementer,
                "task_file": contract.task_path,
                "allowlist": list(contract.allowlist),
                "governance_digest": digest,
                "governance_inputs": inputs,
                "governance_rule_owners": manifest["rule_owners"],
                "selected_modules": selected,
                "module_selection_sha256": selection_sha,
                "baseline": baseline,
                "review_generation": 0,
                "review_leases": {},
                "reviews": {},
            }
            selection_path = self.artifact / "module_selection.json"
            if (
                selection_path.exists()
                and selection_path.read_bytes() != selection_content
            ):
                raise TaskctlError("module selection changed during start")
            if not selection_path.exists():
                atomic_write(selection_path, selection_content)
            self._cas_write_state(state, None, lock_held=True)

        return self._transition(
            "start",
            parameters,
            start_effect,
            lambda: self.state_path.is_file()
            and self._state().get("task_file") == contract.task_path
            and self._state().get("controller") == self.actor
            and self._state().get("implementer") == self.implementer,
            lock_held=True,
            legacy_prefixes=legacy_prefixes,
        )

    def _log_path(self, step: str) -> Path:
        safe_step = re.sub(r"[^A-Za-z0-9_.-]+", "_", step)
        return self.artifact / "outputs" / f"{time.time_ns()}_{safe_step}.log"

    def _reconcile_incomplete_before_new_action(self, *, lock_held: bool) -> None:
        ordinal = self.events.first_incomplete()
        if ordinal is None:
            return
        command = self.events._load_event(ordinal, "command")
        if command.get("replay_safe") is True:
            raise TaskctlError(
                "RECOVERABLE_INTERNAL: retry the exact action for command ordinal "
                f"{ordinal} ({command.get('step')})"
            )
        state = self._state()
        if state.get("state") != "BLOCKED" or state.get("reason") != "OUTCOME_UNKNOWN":
            expected_state_hash = sha256_file(self.state_path)
            state["state"] = "BLOCKED"
            state["reason"] = "OUTCOME_UNKNOWN"
            state["first_incomplete_ordinal"] = ordinal
            self._cas_write_state(state, expected_state_hash, lock_held=lock_held)
        raise TaskctlError(f"OUTCOME_UNKNOWN: command ordinal {ordinal} has no result")

    def record(self, step: str, argv: Sequence[str], cwd: Path) -> dict[str, Any]:
        with self.events.lease(
            owner=f"record:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            return self._record_locked(step, argv, cwd)

    def _record_locked(
        self, step: str, argv: Sequence[str], cwd: Path
    ) -> dict[str, Any]:
        state = self._state()
        self._assert_state_binding(state)
        if self.actor != state.get("controller"):
            raise TaskctlError("only the recorded controller may record evidence")
        if state.get("state") != "IMPLEMENTING":
            raise TaskctlError("record requires IMPLEMENTING state")
        self._reconcile_incomplete_before_new_action(lock_held=True)
        classification = classify_record(self.task_id, step, argv)
        if (
            self.task_id == GVR3_ID
            and step in GVR3_REQUIRED_COMMANDS
            and cwd.resolve() != self.repo_root
        ):
            raise TaskctlError("GVR-3 frozen evidence must run at repository root")
        log_path = self._log_path(step)
        execution_argv = list(argv)
        execution_env: dict[str, str] | None = None
        if (
            classification == "NON_SQLITE"
            and self.task_id == GVR3_ID
            and (
                execution_argv == list(GVR3_LEGACY_RED_ARGV)
                or execution_argv == list(GVR3_COMPILE_ARGV)
            )
        ):
            execution_env = os.environ.copy()
            for name in (
                "PYTHONHOME",
                "PYTHONPATH",
                "PYTHONSTARTUP",
                "PYTHONUSERBASE",
            ):
                execution_env.pop(name, None)
            execution_env["PYTHONNOUSERSITE"] = "1"
        elif classification == "NON_SQLITE" and execution_argv[0] == "git":
            execution_env = os.environ.copy()
            for name in tuple(execution_env):
                if name in {
                    "GIT_DIFF_OPTS",
                    "GIT_EXEC_PATH",
                    "GIT_EXTERNAL_DIFF",
                    "GIT_CONFIG_PARAMETERS",
                } or name.startswith("GIT_CONFIG_"):
                    execution_env.pop(name, None)
            execution_env["GIT_OPTIONAL_LOCKS"] = "0"
            git_prefix = [
                "git",
                "-c",
                "core.fsmonitor=false",
                "-c",
                "core.hooksPath=/dev/null",
            ]
            if len(execution_argv) >= 2 and execution_argv[1] == "diff":
                execution_argv = [
                    *git_prefix,
                    "diff",
                    "--no-ext-diff",
                    "--no-textconv",
                    *execution_argv[2:],
                ]
            else:
                execution_argv = [*git_prefix, *execution_argv[1:]]
        elif classification == "NON_SQLITE" and execution_argv[0] == "bash":
            execution_env = os.environ.copy()
            execution_env.pop("BASH_ENV", None)
            execution_env.pop("ENV", None)
        if classification in {"SCOPE", "FROZEN_V1"}:
            if cwd.resolve() != self.repo_root:
                raise TaskctlError(
                    "controlled evidence commands must run at repository root"
                )
            script_path = self.repo_root / execution_argv[1]
            if script_path.is_symlink() or not script_path.is_file():
                raise TaskctlError("controlled evidence runner is missing or unsafe")
            execution_argv = [sys.executable, *execution_argv[1:]]
            execution_env = os.environ.copy()
            for name in (
                "PYTHONHOME",
                "PYTHONPATH",
                "PYTHONSTARTUP",
                "PYTHONUSERBASE",
            ):
                execution_env.pop(name, None)
            execution_env["PYTHONNOUSERSITE"] = "1"

        def runner() -> dict[str, object]:
            log_path.parent.mkdir(parents=True, exist_ok=True)
            try:
                with log_path.open("wb") as output:
                    process = subprocess.run(
                        execution_argv,
                        cwd=cwd,
                        env=execution_env,
                        stdout=output,
                        stderr=subprocess.STDOUT,
                        check=False,
                    )
                return {
                    "rc": process.returncode,
                    "executed": True,
                    "log": str(log_path.relative_to(self.repo_root)),
                }
            except FileNotFoundError as exc:
                atomic_write(log_path, f"{exc}\n".encode("utf-8"))
                return {
                    "rc": 127,
                    "executed": False,
                    "log": str(log_path.relative_to(self.repo_root)),
                }

        return self.events.run(
            step=step,
            argv=argv,
            cwd=cwd,
            classification=classification,
            runner=runner,
            lock_held=True,
        )

    def _sqlite_lock(self) -> Path:
        digest = sha256_bytes(str(self.repo_root).encode("utf-8"))[:16]
        directory = Path(tempfile.gettempdir()) / f"fpms-taskctl-{digest}"
        if directory.exists() and (directory.is_symlink() or not directory.is_dir()):
            raise TaskctlError("unsafe SQLite lock directory")
        directory.mkdir(mode=0o700, exist_ok=True)
        directory.chmod(0o700)
        return directory / "sqlite.lock"

    def backend_test(self, mode: str, pytest_args: Sequence[str]) -> dict[str, Any]:
        if mode not in {"red", "test"} or not pytest_args:
            raise TaskctlError("backend-test requires red|test and pytest arguments")
        with self.events.lease(
            owner=f"backend-test:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            return self._backend_test_locked(mode, pytest_args)

    def _backend_test_locked(
        self, mode: str, pytest_args: Sequence[str]
    ) -> dict[str, Any]:
        state = self._state()
        self._assert_state_binding(state)
        if self.actor != state.get("controller"):
            raise TaskctlError("only the recorded controller may run backend tests")
        if state.get("state") != "IMPLEMENTING":
            raise TaskctlError("backend-test requires IMPLEMENTING state")
        if self.task_id == GVR3_ID:
            raise TaskctlError(
                "GVR-3 test evidence requires the exact frozen record argv"
            )
        self._reconcile_incomplete_before_new_action(lock_held=True)
        pytest = self.repo_root / "backend/.venv/bin/pytest"
        argv = [str(pytest), *pytest_args]
        log_path = self._log_path(mode)

        def runner() -> dict[str, object]:
            process_started = False
            try:
                with LockLease(
                    self._sqlite_lock(), owner=f"{self.task_id}:{os.getpid()}"
                ):
                    if not pytest.is_file():
                        atomic_write(log_path, b"pytest executable is missing\n")
                        return {
                            "rc": 127,
                            "executed": False,
                            "reason": "pytest_missing",
                            "log": str(log_path.relative_to(self.repo_root)),
                        }
                    with log_path.open("wb") as output:
                        process_started = True
                        process = subprocess.run(
                            argv,
                            cwd=self.repo_root / "backend",
                            stdout=output,
                            stderr=subprocess.STDOUT,
                            check=False,
                        )
                    return {
                        "rc": process.returncode,
                        "executed": True,
                        "log": str(log_path.relative_to(self.repo_root)),
                        "expectation": "nonzero" if mode == "red" else "zero",
                        "expectation_met": (
                            process.returncode == 1
                            if mode == "red"
                            else process.returncode == 0
                        ),
                    }
            except (TaskctlError, OSError) as exc:
                atomic_write(log_path, f"{exc}\n".encode("utf-8"))
                return {
                    "rc": 125,
                    "executed": process_started,
                    "reason": (
                        "sidecar_cleanup_failed"
                        if isinstance(exc, LeaseCleanupError)
                        else "sqlite_lock_contention"
                    ),
                    "log": str(log_path.relative_to(self.repo_root)),
                }

        return self.events.run(
            step=mode,
            argv=argv,
            cwd=self.repo_root / "backend",
            classification="SQLITE",
            runner=runner,
            lock_held=True,
        )

    def _required_results(self, *, activation: bool) -> dict[str, dict[str, str]]:
        required = (
            tuple(GVR3_REQUIRED_COMMANDS) if activation else ("lint", "test", "scope")
        )
        bound: dict[str, dict[str, str]] = {}
        for step in required:
            result, result_path = self.events.latest_result(step)
            if result.get("rc") != 0:
                raise TaskctlError(f"latest required result is nonzero: {step}")
            if activation:
                command = self.events._load_event(result["ordinal"], "command")
                expected_argv, expected_classification = GVR3_REQUIRED_COMMANDS[step]
                if (
                    command.get("argv") != list(expected_argv)
                    or command.get("cwd") != str(self.repo_root)
                    or command.get("classification") != expected_classification
                    or command.get("replay_safe") is not False
                    or result.get("executed") is not True
                ):
                    raise TaskctlError(
                        f"GVR-3 required result is not bound to its exact frozen "
                        f"command: {step}"
                    )
            log_value = result.get("log")
            if not isinstance(log_value, str) or not log_value:
                raise TaskctlError(f"required result has no log: {step}")
            log_relative = _safe_relative(log_value, f"required result {step} log")
            if not log_relative.startswith(f"artifacts/{self.task_id}/outputs/"):
                raise TaskctlError(
                    f"required result log is outside task outputs: {step}"
                )
            log_path, canonical_log = _repo_file_path(
                self.repo_root / log_relative,
                self.repo_root,
                f"required result {step} log",
            )
            if canonical_log != log_relative:
                raise TaskctlError(f"required result log is non-canonical: {step}")
            bound[step] = {
                "result_sha256": sha256_file(result_path),
                "log_sha256": sha256_file(log_path),
            }
        return bound

    def _candidate_inputs(
        self,
        state: dict[str, Any],
        *,
        kernel: Path | None,
        manifest: Path | None,
        allow_activation_partial: bool = False,
    ) -> dict[str, Any]:
        self._assert_state_binding(state)
        activation = self.task_id == GVR3_ID
        if activation != (kernel is not None and manifest is not None):
            if activation:
                raise TaskctlError("GVR-3 prepare-review requires kernel and manifest")
            raise TaskctlError("ordinary prepare-review forbids candidate parameters")
        contract = self._contract()
        task_path = self.repo_root / contract.task_path
        summary = self.artifact / "summary.md"
        patch = self.artifact / "git/diff.patch"
        for required_path in (task_path, summary, patch):
            if not required_path.is_file():
                raise TaskctlError(f"missing candidate input: {required_path}")
        required_results = self._required_results(activation=activation)
        governance = state.get("governance_digest")
        if not isinstance(governance, str) or not HEX_PATTERN.fullmatch(governance):
            raise TaskctlError("state governance digest is invalid")
        scoped_patch = patch.read_bytes()
        live_patch = self._live_scope_patch()
        patch_material = scoped_patch
        source_hashes: dict[str, Any] = {}
        if activation:
            assert kernel is not None and manifest is not None
            kernel, _ = _repo_file_path(kernel, self.repo_root, "candidate kernel")
            manifest, _ = _repo_file_path(
                manifest, self.repo_root, "candidate manifest"
            )
            bootstrap = state.get("bootstrap")
            if not isinstance(bootstrap, dict):
                raise TaskctlError("GVR-3 is missing bootstrap binding")
            if (
                str(kernel.resolve()) != bootstrap.get("kernel_path")
                or str(manifest.resolve()) != bootstrap.get("manifest_path")
                or sha256_file(kernel) != bootstrap.get("kernel_sha256")
                or sha256_file(manifest) != bootstrap.get("manifest_sha256")
            ):
                raise TaskctlError("prepare-review candidates differ from bootstrap")
            existing_candidate = state.get("candidate")
            existing_sources = (
                existing_candidate.get("source_hashes", {})
                if isinstance(existing_candidate, dict)
                else {}
            )
            source_hashes = {
                "kernel_sha256": sha256_file(kernel),
                "manifest_sha256": sha256_file(manifest),
                "pre_root_sha256": existing_sources.get(
                    "pre_root_sha256",
                    (
                        sha256_file(self.repo_root / "AGENTS.md")
                        if (self.repo_root / "AGENTS.md").is_file()
                        else None
                    ),
                ),
                "pre_manifest_sha256": existing_sources.get(
                    "pre_manifest_sha256",
                    (
                        sha256_file(self.repo_root / "docs/agents/manifest.json")
                        if (self.repo_root / "docs/agents/manifest.json").is_file()
                        else None
                    ),
                ),
            }
            patch_material = self._virtual_candidate_patch(
                patch_material, kernel, manifest
            )
        expected_live_patch = (
            patch_material
            if activation and isinstance(state.get("activation"), dict)
            else scoped_patch
        )
        partial_safe = False
        if activation and allow_activation_partial:
            root_path = self.repo_root / "AGENTS.md"
            manifest_path = self.repo_root / "docs/agents/manifest.json"
            root_hash = sha256_file(root_path) if root_path.is_file() else None
            manifest_hash = (
                sha256_file(manifest_path) if manifest_path.is_file() else None
            )
            root_safe = root_hash in {
                source_hashes.get("pre_root_sha256"),
                source_hashes.get("kernel_sha256"),
            }
            manifest_safe = manifest_hash in {
                source_hashes.get("pre_manifest_sha256"),
                source_hashes.get("manifest_sha256"),
            }
            ordering_safe = manifest_hash != source_hashes.get(
                "manifest_sha256"
            ) or root_hash == source_hashes.get("kernel_sha256")
            partial_safe = root_safe and manifest_safe and ordering_safe
        if live_patch != expected_live_patch and not partial_safe:
            raise TaskctlError(
                "stored scoped patch differs from current allowlisted bytes"
            )
        values: dict[str, Any] = {
            "task_sha256": sha256_file(task_path),
            "summary_sha256": sha256_file(summary),
            "scoped_patch_sha256": sha256_bytes(patch_material),
            "patch_sha256": sha256_bytes(patch_material),
            "governance_digest": governance,
            "baseline": state.get("baseline", {}),
            "required_results": required_results,
            "source_hashes": source_hashes,
        }
        values["fingerprint"] = _canonical_digest(values)
        return values

    def _virtual_candidate_patch(
        self, scoped_patch: bytes, kernel: Path, manifest: Path
    ) -> bytes:
        if scoped_patch != (self.artifact / "git/diff.patch").read_bytes():
            raise TaskctlError("scoped patch changed during candidate preparation")
        scope = self._load_scope_producer()
        try:
            material = scope.preview_with_replacements(
                self.task_id,
                {
                    "AGENTS.md": kernel.read_bytes(),
                    "docs/agents/manifest.json": manifest.read_bytes(),
                },
                root=self.repo_root,
            )
        except Exception as exc:
            raise TaskctlError(f"virtual scope preview failed: {exc}") from exc
        virtual_path = self.artifact / "candidate/virtual.patch"
        if virtual_path.exists():
            if virtual_path.read_bytes() != material:
                if self._state().get("state") == "IMPLEMENTING":
                    atomic_write(virtual_path, material, mode=0o644)
                return material
            return material
        atomic_write(virtual_path, material, mode=0o644)
        return material

    def prepare_review(
        self,
        *,
        kernel: Path | None = None,
        manifest: Path | None = None,
    ) -> dict[str, Any]:
        with self.events.lease(
            owner=f"prepare-review:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            return self._prepare_review_locked(kernel=kernel, manifest=manifest)

    @staticmethod
    def _prepare_parameters(
        kernel: Path | None,
        manifest: Path | None,
        candidate: dict[str, Any],
        generation: int,
    ) -> list[str]:
        parameters = ["prepare-review"]
        if kernel is not None and manifest is not None:
            parameters.extend(
                [
                    "--kernel",
                    str(kernel.resolve()),
                    "--manifest",
                    str(manifest.resolve()),
                ]
            )
        parameters.extend(
            [
                "--candidate-fingerprint",
                str(candidate["fingerprint"]),
                "--review-generation",
                str(generation),
            ]
        )
        return parameters

    def _prepare_review_locked(
        self,
        *,
        kernel: Path | None = None,
        manifest: Path | None = None,
    ) -> dict[str, Any]:
        state = self._state()
        contract = self._assert_state_binding(state)
        if self.actor != state.get("controller"):
            raise TaskctlError("only the recorded controller may prepare review")
        incomplete = self.events.first_incomplete()
        incomplete_command: dict[str, Any] | None = None
        if incomplete is not None:
            incomplete_command = self.events._load_event(incomplete, "command")
        own_incomplete = (
            incomplete is not None
            and incomplete_command is not None
            and incomplete_command.get("step") == "taskctl_prepare_review"
            and incomplete_command.get("classification") == "INTERNAL"
            and incomplete_command.get("replay_safe") is True
        )
        if (
            own_incomplete
            and state.get("state") == "READY_FOR_REVIEW"
            and isinstance(state.get("candidate"), dict)
        ):
            self._transition(
                "prepare_review",
                list(incomplete_command["argv"]),
                lambda: None,
                lambda: self.state_path.is_file()
                and self._state().get("state") == "READY_FOR_REVIEW"
                and self._state().get("candidate") == state["candidate"]
                and self._state().get("review_generation")
                == state.get("review_generation"),
                lock_held=True,
            )
            state = self._state()
            incomplete = None
            incomplete_command = None
            own_incomplete = False
        elif own_incomplete and state.get("state") == "IMPLEMENTING":
            try:
                governance_matches = self._governance_matches_state(state, contract)
            except TaskctlError:
                governance_matches = False
            if not governance_matches:
                assert incomplete is not None
                self.events.supersede_incomplete_internal(
                    incomplete, reason="governance_changed_before_prepare_effect"
                )
                incomplete = None
                incomplete_command = None
                own_incomplete = False
        self._ensure_governance_current(state, contract, lock_held=True)
        if state.get("state") == "READY_FOR_REVIEW" and isinstance(
            state.get("candidate"), dict
        ):
            generation = state.get("review_generation")
            if type(generation) is not int or generation <= 0:
                raise TaskctlError("review generation is invalid")
            try:
                current = self._candidate_inputs(
                    state, kernel=kernel, manifest=manifest
                )
            except TaskctlError:
                self._invalidate_candidate(
                    state, "CANDIDATE_INPUT_CHANGED", lock_held=True
                )
                raise
            if current != state["candidate"]:
                self._invalidate_candidate(
                    state, "CANDIDATE_INPUT_CHANGED", lock_held=True
                )
                raise TaskctlError("candidate changed after prepare-review")
            parameters = self._prepare_parameters(kernel, manifest, current, generation)
            return self._transition(
                "prepare_review",
                parameters,
                lambda: None,
                lambda: self.state_path.is_file()
                and self._state().get("state") == "READY_FOR_REVIEW"
                and self._state().get("candidate") == current
                and self._state().get("review_generation") == generation,
                lock_held=True,
            )["candidate"]
        if state.get("state") != "IMPLEMENTING":
            raise TaskctlError("prepare-review requires IMPLEMENTING state")
        if incomplete is not None and not own_incomplete:
            self._reconcile_incomplete_before_new_action(lock_held=True)
        expected_state_hash = sha256_file(self.state_path)
        try:
            candidate = self._candidate_inputs(state, kernel=kernel, manifest=manifest)
        except TaskctlError:
            if own_incomplete and incomplete is not None:
                self.events.supersede_incomplete_internal(
                    incomplete, reason="prepare_inputs_unavailable_before_effect"
                )
            raise
        generation = state["review_generation"] + 1

        def effect() -> None:
            state["candidate"] = candidate
            state["review_generation"] = generation
            state["review_leases"] = {}
            state["reviews"] = {}
            state["state"] = "READY_FOR_REVIEW"
            state.pop("reason", None)
            self._cas_write_state(state, expected_state_hash, lock_held=True)

        parameters = self._prepare_parameters(kernel, manifest, candidate, generation)
        if (
            own_incomplete
            and incomplete is not None
            and incomplete_command is not None
            and incomplete_command.get("argv") != parameters
        ):
            self.events.supersede_incomplete_internal(
                incomplete, reason="prepare_inputs_changed_before_effect"
            )
        final_state = self._transition(
            "prepare_review",
            parameters,
            effect,
            lambda: self.state_path.is_file()
            and self._state().get("state") == "READY_FOR_REVIEW"
            and self._state().get("candidate") == candidate
            and self._state().get("review_generation") == generation,
            lock_held=True,
        )
        return final_state["candidate"]

    def _allowed_axes(self) -> tuple[str, ...]:
        return (
            ("governance", "tooling") if self.task_id == GVR3_ID else ("independent",)
        )

    def review_lease(self, axis: str, reviewer: str) -> dict[str, Any]:
        with self.events.lease(
            owner=f"review-lease:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            return self._review_lease_locked(axis, reviewer)

    def _review_lease_locked(self, axis: str, reviewer: str) -> dict[str, Any]:
        if axis not in self._allowed_axes() or not _valid_reviewer_identity(reviewer):
            raise TaskctlError("invalid review axis or reviewer")
        state = self._state()
        self._assert_state_binding(state)
        if state.get("state") != "READY_FOR_REVIEW":
            raise TaskctlError("review lease requires READY_FOR_REVIEW")
        expected_state_hash = sha256_file(self.state_path)
        if self.actor != state.get("controller"):
            raise TaskctlError("only the recorded controller may grant review lease")
        if reviewer == state.get("implementer"):
            raise TaskctlError("implementer cannot review its own task")
        leases = state.setdefault("review_leases", {})
        if not isinstance(leases, dict):
            raise TaskctlError("invalid review lease state")
        for other_axis, lease in leases.items():
            if (
                other_axis != axis
                and isinstance(lease, dict)
                and lease.get("reviewer") == reviewer
            ):
                raise TaskctlError("review axes require distinct reviewer identities")
        existing = leases.get(axis)
        candidate = state.get("candidate")
        if not isinstance(candidate, dict):
            raise TaskctlError("review candidate is missing")
        generation = state.get("review_generation")
        if type(generation) is not int or generation <= 0:
            raise TaskctlError("review generation is invalid")
        lease = {
            "axis": axis,
            "reviewer": reviewer,
            "candidate_fingerprint": candidate.get("fingerprint"),
            "review_generation": generation,
            "issued_ns": time.time_ns(),
        }
        parameters = [
            "review",
            "lease",
            axis,
            "--reviewer",
            reviewer,
            "--candidate-fingerprint",
            str(candidate["fingerprint"]),
            "--review-generation",
            str(generation),
        ]
        if existing is not None:
            if not isinstance(existing, dict) or any(
                existing.get(key) != lease.get(key)
                for key in (
                    "axis",
                    "reviewer",
                    "candidate_fingerprint",
                    "review_generation",
                )
            ):
                raise TaskctlError("review axis already has a different lease")
            return self._transition(
                "review_lease",
                parameters,
                lambda: None,
                lambda: self.state_path.is_file()
                and self._state().get("review_leases", {}).get(axis) == existing,
                lock_held=True,
            )["review_leases"][axis]

        def effect() -> None:
            leases[axis] = lease
            self._cas_write_state(state, expected_state_hash, lock_held=True)

        final_state = self._transition(
            "review_lease",
            parameters,
            effect,
            lambda: self.state_path.is_file()
            and self._state().get("review_leases", {}).get(axis, {}).get("reviewer")
            == reviewer
            and self._state()
            .get("review_leases", {})
            .get(axis, {})
            .get("review_generation")
            == generation,
            lock_held=True,
        )
        return final_state["review_leases"][axis]

    def _expected_report(self, axis: str) -> Path:
        name = "independent_review.md" if axis == "independent" else f"{axis}_axis.md"
        return self.artifact / "review" / name

    def review_submit(self, axis: str, report: Path) -> dict[str, str]:
        with self.events.lease(
            owner=f"review-submit:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            return self._review_submit_locked(axis, report)

    def _review_submit_locked(self, axis: str, report: Path) -> dict[str, str]:
        if axis not in self._allowed_axes():
            raise TaskctlError("invalid review axis")
        state = self._state()
        self._assert_state_binding(state)
        if state.get("state") != "READY_FOR_REVIEW":
            raise TaskctlError("review submit requires READY_FOR_REVIEW")
        expected_state_hash = sha256_file(self.state_path)
        report_file, _ = _repo_file_path(report, self.repo_root, "review report")
        if report_file != self._expected_report(axis):
            raise TaskctlError("review report path is not canonical")
        report = report_file
        leases = state.get("review_leases")
        if not isinstance(leases, dict) or not isinstance(leases.get(axis), dict):
            raise TaskctlError("review axis has no active lease")
        lease = leases[axis]
        if self.actor != lease.get("reviewer"):
            raise TaskctlError("only the leased reviewer identity may submit this axis")
        candidate = state.get("candidate")
        if not isinstance(candidate, dict) or lease.get(
            "candidate_fingerprint"
        ) != candidate.get("fingerprint"):
            raise TaskctlError("review lease is stale")
        generation = state.get("review_generation")
        if (
            type(generation) is not int
            or generation <= 0
            or lease.get("review_generation") != generation
            or type(lease.get("issued_ns")) is not int
        ):
            raise TaskctlError("review lease generation is stale")
        reviews = state.setdefault("reviews", {})
        if not isinstance(reviews, dict):
            raise TaskctlError("invalid review state")
        existing = reviews.get(axis)
        used = {
            value.get("reviewer")
            for name, value in reviews.items()
            if name != axis
            and isinstance(value, dict)
            and isinstance(value.get("reviewer"), str)
        }
        try:
            submission = report.read_bytes()
            submission_text = submission.decode("utf-8")
        except (OSError, UnicodeError) as exc:
            raise TaskctlError(f"cannot read review submission: {exc}") from exc
        triple_lines = (
            f"Reviewed-Candidate-Fingerprint: {candidate['fingerprint']}\n"
            f"Reviewed-Patch-SHA256: {candidate['patch_sha256']}\n"
            f"Reviewed-Governance-Digest: {candidate['governance_digest']}\n"
        ).encode("utf-8")
        if submission.startswith(triple_lines):
            raw_submission = submission[len(triple_lines) :]
            bound_report = submission
            fields = validate_review(
                report,
                candidate,
                expected_reviewer=str(lease.get("reviewer")),
                implementer=str(state.get("implementer")),
                used_reviewers=used,
            )
        else:
            if any(
                line.startswith("Reviewed-") for line in submission_text.splitlines()
            ):
                raise TaskctlError(
                    "reviewer must not prefill controller binding fields"
                )
            submission_fields = _parse_fields(
                report, ("Reviewer-ID", "Verdict", "P0", "P1", "P2")
            )
            if (
                not _valid_reviewer_identity(submission_fields["Reviewer-ID"])
                or submission_fields["Reviewer-ID"] != lease.get("reviewer")
                or submission_fields["Reviewer-ID"] == state.get("implementer")
                or submission_fields["Reviewer-ID"] in used
                or submission_fields["Verdict"] != "APPROVED"
                or any(submission_fields[level] != "0" for level in ("P0", "P1", "P2"))
            ):
                raise TaskctlError("review submission is not an independent approval")
            if raw_submission := submission:
                if not raw_submission.endswith(b"\n"):
                    raw_submission += b"\n"
            bound_report = triple_lines + raw_submission
            fields = {
                "Reviewed-Candidate-Fingerprint": str(candidate["fingerprint"]),
                "Reviewed-Patch-SHA256": str(candidate["patch_sha256"]),
                "Reviewed-Governance-Digest": str(candidate["governance_digest"]),
                **submission_fields,
            }
        submission_sha256 = sha256_bytes(raw_submission)
        bound_sha256 = sha256_bytes(bound_report)
        parameters = [
            "review",
            "submit",
            axis,
            "--report",
            str(report.resolve()),
            "--submission-sha256",
            submission_sha256,
            "--report-sha256",
            bound_sha256,
            "--review-generation",
            str(generation),
            "--lease-issued-ns",
            str(lease["issued_ns"]),
        ]
        if submission.startswith(triple_lines) and existing is None:
            incomplete = self.events.first_incomplete()
            matching_partial = incomplete is not None and (
                self.events._load_event(incomplete, "command").get("step")
                == "taskctl_review_submit"
                and self.events._load_event(incomplete, "command").get("argv")
                == parameters
            )
            if not matching_partial:
                raise TaskctlError(
                    "reviewer must submit unbound fields; taskctl owns the hash triple"
                )
        receipt = {
            "axis": axis,
            "reviewer": fields["Reviewer-ID"],
            "report": str(report.resolve()),
            "submission_sha256": submission_sha256,
            "report_sha256": bound_sha256,
            "candidate_fingerprint": candidate["fingerprint"],
            "review_generation": generation,
        }
        if existing is not None and existing != receipt:
            raise TaskctlError("submitted review changed")

        def effect() -> None:
            atomic_write(report, bound_report, mode=0o644)
            reviews[axis] = receipt
            self._cas_write_state(state, expected_state_hash, lock_held=True)

        self._transition(
            "review_submit",
            parameters,
            effect,
            lambda: self.state_path.is_file()
            and self._state().get("reviews", {}).get(axis) == receipt
            and report.is_file()
            and sha256_file(report) == bound_sha256,
            lock_held=True,
        )
        return fields

    def _validate_submitted_reviews(self, state: dict[str, Any]) -> None:
        self._assert_state_binding(state)
        candidate = state.get("candidate")
        leases = state.get("review_leases")
        reviews = state.get("reviews")
        if (
            not isinstance(candidate, dict)
            or not isinstance(leases, dict)
            or not isinstance(reviews, dict)
        ):
            raise TaskctlError("review state is incomplete")
        used: set[str] = set()
        generation = state.get("review_generation")
        if type(generation) is not int or generation <= 0:
            raise TaskctlError("review generation is invalid")
        for axis in self._allowed_axes():
            lease = leases.get(axis)
            receipt = reviews.get(axis)
            if not isinstance(lease, dict) or not isinstance(receipt, dict):
                raise TaskctlError(f"missing submitted review axis: {axis}")
            if (
                lease.get("review_generation") != generation
                or receipt.get("review_generation") != generation
            ):
                raise TaskctlError(f"stale submitted review generation: {axis}")
            report = self._expected_report(axis)
            if sha256_file(report) != receipt.get("report_sha256"):
                raise TaskctlError(f"review report changed after submit: {axis}")
            fields = validate_review(
                report,
                candidate,
                expected_reviewer=str(lease.get("reviewer")),
                implementer=str(state.get("implementer")),
                used_reviewers=used,
            )
            used.add(fields["Reviewer-ID"])

    def governance_adopt(self, approval: Path) -> dict[str, Any]:
        with self.events.lease(
            owner=f"governance-adopt:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            return self._governance_adopt_locked(approval)

    def _governance_adopt_locked(self, approval: Path) -> dict[str, Any]:
        state = self._state()
        contract = self._assert_state_binding(state, allow_selection_mismatch=True)
        if self.actor != state.get("controller"):
            raise TaskctlError("only the recorded controller may adopt governance")
        incomplete = self.events.first_incomplete()
        if state.get("governance_change_report_pending") is not None or (
            incomplete is not None
            and self.events._load_event(incomplete, "command").get("step")
            == "taskctl_governance_change"
        ):
            self._ensure_governance_current(state, contract, lock_held=True)
        approval_file, _ = _repo_file_path(
            approval, self.repo_root, "governance adoption approval"
        )
        canonical_approval = self.artifact / "governance_adoption.md"
        if approval_file != canonical_approval:
            raise TaskctlError("governance adoption approval path is not canonical")

        try:
            approval_bytes = approval_file.read_bytes()
            approval_text = approval_bytes.decode("utf-8")
        except (OSError, UnicodeError) as exc:
            raise TaskctlError(
                f"cannot read governance adoption approval: {exc}"
            ) from exc
        approval_sha256 = sha256_bytes(approval_bytes)

        def approval_unchanged() -> bool:
            try:
                return approval_file.read_bytes() == approval_bytes
            except OSError:
                return False

        adoption = state.get("governance_adoption")
        if state.get("state") == "IMPLEMENTING" and isinstance(adoption, dict):
            if adoption.get("approval_path") != str(canonical_approval) or adoption.get(
                "approval_sha256"
            ) != sha256_file(canonical_approval):
                raise TaskctlError("governance adoption approval binding changed")
            if self.task_id == GVR3_ID:
                bootstrap = state.get("bootstrap")
                if not isinstance(bootstrap, dict):
                    raise TaskctlError("bootstrap governance binding is missing")
                manifest = load_json(
                    Path(str(bootstrap.get("manifest_path", ""))),
                    "bootstrap manifest",
                )
            else:
                manifest = load_json(
                    self.repo_root / "docs/agents/manifest.json",
                    "active governance manifest",
                )
            selection_content = canonical_json(
                module_selection_record(
                    manifest, contract, str(state.get("governance_digest"))
                )
            )
            if sha256_bytes(selection_content) != state.get("module_selection_sha256"):
                raise TaskctlError("adopted module selection binding is invalid")
            selection_path = self.artifact / "module_selection.json"
            if (
                not selection_path.is_file()
                or selection_path.read_bytes() != selection_content
            ):
                atomic_write(selection_path, selection_content)
            parameters = [
                "governance-adopt",
                "--approval",
                str(canonical_approval),
                "--approval-sha256",
                adoption["approval_sha256"],
                "--change-sha256",
                str(adoption.get("change_sha256", "")),
                "--change-file-sha256",
                str(adoption.get("change_file_sha256", "")),
            ]
            return self._transition(
                "governance_adopt",
                parameters,
                lambda: None,
                lambda: self.state_path.is_file()
                and self._state().get("state") == "IMPLEMENTING"
                and self._state().get("governance_adoption") == adoption,
                lock_held=True,
            )
        if (
            state.get("state") != "BLOCKED"
            or state.get("reason") != "GOVERNANCE_DIGEST_MISMATCH"
        ):
            raise TaskctlError(
                "governance-adopt requires digest-mismatch BLOCKED state"
            )
        expected_state_hash = sha256_file(self.state_path)
        change = self._validated_governance_change(state)
        change_path = self.artifact / "governance_change.json"
        change_file_sha256 = sha256_file(change_path)
        fields = _parse_fields_text(
            approval_text,
            ("Reviewed-Change-SHA256", "Reviewer-ID", "Verdict", "P0", "P1", "P2"),
        )
        if not approval_unchanged():
            raise TaskctlError("governance adoption approval changed after parsing")
        if (
            fields["Reviewed-Change-SHA256"] != change.get("change_sha256")
            or not _valid_reviewer_identity(fields["Reviewer-ID"])
            or fields["Reviewer-ID"] == state.get("implementer")
            or fields["Verdict"] != "APPROVED"
            or any(fields[level] != "0" for level in ("P0", "P1", "P2"))
        ):
            raise TaskctlError("governance adoption approval is invalid")
        baseline_before = canonical_json(state.get("baseline", {}))
        if canonical_json(change.get("baseline_identity", {})) != baseline_before:
            raise TaskctlError("governance change is not bound to the task baseline")
        approved_inputs = change.get("observed_inputs")
        observed_owners = change.get("observed_rule_owners")
        selection = change.get("module_selection")
        if (
            not isinstance(approved_inputs, dict)
            or not isinstance(observed_owners, dict)
            or not isinstance(selection, dict)
            or not isinstance(selection.get("new"), list)
        ):
            raise TaskctlError("governance change inventory is incomplete")
        if self.task_id == GVR3_ID:
            bootstrap = state.get("bootstrap")
            if not isinstance(bootstrap, dict):
                raise TaskctlError("bootstrap governance binding is missing")
            manifest = load_json(
                Path(str(bootstrap.get("manifest_path", ""))), "bootstrap manifest"
            )
            observed_digest, observed_inputs = governance_digest(
                self.repo_root,
                Path(str(bootstrap.get("kernel_path", ""))),
                manifest,
            )
        else:
            manifest, observed_digest, _selected, observed_inputs = (
                self._active_context(contract)
            )
        if (
            observed_digest != change.get("new")
            or observed_inputs != approved_inputs
            or manifest.get("rule_owners") != observed_owners
        ):
            raise TaskctlError("governance adoption no longer matches observed inputs")
        selection_record = module_selection_record(manifest, contract, observed_digest)
        if selection_record["selected_modules"] != selection["new"]:
            raise TaskctlError("governance adoption module selection changed")
        selection_content = canonical_json(selection_record)
        state["governance_digest"] = change.get("new")
        state["governance_inputs"] = observed_inputs
        state["governance_rule_owners"] = observed_owners
        state["selected_modules"] = selection["new"]
        state["module_selection_sha256"] = sha256_bytes(selection_content)
        state["state"] = "IMPLEMENTING"
        state.pop("reason", None)
        state.pop("candidate", None)
        state["review_leases"] = {}
        state["reviews"] = {}
        state["governance_adoption"] = {
            "approval_path": str(canonical_approval),
            "approval_sha256": approval_sha256,
            "change_path": str(change_path),
            "change_sha256": change["change_sha256"],
            "change_file_sha256": change_file_sha256,
            "reviewer": fields["Reviewer-ID"],
        }
        if canonical_json(state.get("baseline", {})) != baseline_before:
            raise TaskctlError("governance adoption changed baseline identity")
        expected_digest = state["governance_digest"]

        def adoption_effect() -> None:
            if not approval_unchanged():
                raise TaskctlError(
                    "governance adoption approval changed before binding"
                )
            atomic_write(self.artifact / "module_selection.json", selection_content)
            if not approval_unchanged():
                raise TaskctlError(
                    "governance adoption approval changed before binding"
                )
            self._cas_write_state(state, expected_state_hash, lock_held=True)

        return self._transition(
            "governance_adopt",
            [
                "governance-adopt",
                "--approval",
                str(approval.resolve()),
                "--approval-sha256",
                state["governance_adoption"]["approval_sha256"],
                "--change-sha256",
                state["governance_adoption"]["change_sha256"],
                "--change-file-sha256",
                state["governance_adoption"]["change_file_sha256"],
            ],
            adoption_effect,
            lambda: self.state_path.is_file()
            and self._state().get("state") == "IMPLEMENTING"
            and self._state().get("governance_digest") == expected_digest,
            lock_held=True,
        )

    def _activation_fault(self, label: str) -> Fault:
        mapping = {
            "before_write": f"before_{label}_write",
            "after_write": f"after_{label}_write",
            "before_file_fsync": f"before_{label}_file_fsync",
            "after_file_fsync": f"after_{label}_file_fsync",
            "before_replace": f"before_{label}_replace",
            "after_replace": f"after_{label}_replace",
            "before_dir_fsync": f"before_{label}_dir_fsync",
            "after_dir_fsync": f"after_{label}_dir_fsync",
        }

        def callback(point: str) -> None:
            translated = mapping.get(point)
            if translated is not None:
                _fault(self.fault, translated)

        return callback

    def activate(self, kernel: Path, manifest: Path) -> dict[str, Any]:
        with self.events.lease(
            owner=f"activate:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            return self._activate_locked(kernel, manifest)

    def _activate_locked(self, kernel: Path, manifest: Path) -> dict[str, Any]:
        if self.task_id != GVR3_ID:
            raise TaskctlError("activate is restricted to GVR-3")
        state = self._state()
        contract = self._assert_state_binding(state)
        if self.actor != state.get("controller"):
            raise TaskctlError("only the recorded controller may activate governance")
        kernel, _ = _repo_file_path(kernel, self.repo_root, "activation kernel")
        manifest, _ = _repo_file_path(manifest, self.repo_root, "activation manifest")
        if state.get("state") not in {"READY_FOR_REVIEW", "GOVERNANCE_STAGED"}:
            raise TaskctlError("activate requires READY_FOR_REVIEW or staged recovery")
        expected_state_hash = sha256_file(self.state_path)
        self._validate_submitted_reviews(state)
        generation = state["review_generation"]
        bootstrap = state.get("bootstrap")
        candidate = state.get("candidate")
        if not isinstance(bootstrap, dict) or not isinstance(candidate, dict):
            raise TaskctlError("activation bindings are missing")
        self._ensure_governance_current(state, contract, lock_held=True)
        try:
            current_candidate = self._current_candidate(state)
        except TaskctlError:
            self._invalidate_candidate(state, "CANDIDATE_INPUT_CHANGED", lock_held=True)
            raise
        if current_candidate != candidate:
            self._invalidate_candidate(state, "CANDIDATE_INPUT_CHANGED", lock_held=True)
            raise TaskctlError("reviewed candidate changed before activation")
        if (
            str(kernel.resolve()) != bootstrap.get("kernel_path")
            or str(manifest.resolve()) != bootstrap.get("manifest_path")
            or sha256_file(kernel)
            != candidate.get("source_hashes", {}).get("kernel_sha256")
            or sha256_file(manifest)
            != candidate.get("source_hashes", {}).get("manifest_sha256")
        ):
            raise TaskctlError("activation bytes differ from reviewed candidate")
        source_hashes = candidate["source_hashes"]

        def installed_triple_matches() -> bool:
            active_root = self.repo_root / "AGENTS.md"
            active_manifest_path = self.repo_root / "docs/agents/manifest.json"
            if not active_root.is_file() or not active_manifest_path.is_file():
                return False
            try:
                active_manifest = load_json(active_manifest_path, "installed manifest")
                active_digest, _active_inputs = governance_digest(
                    self.repo_root, active_root, active_manifest
                )
            except TaskctlError:
                return False
            return (
                sha256_file(active_root) == source_hashes["kernel_sha256"]
                and sha256_file(active_manifest_path)
                == source_hashes["manifest_sha256"]
                and active_digest == candidate.get("governance_digest")
            )

        if state.get("state") == "GOVERNANCE_STAGED" and not installed_triple_matches():
            raise TaskctlError("staged installed governance no longer matches review")

        def effect() -> None:
            atomic_write(
                self.repo_root / "AGENTS.md",
                kernel.read_bytes(),
                fault=self._activation_fault("root"),
                mode=0o644,
            )
            _fault(self.fault, "before_root_staged_validation")
            root_is_candidate = (
                sha256_file(self.repo_root / "AGENTS.md")
                == source_hashes["kernel_sha256"]
            )
            try:
                self._active_context(contract)
            except TaskctlError:
                staged_is_closed = True
            else:
                staged_is_closed = False
            if (
                not root_is_candidate
                or not staged_is_closed
                or self._state().get("state") == "PASS"
            ):
                raise TaskctlError("root-first stage is not fail closed")
            _fault(self.fault, "after_root_staged_validation")
            atomic_write(
                self.repo_root / "docs/agents/manifest.json",
                manifest.read_bytes(),
                fault=self._activation_fault("manifest"),
                mode=0o644,
            )
            _fault(self.fault, "before_actual_hash_verification")
            actual_manifest = load_json(
                self.repo_root / "docs/agents/manifest.json", "installed manifest"
            )
            actual_digest, _inputs = governance_digest(
                self.repo_root, self.repo_root / "AGENTS.md", actual_manifest
            )
            if (
                sha256_file(self.repo_root / "AGENTS.md")
                != source_hashes["kernel_sha256"]
                or sha256_file(self.repo_root / "docs/agents/manifest.json")
                != source_hashes["manifest_sha256"]
                or actual_digest != candidate.get("governance_digest")
            ):
                raise TaskctlError("installed governance triple differs from review")
            _fault(self.fault, "after_actual_hash_verification")
            state["state"] = "GOVERNANCE_STAGED"
            state["activation"] = {
                "kernel_sha256": source_hashes["kernel_sha256"],
                "manifest_sha256": source_hashes["manifest_sha256"],
                "governance_digest": actual_digest,
            }
            self._cas_write_state(state, expected_state_hash, lock_held=True)
            _fault(self.fault, "after_activation_state_before_result")

        def verifier() -> bool | None:
            if (
                self.state_path.is_file()
                and self._state().get("state") == "GOVERNANCE_STAGED"
            ):
                return True if installed_triple_matches() else None

            def observed(path: Path) -> str | None:
                return sha256_file(path) if path.is_file() else None

            root_hash = observed(self.repo_root / "AGENTS.md")
            manifest_hash = observed(self.repo_root / "docs/agents/manifest.json")
            root_safe = root_hash in {
                source_hashes["pre_root_sha256"],
                source_hashes["kernel_sha256"],
            }
            manifest_safe = manifest_hash in {
                source_hashes["pre_manifest_sha256"],
                source_hashes["manifest_sha256"],
            }
            return False if root_safe and manifest_safe else None

        return self._transition(
            "activate",
            [
                "activate",
                "--kernel",
                str(kernel.resolve()),
                "--kernel-sha256",
                source_hashes["kernel_sha256"],
                "--manifest",
                str(manifest.resolve()),
                "--manifest-sha256",
                source_hashes["manifest_sha256"],
                "--candidate-fingerprint",
                str(candidate["fingerprint"]),
                "--review-generation",
                str(generation),
            ],
            effect,
            verifier,
            lock_held=True,
        )

    def _gate_argv(self, step: str) -> list[str]:
        if step == "independent_review":
            return ["taskctl", self.task_id, "validate-review"]
        if step == "task_gate":
            return ["./scripts/task_validate.sh", self.task_id]
        if step == "atomic_evidence":
            argv = [
                "python3",
                "scripts/atomic_evidence_validate.py",
                self.task_id,
            ]
            required = ["lint", "test", "scope"]
            required.extend(("independent_review", "task_gate"))
            for required_step in required:
                argv.extend(("--required-step", required_step))
            return argv
        raise TaskctlError(f"unknown close gate: {step}")

    def _gate_event_argv(
        self, step: str, candidate: dict[str, Any], generation: int
    ) -> list[str]:
        return [
            *self._gate_argv(step),
            "--taskctl-candidate-fingerprint",
            str(candidate["fingerprint"]),
            "--taskctl-patch-sha256",
            str(candidate["patch_sha256"]),
            "--taskctl-governance-digest",
            str(candidate["governance_digest"]),
            "--taskctl-review-generation",
            str(generation),
        ]

    def _scope_refresh_event_argv(
        self, candidate: dict[str, Any], generation: int
    ) -> list[str]:
        return [
            "python3",
            "scripts/evidence_scope.py",
            "finalize",
            self.task_id,
            "--live-patch-sha256",
            str(candidate["patch_sha256"]),
            "--candidate-fingerprint",
            str(candidate["fingerprint"]),
            "--review-generation",
            str(generation),
        ]

    def _load_scope_producer(self):
        import importlib.util

        scope_path = self.repo_root / "scripts/evidence_scope.py"
        spec = importlib.util.spec_from_file_location(
            f"fpms_close_scope_{self.task_id}", scope_path
        )
        if spec is None or spec.loader is None:
            raise TaskctlError("cannot load scope producer")
        scope = importlib.util.module_from_spec(spec)
        previous = sys.dont_write_bytecode
        sys.dont_write_bytecode = True
        try:
            spec.loader.exec_module(scope)
        finally:
            sys.dont_write_bytecode = previous
        return scope

    def _live_scope_patch(self) -> bytes:
        scope = self._load_scope_producer()
        try:
            return scope.build_patch(self.task_id, root=self.repo_root)
        except Exception as exc:
            raise TaskctlError(f"cannot build live scoped patch: {exc}") from exc

    def _invalidate_candidate(
        self, state: dict[str, Any], reason: str, *, lock_held: bool = False
    ) -> None:
        expected_state_hash = sha256_file(self.state_path)
        if self.task_id == GVR3_ID and isinstance(state.get("activation"), dict):
            state["state"] = "BLOCKED"
            state["reason"] = reason
        else:
            state["state"] = "IMPLEMENTING"
            state.pop("candidate", None)
            state["review_leases"] = {}
            state["reviews"] = {}
            state["reason"] = reason
        self._cas_write_state(state, expected_state_hash, lock_held=lock_held)

    def _refresh_scope(
        self,
        state: dict[str, Any],
        candidate: dict[str, Any],
        *,
        lock_held: bool = False,
    ) -> None:
        live_patch = self._live_scope_patch()
        expected_patch = candidate.get("patch_sha256")
        if sha256_bytes(live_patch) != expected_patch:
            incomplete = self.events.first_incomplete()
            if incomplete is not None:
                command = self.events._load_event(incomplete, "command")
                if command.get("step") == "taskctl_scope_refresh":
                    self.events.supersede_incomplete_internal(
                        incomplete, reason="scope_changed_before_refresh_replay"
                    )
            self._invalidate_candidate(
                state, "CANDIDATE_SCOPE_CHANGED", lock_held=lock_held
            )
            raise TaskctlError("live scoped patch differs from reviewed candidate")
        argv = ["python3", "scripts/evidence_scope.py", "finalize", self.task_id]
        log_path = self._log_path("close_scope_refresh")

        def runner() -> dict[str, object]:
            with log_path.open("wb") as output:
                process = subprocess.run(
                    argv,
                    cwd=self.repo_root,
                    stdout=output,
                    stderr=subprocess.STDOUT,
                    check=False,
                )
            return {
                "rc": process.returncode,
                "executed": True,
                "log": str(log_path.relative_to(self.repo_root)),
                "log_sha256": sha256_file(log_path),
            }

        def verifier() -> bool | None:
            try:
                generated = self._live_scope_patch()
                stored = (self.artifact / "git/diff.patch").read_bytes()
            except (OSError, TaskctlError):
                return None
            if sha256_bytes(generated) == expected_patch and stored == generated:
                return True
            if sha256_bytes(generated) == expected_patch:
                return False
            return None

        result = self.events.run(
            step="taskctl_scope_refresh",
            argv=self._scope_refresh_event_argv(
                candidate, int(state.get("review_generation"))
            ),
            cwd=self.repo_root,
            classification="INTERNAL",
            runner=runner,
            replay_safe=True,
            effect_verifier=verifier,
            retry_failed=True,
            lock_held=lock_held,
            reuse_completed=True,
        )
        if result.get("rc") != 0:
            failed_state = self._state()
            expected_state_hash = sha256_file(self.state_path)
            failed_state["state"] = "FAIL"
            failed_state["failed_ordinal"] = result.get("ordinal")
            failed_state["resume_from"] = "taskctl_scope_refresh"
            self._cas_write_state(
                failed_state, expected_state_hash, lock_held=lock_held
            )
            raise TaskctlError("canonical scope refresh failed")
        if (self.artifact / "git/diff.patch").read_bytes() != live_patch:
            raise TaskctlError("scope refresh did not install the reviewed patch")

    def _default_gate_runner(self, step: str, argv: list[str]) -> dict[str, object]:
        if step == "independent_review":
            state = self._state()
            self._validate_submitted_reviews(state)
            log_path = self._log_path(step)
            atomic_write(log_path, b"independent review binding PASS\n")
            return {
                "rc": 0,
                "executed": True,
                "log": str(log_path.relative_to(self.repo_root)),
            }
        log_path = self._log_path(step)
        with log_path.open("wb") as output:
            process = subprocess.run(
                argv,
                cwd=self.repo_root,
                stdout=output,
                stderr=subprocess.STDOUT,
                check=False,
            )
        return {
            "rc": process.returncode,
            "executed": True,
            "log": str(log_path.relative_to(self.repo_root)),
        }

    def _current_candidate(self, state: dict[str, Any]) -> dict[str, Any]:
        bootstrap = state.get("bootstrap")
        if self.task_id == GVR3_ID:
            if not isinstance(bootstrap, dict):
                raise TaskctlError("GVR-3 bootstrap binding is missing")
            kernel = Path(str(bootstrap.get("kernel_path", "")))
            manifest = Path(str(bootstrap.get("manifest_path", "")))
        else:
            kernel = None
            manifest = None
        return self._candidate_inputs(
            state,
            kernel=kernel,
            manifest=manifest,
            allow_activation_partial=True,
        )

    def close(
        self,
        *,
        gate_runner: Callable[[str, list[str]], dict[str, object]] | None = None,
    ) -> dict[str, Any]:
        with self.events.lease(
            owner=f"close:{self.actor}:{os.getpid()}",
            wait_timeout=2.0,
        ):
            return self._close_locked(gate_runner=gate_runner)

    def _validate_terminal_pass(
        self, state: dict[str, Any], contract: TaskContract
    ) -> None:
        candidate = state.get("candidate")
        if not isinstance(candidate, dict):
            raise TaskctlError("terminal PASS candidate is missing")
        if self.task_id == GVR3_ID:
            manifest, digest, selected, inputs = self._active_context(contract)
            if (
                digest != state.get("governance_digest")
                or selected != state.get("selected_modules")
                or inputs != state.get("governance_inputs")
                or manifest.get("rule_owners") != state.get("governance_rule_owners")
            ):
                raise TaskctlError("terminal activation PASS binding changed")
        self._validate_immutable_candidate(state, candidate, contract)
        self._validate_submitted_reviews(state)
        self._validate_terminal_receipts(state, candidate)

    def _validate_immutable_candidate(
        self,
        state: dict[str, Any],
        candidate: dict[str, Any],
        contract: TaskContract,
    ) -> None:
        activation = self.task_id == GVR3_ID
        material = dict(candidate)
        fingerprint = material.pop("fingerprint", None)
        task_path = self.repo_root / contract.task_path
        summary = self.artifact / "summary.md"
        patch = (
            self.artifact / "candidate/virtual.patch"
            if activation
            else self.artifact / "git/diff.patch"
        )
        if (
            not isinstance(fingerprint, str)
            or _canonical_digest(material) != fingerprint
            or sha256_file(task_path) != candidate.get("task_sha256")
            or sha256_file(summary) != candidate.get("summary_sha256")
            or sha256_file(patch) != candidate.get("patch_sha256")
            or candidate.get("scoped_patch_sha256") != candidate.get("patch_sha256")
            or candidate.get("governance_digest") != state.get("governance_digest")
            or candidate.get("baseline") != state.get("baseline")
            or candidate.get("required_results")
            != self._required_results(activation=activation)
        ):
            raise TaskctlError("terminal PASS immutable candidate binding changed")
        if activation and sha256_file(
            self.artifact / "git/diff.patch"
        ) != candidate.get("patch_sha256"):
            raise TaskctlError("terminal activation scoped patch binding changed")
        source_hashes = candidate.get("source_hashes")
        if not activation:
            if source_hashes != {}:
                raise TaskctlError("ordinary candidate has activation source hashes")
            return
        bootstrap = state.get("bootstrap")
        if not isinstance(source_hashes, dict) or not isinstance(bootstrap, dict):
            raise TaskctlError("activation candidate source binding is missing")
        kernel = Path(str(bootstrap.get("kernel_path", "")))
        manifest = Path(str(bootstrap.get("manifest_path", "")))
        if (
            sha256_file(kernel) != source_hashes.get("kernel_sha256")
            or sha256_file(manifest) != source_hashes.get("manifest_sha256")
            or source_hashes.get("kernel_sha256") != bootstrap.get("kernel_sha256")
            or source_hashes.get("manifest_sha256") != bootstrap.get("manifest_sha256")
        ):
            raise TaskctlError("activation candidate source binding changed")

    def _validate_terminal_receipts(
        self, state: dict[str, Any], candidate: dict[str, Any]
    ) -> None:
        generation = state.get("review_generation")
        if type(generation) is not int or generation <= 0:
            raise TaskctlError("terminal PASS review generation is invalid")
        bindings, ordinals = self._terminal_receipt_bindings(candidate, generation)
        if state.get("terminal_receipts") != bindings:
            raise TaskctlError("terminal PASS receipt byte binding changed")
        if ordinals != sorted(ordinals) or len(set(ordinals)) != len(ordinals):
            raise TaskctlError("terminal PASS close receipt order is invalid")
        if state.get("terminal_ordinal") != ordinals[-1]:
            raise TaskctlError("terminal PASS ordinal binding changed")
        if self.events.first_incomplete() is not None:
            raise TaskctlError("terminal PASS has an incomplete command")

    def _revalidate_before_pass(
        self,
        state: dict[str, Any],
        candidate: dict[str, Any],
        contract: TaskContract,
    ) -> None:
        bound_contract = self._assert_state_binding(state)
        if bound_contract != contract:
            raise TaskctlError("close task contract changed before PASS")
        self._ensure_governance_current(state, bound_contract, lock_held=True)
        if self._current_candidate(state) != candidate:
            raise TaskctlError("candidate inputs changed after close gates")
        live_patch = self._live_scope_patch()
        if (
            sha256_bytes(live_patch) != candidate.get("patch_sha256")
            or (self.artifact / "git/diff.patch").read_bytes() != live_patch
        ):
            raise TaskctlError("live scoped patch changed after close gates")
        self._validate_submitted_reviews(state)
        self._validate_immutable_candidate(state, candidate, bound_contract)
        if self.task_id != GVR3_ID:
            return
        activation = state.get("activation")
        source_hashes = candidate.get("source_hashes")
        if not isinstance(activation, dict) or not isinstance(source_hashes, dict):
            raise TaskctlError("activation binding is missing before PASS")
        active_root = self.repo_root / "AGENTS.md"
        active_manifest_path = self.repo_root / "docs/agents/manifest.json"
        try:
            active_manifest = load_json(
                active_manifest_path, "installed governance manifest"
            )
            active_digest, _active_inputs = governance_digest(
                self.repo_root, active_root, active_manifest
            )
        except TaskctlError as exc:
            raise TaskctlError(
                "installed governance changed after close gates"
            ) from exc
        if (
            sha256_file(active_root) != source_hashes.get("kernel_sha256")
            or sha256_file(active_manifest_path) != source_hashes.get("manifest_sha256")
            or active_digest != candidate.get("governance_digest")
            or activation.get("kernel_sha256") != source_hashes.get("kernel_sha256")
            or activation.get("manifest_sha256") != source_hashes.get("manifest_sha256")
            or activation.get("governance_digest") != candidate.get("governance_digest")
        ):
            raise TaskctlError("installed governance changed after close gates")

    def _terminal_receipt_bindings(
        self, candidate: dict[str, Any], generation: int
    ) -> tuple[dict[str, dict[str, Any]], list[int]]:
        specs = [
            (
                "taskctl_scope_refresh",
                self._scope_refresh_event_argv(candidate, generation),
                True,
            ),
            *[
                (step, self._gate_event_argv(step, candidate, generation), True)
                for step in ("independent_review", "task_gate", "atomic_evidence")
            ],
            (
                "taskctl_close",
                [
                    "close",
                    "--candidate-fingerprint",
                    str(candidate["fingerprint"]),
                    "--review-generation",
                    str(generation),
                ],
                False,
            ),
        ]
        bindings: dict[str, dict[str, Any]] = {}
        ordinals: list[int] = []
        for step, argv, require_log in specs:
            matches: list[tuple[int, Path, dict[str, Any]]] = []
            for ordinal in self.events._ordinals("command"):
                command = self.events._load_event(ordinal, "command")
                result_path = self.events._path(ordinal, "result")
                if (
                    command.get("step") == step
                    and command.get("argv") == argv
                    and result_path.is_file()
                ):
                    result = self.events._load_event(ordinal, "result")
                    if result.get("rc") == 0:
                        matches.append((ordinal, result_path, result))
            if not matches:
                raise TaskctlError(f"terminal PASS receipt is missing: {step}")
            ordinal, result_path, result = matches[-1]
            binding: dict[str, Any] = {
                "ordinal": ordinal,
                "result_sha256": sha256_file(result_path),
            }
            if require_log:
                log_relative = _safe_relative(
                    str(result.get("log", "")), f"terminal {step} log"
                )
                if not log_relative.startswith(f"artifacts/{self.task_id}/outputs/"):
                    raise TaskctlError(f"terminal PASS log is outside outputs: {step}")
                log_path, canonical_log = _repo_file_path(
                    self.repo_root / log_relative,
                    self.repo_root,
                    f"terminal {step} log",
                )
                log_sha256 = sha256_file(log_path)
                if (
                    canonical_log != log_relative
                    or result.get("log_sha256") != log_sha256
                ):
                    raise TaskctlError(f"terminal PASS log binding changed: {step}")
                binding.update({"log": log_relative, "log_sha256": log_sha256})
            bindings[step] = binding
            ordinals.append(ordinal)
        return bindings, ordinals

    def _close_locked(
        self,
        *,
        gate_runner: Callable[[str, list[str]], dict[str, object]] | None = None,
    ) -> dict[str, Any]:
        state = self._state()
        contract = self._assert_state_binding(state)
        if self.actor != state.get("controller"):
            raise TaskctlError("only the recorded controller may close the task")
        if state.get("state") == "PASS":
            self._validate_terminal_pass(state, contract)
            return state
        allowed = {"READY_FOR_REVIEW", "REVIEW_APPROVED", "CLOSING", "FAIL"}
        if self.task_id == GVR3_ID:
            allowed.add("GOVERNANCE_STAGED")
        if state.get("state") not in allowed:
            raise TaskctlError("close requires reviewed/staged state or retryable FAIL")
        self._ensure_governance_current(state, contract, lock_held=True)
        candidate = state.get("candidate")
        if not isinstance(candidate, dict):
            raise TaskctlError("close candidate is missing")
        generation = state.get("review_generation")
        if type(generation) is not int or generation <= 0:
            raise TaskctlError("close review generation is invalid")
        if self.task_id == GVR3_ID:
            activation = state.get("activation")
            if not isinstance(activation, dict):
                raise TaskctlError("GVR-3 is not durably staged")
            active_manifest = load_json(
                self.repo_root / "docs/agents/manifest.json", "installed manifest"
            )
            actual_digest, _inputs = governance_digest(
                self.repo_root, self.repo_root / "AGENTS.md", active_manifest
            )
            if actual_digest != candidate.get("governance_digest"):
                raise TaskctlError("installed governance digest changed before close")
        close_steps = (
            "taskctl_scope_refresh",
            "independent_review",
            "task_gate",
            "atomic_evidence",
            "taskctl_close",
        )
        incomplete = self.events.first_incomplete()
        incomplete_step: str | None = None
        if incomplete is not None:
            command = self.events._load_event(incomplete, "command")
            incomplete_step = str(command.get("step"))
            if (
                incomplete_step not in close_steps
                or command.get("replay_safe") is not True
                or candidate["fingerprint"] not in command.get("argv", [])
            ):
                raise TaskctlError(
                    f"close blocked by unrelated incomplete ordinal {incomplete}"
                )

        def completed_step(
            step: str, event_argv: list[str] | None = None
        ) -> dict[str, Any]:
            for ordinal in reversed(self.events._ordinals("command")):
                command = self.events._load_event(ordinal, "command")
                if command.get("step") != step:
                    continue
                if event_argv is not None and command.get("argv") != event_argv:
                    continue
                if candidate["fingerprint"] not in command.get("argv", []):
                    continue
                result_path = self.events._path(ordinal, "result")
                if not result_path.is_file():
                    continue
                result = self.events._load_event(ordinal, "result")
                if result.get("rc") == 0:
                    return result
            raise TaskctlError(f"missing completed close receipt before {step}")

        if incomplete_step is not None and incomplete_step != "taskctl_scope_refresh":
            live_patch = self._live_scope_patch()
            if (
                sha256_bytes(live_patch) != candidate.get("patch_sha256")
                or (self.artifact / "git/diff.patch").read_bytes() != live_patch
            ):
                if incomplete is not None:
                    self.events.supersede_incomplete_internal(
                        incomplete, reason="candidate_changed_before_close_replay"
                    )
                self._invalidate_candidate(
                    state, "CANDIDATE_SCOPE_CHANGED", lock_held=True
                )
                raise TaskctlError("live scoped patch differs from reviewed candidate")
            completed_step("taskctl_scope_refresh")
        else:
            self._refresh_scope(state, candidate, lock_held=True)
        state = self._state()
        try:
            current_candidate = self._current_candidate(state)
        except TaskctlError:
            current_incomplete = self.events.first_incomplete()
            if current_incomplete is not None:
                self.events.supersede_incomplete_internal(
                    current_incomplete,
                    reason="candidate_inputs_unavailable_before_close_replay",
                )
            self._invalidate_candidate(state, "CANDIDATE_INPUT_CHANGED", lock_held=True)
            raise
        if current_candidate != candidate:
            current_incomplete = self.events.first_incomplete()
            if current_incomplete is not None:
                self.events.supersede_incomplete_internal(
                    current_incomplete,
                    reason="candidate_inputs_changed_before_close_replay",
                )
            self._invalidate_candidate(state, "CANDIDATE_INPUT_CHANGED", lock_held=True)
            raise TaskctlError("pre-review candidate changed; reviews were invalidated")
        self._validate_submitted_reviews(state)
        runner = gate_runner or self._default_gate_runner

        def execute_gate(step: str) -> dict[str, Any]:
            argv = self._gate_argv(step)
            event_argv = self._gate_event_argv(step, candidate, generation)

            def run_gate() -> dict[str, object]:
                raw = runner(step, argv)
                if not isinstance(raw, dict):
                    raise TaskctlError("close gate runner result must be an object")
                result = dict(raw)
                log_value = result.get("log")
                if not isinstance(log_value, str) or not log_value:
                    log_path = self._log_path(f"{step}_result")
                    atomic_write(
                        log_path,
                        f"{step} rc={result.get('rc')}\n".encode("utf-8"),
                    )
                    log_value = str(log_path.relative_to(self.repo_root))
                    result["log"] = log_value
                log_relative = _safe_relative(log_value, f"{step} result log")
                if not log_relative.startswith(f"artifacts/{self.task_id}/outputs/"):
                    raise TaskctlError("close gate log is outside task outputs")
                log_path, canonical_log = _repo_file_path(
                    self.repo_root / log_relative,
                    self.repo_root,
                    f"{step} result log",
                )
                if canonical_log != log_relative:
                    raise TaskctlError("close gate log path is non-canonical")
                result["log_sha256"] = sha256_file(log_path)
                return result

            result = self.events.run(
                step=step,
                argv=event_argv,
                cwd=self.repo_root,
                classification="INTERNAL",
                runner=run_gate,
                replay_safe=True,
                effect_verifier=lambda: False,
                retry_failed=True,
                lock_held=True,
                reuse_completed=True,
            )
            if result.get("rc") != 0:
                failed_state = self._state()
                expected_state_hash = sha256_file(self.state_path)
                failed_state["state"] = "FAIL"
                failed_state["failed_ordinal"] = result.get("ordinal")
                failed_state["resume_from"] = step
                self._cas_write_state(failed_state, expected_state_hash, lock_held=True)
                raise TaskctlError(f"close gate failed: {step}")
            return result

        def execute_or_load_gate(step: str) -> dict[str, Any]:
            event_argv = self._gate_event_argv(step, candidate, generation)
            current_incomplete = self.events.first_incomplete()
            if current_incomplete is not None:
                current_step = self.events._load_event(
                    current_incomplete, "command"
                ).get("step")
                if current_step != step:
                    if close_steps.index(step) < close_steps.index(str(current_step)):
                        return completed_step(step, event_argv)
                    raise TaskctlError(
                        f"close chain expected {current_step} before {step}"
                    )
            return execute_gate(step)

        state = self._state()
        if state.get("state") != "CLOSING":
            expected_state_hash = sha256_file(self.state_path)
            state["state"] = "REVIEW_APPROVED"
            state["review_candidate_fingerprint"] = candidate["fingerprint"]
            self._cas_write_state(state, expected_state_hash, lock_held=True)
        review_result = execute_or_load_gate("independent_review")
        state = self._state()
        if state.get("state") != "CLOSING":
            expected_state_hash = sha256_file(self.state_path)
            state["review_approved_ordinal"] = review_result["ordinal"]
            self._cas_write_state(state, expected_state_hash, lock_held=True)
            state = self._state()
            expected_state_hash = sha256_file(self.state_path)
            state["state"] = "CLOSING"
            self._cas_write_state(state, expected_state_hash, lock_held=True)
        execute_or_load_gate("task_gate")
        execute_or_load_gate("atomic_evidence")
        close_argv = [
            "close",
            "--candidate-fingerprint",
            str(candidate["fingerprint"]),
            "--review-generation",
            str(generation),
        ]
        current_incomplete = self.events.first_incomplete()
        if (
            current_incomplete is not None
            and self.events._load_event(current_incomplete, "command").get("step")
            != "taskctl_close"
        ):
            raise TaskctlError("close chain has an unexpected incomplete step")
        close_result = self.events.run(
            step="taskctl_close",
            argv=close_argv,
            cwd=self.repo_root,
            classification="INTERNAL",
            runner=lambda: {"rc": 0, "executed": True},
            replay_safe=True,
            effect_verifier=lambda: False,
            lock_held=True,
            reuse_completed=True,
        )
        remaining_incomplete = self.events.first_incomplete()
        if remaining_incomplete is not None:
            raise TaskctlError(
                f"close cannot PASS with incomplete ordinal {remaining_incomplete}"
            )
        terminal_receipts, terminal_ordinals = self._terminal_receipt_bindings(
            candidate, generation
        )
        if terminal_ordinals[-1] != close_result.get("ordinal"):
            raise TaskctlError("close terminal receipt does not match current close")
        state = self._state()
        self._revalidate_before_pass(state, candidate, contract)
        expected_state_hash = sha256_file(self.state_path)
        _fault(self.fault, "before_pass_receipt")
        state["state"] = "PASS"
        state["terminal_ordinal"] = close_result["ordinal"]
        state["terminal_receipts"] = terminal_receipts
        state.pop("resume_from", None)
        state.pop("failed_ordinal", None)
        self._cas_write_state(state, expected_state_hash, lock_held=True)
        _fault(self.fault, "after_pass_receipt")
        return state

    def doctor(self) -> dict[str, Any]:
        state = self._state() if self.state_path.is_file() else {}
        incomplete = self.events.first_incomplete()
        process_alive = False
        if incomplete is not None:
            command = self.events._load_event(incomplete, "command")
            process_marker = self.artifact / "process" / f"{incomplete:08d}.json"
            try:
                marker_info = process_marker.lstat()
            except FileNotFoundError:
                marker = None
            else:
                if not stat.S_ISREG(marker_info.st_mode):
                    raise TaskctlError("process marker must be a regular file")
                marker = load_json(process_marker, "process marker")
                if (
                    set(marker) != {"ordinal", "pid", "request_digest"}
                    or marker.get("ordinal") != incomplete
                    or type(marker.get("pid")) is not int
                    or marker["pid"] <= 0
                    or marker.get("request_digest") != command.get("request_digest")
                ):
                    raise TaskctlError("process marker binding is invalid")
            if marker is not None:
                try:
                    os.kill(marker["pid"], 0)
                except (OSError, ProcessLookupError):
                    process_alive = False
                else:
                    process_alive = True
            live_state = (
                "RUNNING_COMMAND"
                if process_alive
                else (
                    "RECOVERABLE_INTERNAL"
                    if command.get("replay_safe") is True
                    else "OUTCOME_UNKNOWN"
                )
            )
        elif not state:
            live_state = "PARTIAL_START"
        elif state.get("state") == "PASS":
            live_state = "PASS"
        elif state.get("state") == "FAIL":
            live_state = "KNOWN_FAILURE"
        elif state.get("state") == "BLOCKED":
            live_state = str(state.get("reason", "BLOCKED"))
        else:
            live_state = str(state.get("state", "UNKNOWN"))
        allowlist = state.get("allowlist")
        if not isinstance(allowlist, list) and (self.artifact / "task.json").is_file():
            metadata = load_json(self.artifact / "task.json", "task metadata")
            allowlist = metadata.get("allowlist")
        diff_paths: list[str] = []
        if isinstance(allowlist, list) and all(
            isinstance(path, str) for path in allowlist
        ):
            git_env = os.environ.copy()
            git_env["GIT_OPTIONAL_LOCKS"] = "0"
            status = subprocess.run(
                [
                    "git",
                    "status",
                    "--porcelain=v1",
                    "-z",
                    "--untracked-files=all",
                    "--",
                    *allowlist,
                ],
                cwd=self.repo_root,
                env=git_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            if status.returncode == 0:
                for record in status.stdout.split(b"\x00"):
                    if len(record) >= 4:
                        diff_paths.append(
                            record[3:].decode("utf-8", errors="surrogateescape")
                        )
        files = [path for path in self.artifact.rglob("*") if path.is_file()]
        failed_ordinal = state.get("failed_ordinal")
        if not isinstance(failed_ordinal, int):
            failed_ordinal = None
        first_unfinished_step: str | None = None
        first_unfinished_reason: str | None = None
        if incomplete is not None:
            first_unfinished_step = str(
                self.events._load_event(incomplete, "command").get("step")
            )
            first_unfinished_reason = live_state
        elif failed_ordinal is not None:
            first_unfinished_step = str(
                state.get("resume_from") or f"ordinal:{failed_ordinal}"
            )
            first_unfinished_reason = "KNOWN_FAILURE"
        elif not state:
            first_unfinished_step = "start"
            first_unfinished_reason = "MISSING_STATE"
        elif state.get("state") == "IMPLEMENTING":
            if not (self.artifact / "summary.md").is_file():
                first_unfinished_step = "summary"
                first_unfinished_reason = "MISSING"
            else:
                required = (
                    tuple(GVR3_REQUIRED_COMMANDS)
                    if self.task_id == GVR3_ID
                    else ("lint", "test", "scope")
                )
                for step in required:
                    try:
                        result, _result_path = self.events.latest_result(step)
                    except TaskctlError:
                        first_unfinished_step = step
                        first_unfinished_reason = "MISSING_RESULT"
                        break
                    if result.get("rc") != 0:
                        first_unfinished_step = step
                        first_unfinished_reason = "LATEST_RESULT_NONZERO"
                        break
                    if self.task_id == GVR3_ID:
                        command = self.events._load_event(result["ordinal"], "command")
                        expected_argv, expected_classification = GVR3_REQUIRED_COMMANDS[
                            step
                        ]
                        if (
                            command.get("argv") != list(expected_argv)
                            or command.get("cwd") != str(self.repo_root)
                            or command.get("classification") != expected_classification
                            or command.get("replay_safe") is not False
                            or result.get("executed") is not True
                        ):
                            first_unfinished_step = step
                            first_unfinished_reason = "INVALID_COMMAND_BINDING"
                            break
                    try:
                        log_relative = _safe_relative(
                            str(result.get("log", "")), f"doctor {step} log"
                        )
                        if not log_relative.startswith(
                            f"artifacts/{self.task_id}/outputs/"
                        ):
                            raise TaskctlError("result log is outside task outputs")
                        _repo_file_path(
                            self.repo_root / log_relative,
                            self.repo_root,
                            f"doctor {step} log",
                        )
                    except TaskctlError:
                        first_unfinished_step = f"{step}_log"
                        first_unfinished_reason = "MISSING_OR_INVALID"
                        break
                if first_unfinished_step is None:
                    try:
                        _repo_file_path(
                            self.artifact / "git/diff.patch",
                            self.repo_root,
                            "doctor scope patch",
                        )
                    except TaskctlError:
                        first_unfinished_step = "scope_patch"
                        first_unfinished_reason = "MISSING_OR_INVALID"
                if first_unfinished_step is None:
                    first_unfinished_step = "prepare_review"
                    first_unfinished_reason = "READY"
        elif state.get("state") == "READY_FOR_REVIEW":
            leases = state.get("review_leases", {})
            reviews = state.get("reviews", {})
            for axis in self._allowed_axes():
                if not isinstance(leases, dict) or not isinstance(
                    leases.get(axis), dict
                ):
                    first_unfinished_step = f"review_lease:{axis}"
                    first_unfinished_reason = "MISSING"
                    break
                if not isinstance(reviews, dict) or not isinstance(
                    reviews.get(axis), dict
                ):
                    first_unfinished_step = f"review_submit:{axis}"
                    first_unfinished_reason = "MISSING"
                    break
            if first_unfinished_step is None:
                first_unfinished_step = (
                    "activate" if self.task_id == GVR3_ID else "close"
                )
                first_unfinished_reason = "READY"
        elif state.get("state") in {
            "GOVERNANCE_STAGED",
            "REVIEW_APPROVED",
            "CLOSING",
        }:
            first_unfinished_step = str(state.get("resume_from") or "close")
            first_unfinished_reason = "READY"
        elif state.get("state") == "BLOCKED":
            blocked_reason = str(state.get("reason") or "BLOCKED")
            if blocked_reason == "GOVERNANCE_DIGEST_MISMATCH":
                first_unfinished_step = "governance_adopt"
                first_unfinished_reason = "APPROVAL_REQUIRED"
            elif blocked_reason == "OUTCOME_UNKNOWN":
                first_unfinished_step = "manual_reconcile"
                first_unfinished_reason = "HUMAN_DECISION_REQUIRED"
            else:
                first_unfinished_step = "resolve_blocker"
                first_unfinished_reason = blocked_reason
        return {
            "task_id": self.task_id,
            "live_state": live_state,
            "state": state.get("state") if state else None,
            "first_incomplete_ordinal": incomplete,
            "first_problem_ordinal": (
                incomplete if incomplete is not None else failed_ordinal
            ),
            "failed_ordinal": failed_ordinal,
            "resume_from": state.get("resume_from"),
            "first_unfinished_step": first_unfinished_step,
            "first_unfinished_reason": first_unfinished_reason,
            "incomplete_process_alive": process_alive,
            "controller": state.get("controller"),
            "implementer": state.get("implementer"),
            "artifact": str(self.artifact),
            "artifact_file_count": len(files),
            "diff_paths": sorted(set(diff_paths)),
            "lock_sidecar_present": self.events.lock_path.with_suffix(
                ".owner.json"
            ).is_file(),
            "lock_authority": "FD_FLOCK",
        }


def repository_root() -> Path:
    process = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if process.returncode != 0:
        raise TaskctlError("current directory is not inside a Git repository")
    return Path(process.stdout.decode("utf-8").strip()).resolve()


def _strip_separator(values: Sequence[str]) -> list[str]:
    result = list(values)
    if result and result[0] == "--":
        result.pop(0)
    if not result:
        raise TaskctlError("command arguments are required after --")
    return result


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("task_id")
    commands = parser.add_subparsers(dest="action", required=True)

    start = commands.add_parser("start")
    start.add_argument("--task-file", type=Path, required=True)
    start.add_argument("--bootstrap-kernel", type=Path)
    start.add_argument("--bootstrap-manifest", type=Path)

    record = commands.add_parser("record")
    record.add_argument("step")
    record.add_argument("argv", nargs=argparse.REMAINDER)

    backend = commands.add_parser("backend-test")
    backend.add_argument("mode", choices=("red", "test"))
    backend.add_argument("pytest_args", nargs=argparse.REMAINDER)

    prepare = commands.add_parser("prepare-review")
    prepare.add_argument("--kernel", type=Path)
    prepare.add_argument("--manifest", type=Path)

    review = commands.add_parser("review")
    review_commands = review.add_subparsers(dest="review_action", required=True)
    lease = review_commands.add_parser("lease")
    lease.add_argument("axis", choices=("independent", "governance", "tooling"))
    lease.add_argument("--reviewer", required=True)
    submit = review_commands.add_parser("submit")
    submit.add_argument("axis", choices=("independent", "governance", "tooling"))
    submit.add_argument("--report", type=Path, required=True)

    adopt = commands.add_parser("governance-adopt")
    adopt.add_argument("--approval", type=Path, required=True)

    activate = commands.add_parser("activate")
    activate.add_argument("--kernel", type=Path, required=True)
    activate.add_argument("--manifest", type=Path, required=True)

    commands.add_parser("close")
    commands.add_parser("doctor")
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    caller_cwd = Path.cwd().resolve()
    try:
        root = repository_root()
        actor = os.environ.get("TASKCTL_ACTOR", "lead")
        implementer = os.environ.get("TASKCTL_IMPLEMENTER", actor)
        controller = TaskController(
            root,
            args.task_id,
            actor=actor,
            implementer=implementer,
        )
        result: dict[str, Any]
        if args.action == "start":
            result = controller.start(
                root / args.task_file,
                bootstrap_kernel=(
                    root / args.bootstrap_kernel if args.bootstrap_kernel else None
                ),
                bootstrap_manifest=(
                    root / args.bootstrap_manifest if args.bootstrap_manifest else None
                ),
            )
        elif args.action == "record":
            result = controller.record(
                args.step, _strip_separator(args.argv), caller_cwd
            )
            print(json.dumps(result, ensure_ascii=False, sort_keys=True))
            return int(result["rc"])
        elif args.action == "backend-test":
            result = controller.backend_test(
                args.mode, _strip_separator(args.pytest_args)
            )
            print(json.dumps(result, ensure_ascii=False, sort_keys=True))
            if args.mode == "red":
                return (
                    0
                    if result.get("executed") is True
                    and result.get("expectation_met") is True
                    and result.get("reason") is None
                    else 1
                )
            return int(result["rc"])
        elif args.action == "prepare-review":
            result = controller.prepare_review(
                kernel=(root / args.kernel if args.kernel else None),
                manifest=(root / args.manifest if args.manifest else None),
            )
        elif args.action == "review" and args.review_action == "lease":
            result = controller.review_lease(args.axis, args.reviewer)
        elif args.action == "review" and args.review_action == "submit":
            result = controller.review_submit(args.axis, root / args.report)
        elif args.action == "governance-adopt":
            result = controller.governance_adopt(root / args.approval)
        elif args.action == "activate":
            result = controller.activate(root / args.kernel, root / args.manifest)
        elif args.action == "close":
            result = controller.close()
        elif args.action == "doctor":
            result = controller.doctor()
        else:  # pragma: no cover - argparse prevents this
            raise TaskctlError("unsupported action")
        print(json.dumps(result, ensure_ascii=False, sort_keys=True))
        return 0
    except (TaskctlError, OSError, UnicodeError, ValueError) as exc:
        print(f"taskctl failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
